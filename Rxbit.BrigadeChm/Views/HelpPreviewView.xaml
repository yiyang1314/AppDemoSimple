<Window x:Class="Rxbit.BrigadeChm.Views.HelpPreviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Rxbit.BrigadeChm.ViewModels"
        mc:Ignorable="d"
        Title="帮助文档预览"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#12141A"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="#E6EAF2">
    <Window.Resources>
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22262F" />
            <Setter Property="Foreground" Value="#4FD1DE" />
            <Setter Property="BorderBrush" Value="#3D4454" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4FD1DE" />
                                <Setter Property="Foreground" Value="#0E1116" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6EAF2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6EAF2" />
            <Setter Property="Padding" Value="4,4,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3D4A" />
                    <Setter Property="Foreground" Value="#4FD1DE" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2F3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4FD1DE" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,8,4,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="#1A1D25"
                BorderBrush="#2E3440"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding HomeCommand}"
                        Content="⌂ 首页" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding BackCommand}"
                        Content="‹ 返回" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding ForwardCommand}"
                        Content="› 前进" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="↻ 刷新" />

                <Separator Margin="8,0" />

                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding CompileChmCommand}"
                        Content="⚙ 编译 CHM"
                        IsEnabled="{Binding IsNotCompiling}" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding PreviewChmCommand}"
                        Content="◫ 预览 CHM" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding OpenOutputFolderCommand}"
                        Content="▣ 打开输出" />

                <Separator Margin="8,0" />

                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding ImportHtmlFileCommand}"
                        Content="⤓ 导入 HTML" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding ImportFolderCommand}"
                        Content="▤ 导入文件夹" />

                <Separator Margin="8,0" />

                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding CompileSingleHtmlCommand}"
                        IsEnabled="{Binding IsNotCompiling}"
                        Content="⇢ HTML→CHM" />
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Command="{Binding CompileFolderCommand}"
                        IsEnabled="{Binding IsNotCompiling}"
                        Content="⇢ 文件夹→CHM" />

                <TextBlock Text="{Binding CurrentTopicTitle}"
                           Foreground="#4FD1DE"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：目录 + 搜索 -->
            <Border Grid.Column="0"
                    Background="#22262F"
                    BorderBrush="#2a3a4d"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <Border Grid.Row="0"
                            Background="#0f172a"
                            Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Padding="8,4"
                                     Background="#1e2a3d"
                                     Foreground="#d0d0d0"
                                     BorderBrush="#2a3a4d"
                                     BorderThickness="1"
                                     CaretBrush="#4FD1DE"
                                     FontSize="12">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#4FD1DE" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- 目录树 -->
                    <TreeView Grid.Row="1"
                              x:Name="HelpTreeView"
                              Style="{StaticResource TreeViewStyle}"
                              ItemsSource="{Binding Sections}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              MouseDoubleClick="HelpTreeView_MouseDoubleClick"
                              Margin="4,4,0,4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Topics}">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#b0b0b0"
                                                   FontSize="12"
                                                   Padding="6,3"
                                                   Cursor="Hand" />
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- 搜索结果 -->
                    <Border Grid.Row="2"
                            x:Name="SearchResultsBorder"
                            Background="#0f172a"
                            Padding="8"
                            MaxHeight="150"
                            Visibility="Collapsed">
                        <Expander Header="搜索结果"
                                  Foreground="#4FD1DE"
                                  FontSize="12"
                                  IsExpanded="True">
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#b0b0b0"
                                                   FontSize="12"
                                                   Padding="4,2"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   MouseLeftButtonDown="SearchResult_Click" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#2a3a4d"
                          Width="8" />

            <!-- 右侧：WebBrowser 预览 -->
            <Border Grid.Column="2"
                    Background="#1a1b1d">
                <WebBrowser x:Name="WebBrowser"
                            Margin="0"
                            Loaded="WebBrowser_Loaded"
                            Navigating="WebBrowser_Navigating" />
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="#22262F"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OutputDirectory}"
                           Foreground="#555555"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
