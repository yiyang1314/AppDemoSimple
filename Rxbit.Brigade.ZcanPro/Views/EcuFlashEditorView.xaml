<UserControl x:Class="Rxbit.Brigade.ZcanPro.Views.EcuFlashEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F0F2F5"
             d:DesignHeight="580" d:DesignWidth="1120">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EcuCanTypeBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="EcuHeaderBg" Color="#E8EAED" />
        <SolidColorBrush x:Key="EcuPanelBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="EcuTreeHighlight" Color="#C6DCF3" />
        <SolidColorBrush x:Key="EcuListHighlight" Color="#CCE0F5" />
        <SolidColorBrush x:Key="EcuListHeaderBg" Color="#F0F0F0" />
        <SolidColorBrush x:Key="EcuListBorder" Color="#CCCCCC" />
        <SolidColorBrush x:Key="EcuBorder" Color="#C0C4CC" />

        <Style x:Key="EcuBtn" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{StaticResource EcuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EcuCanTypeBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C6E0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EcuPrimaryBtn" TargetType="Button" BasedOn="{StaticResource EcuBtn}">
            <Setter Property="Background" Value="{StaticResource EcuCanTypeBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource EcuCanTypeBrush}" />
        </Style>

        <Style x:Key="EcuSmallBtn" TargetType="Button" BasedOn="{StaticResource EcuBtn}">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderBrush" Value="{StaticResource EcuBorder}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderBrush" Value="{StaticResource EcuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部操作条 -->
            <RowDefinition Height="Auto" />
            <!-- CAN 类型/地址条 -->
            <RowDefinition Height="Auto" />
            <!-- 三栏主体 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第一行：文件操作按钮 -->
        <Border Grid.Row="0" Background="{StaticResource EcuPanelBg}"
                BorderBrush="{StaticResource EcuBorder}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新建" Style="{StaticResource EcuBtn}" Margin="2,0" />
                    <Button Content="打开" Style="{StaticResource EcuBtn}" Margin="2,0" />
                    <Button Content="保存" Style="{StaticResource EcuBtn}" Margin="2,0" />
                    <Button Content="导出" Style="{StaticResource EcuBtn}" Margin="2,0" />
                    <Button Content="加密导出" Style="{StaticResource EcuBtn}" Margin="2,0" />
                    <Button Content="应用到执行器" Style="{StaticResource EcuPrimaryBtn}" Margin="6,0" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CAN 类型：" VerticalAlignment="Center" FontSize="12" Foreground="#333" />
                    <ComboBox Width="90" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="CANFD" />
                        <ComboBoxItem Content="CAN 2.0" />
                    </ComboBox>
                    <TextBlock Text="▼" Foreground="#888" FontSize="9" Margin="-16,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="地址：" VerticalAlignment="Center" FontSize="12" Foreground="#333" />
                    <TextBox Text="791" Width="50" VerticalAlignment="Center" />
                    <TextBox Text="7df" Width="50" VerticalAlignment="Center" Margin="3,0" />
                    <TextBox Text="799" Width="50" VerticalAlignment="Center" />
                    <Button Content="更多设置" Style="{StaticResource EcuBtn}" Margin="6,0,2,0" />
                    <Button Content="服务编辑器" Style="{StaticResource EcuBtn}" Margin="2,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 第二行：操作列表控制（上移/下移/删除/清空/添加延时） -->
        <Border Grid.Row="1" Background="{StaticResource EcuHeaderBg}"
                BorderBrush="{StaticResource EcuBorder}" BorderThickness="0,0,0,1" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" />
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="上移" Style="{StaticResource EcuSmallBtn}" Margin="2,0" />
                    <Button Content="下移" Style="{StaticResource EcuSmallBtn}" Margin="2,0" />
                    <Button Content="删除" Style="{StaticResource EcuSmallBtn}" Margin="2,0" />
                    <Button Content="清空" Style="{StaticResource EcuSmallBtn}" Margin="2,0" />
                    <Button Content="添加延时" Style="{StaticResource EcuSmallBtn}" Margin="2,0" />
                    <TextBox Text="1000" Width="50" VerticalAlignment="Center" Margin="3,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 第三行：三栏主体 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：服务树 -->
            <Border Grid.Column="0" Background="{StaticResource EcuPanelBg}"
                    BorderBrush="{StaticResource EcuBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource EcuHeaderBg}" BorderBrush="{StaticResource EcuBorder}" BorderThickness="0,0,0,1" Padding="6,0">
                        <TextBlock Text="诊断服务列表" FontSize="11" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center" />
                    </Border>
                    <TreeView Grid.Row="1" x:Name="ServiceTree" Background="Transparent" BorderThickness="0"
                              FontSize="12" Foreground="#222" Padding="2,2">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Padding" Value="0,1" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeViewItem Header="(10)诊断会话控制" />
                        <TreeViewItem Header="(11)ECU重置" />
                        <TreeViewItem Header="(14)清除诊断信息" />
                        <TreeViewItem Header="(19)读取DTC信息" />
                        <TreeViewItem Header="(22)按标识符读取数据" />
                        <TreeViewItem Header="(23)按地址读取内容" />
                        <TreeViewItem Header="(24)按标识符读取映像数据" />
                        <TreeViewItem IsSelected="True">
                            <TreeViewItem.Header>
                                <Border Background="{StaticResource EcuTreeHighlight}" Padding="2,0">
                                    <TextBlock Text="(27)安全访问" Background="Transparent" FontSize="12" />
                                </Border>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Header="(28)通讯控制" />
                        <TreeViewItem Header="(2A)按周期性标识符读取数据" />
                        <TreeViewItem Header="(2C)动态定义数据标识符" />
                        <TreeViewItem Header="(2E)按标识符写数据" />
                        <TreeViewItem Header="(2F)按标识符的输入输出控制" />
                        <TreeViewItem Header="(31)例程控制" />
                        <TreeViewItem Header="(34)文件下载" />
                        <TreeViewItem Header="(3D)按地址写内存" />
                        <TreeViewItem Header="(83)访问计时参数" />
                        <TreeViewItem Header="(84)受保护的数据传输" />
                        <TreeViewItem Header="(85)控制DTC设置" />
                        <TreeViewItem Header="(86)基于事件响应" />
                        <TreeViewItem Header="(87)链路控制" />
                    </TreeView>
                </Grid>
            </Border>

            <!-- 中间栏分隔符 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext" />

            <!-- 中栏：编辑表单 -->
            <Border Grid.Column="2" Background="{StaticResource EcuPanelBg}"
                    BorderBrush="{StaticResource EcuBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditFormHost" Margin="10,8" />
                </ScrollViewer>
            </Border>

            <!-- 右栏分隔符 -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext" />

            <!-- 右栏：操作列表 -->
            <Border Grid.Column="4" Background="{StaticResource EcuPanelBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Border Grid.Row="0" Background="{StaticResource EcuListHeaderBg}"
                          BorderBrush="{StaticResource EcuListBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource EcuListBorder}" BorderThickness="0,0,1,0">
                            <TextBlock Text="#" FontSize="11" FontWeight="Bold" Foreground="#444"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{StaticResource EcuListBorder}" BorderThickness="0,0,1,0" Padding="4,0">
                            <TextBlock Text="描述" FontSize="11" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" Padding="4,0">
                            <TextBlock Text="数据" FontSize="11" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center" />
                        </Border>
                        </Grid>
                    </Border>
                    <!-- 操作列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OperationList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
