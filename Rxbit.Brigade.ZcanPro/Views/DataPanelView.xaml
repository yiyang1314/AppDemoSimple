<UserControl x:Class="Rxbit.Brigade.ZcanPro.Views.DataPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.ZcanPro.ViewModels"
             xmlns:conv="clr-namespace:Rxbit.Brigade.ZcanPro.Converters"
             Background="#F5F5F5">
    <UserControl.Resources>
        <conv:LoadToPercentConverter x:Key="LoadToPercent" />
        <SolidColorBrush x:Key="PanelBgBrush" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PanelHeaderBrush" Color="#2B5797" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DDDDDD" />
        <SolidColorBrush x:Key="PanelAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="PanelGreenBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="PanelRedBrush" Color="#C62828" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Height="26" Padding="12,0" Background="{StaticResource PanelGreenBrush}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Height="26" Padding="12,0" Background="#666" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand" Margin="6,0,0,0" />
                    <Button Content="导出" Command="{Binding ExportCommand}"
                            Height="26" Padding="12,0" Background="{StaticResource PanelAccentBrush}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand" Margin="6,0,0,0" />
                    <Button Content="清空" Command="{Binding ClearCommand}"
                            Height="26" Padding="12,0" Background="{StaticResource PanelRedBrush}" Foreground="White" BorderThickness="0" FontSize="12" Cursor="Hand" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 通道状态区 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 通道卡片 -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="4" MinWidth="180">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#333" />
                                        <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CCC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="正常">
                                                            <Setter Property="Fill" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="断开">
                                                            <Setter Property="Fill" Value="#F44336" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Text="{Binding BaudRate}" FontSize="10" Foreground="#666" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="消息: " FontSize="10" Foreground="#888" />
                                        <TextBlock Text="{Binding Messages, StringFormat='{}{0:N0}'}" FontSize="10" Foreground="#333" FontWeight="SemiBold" />
                                        <TextBlock Text=" 错误: " FontSize="10" Foreground="#888" />
                                        <TextBlock Text="{Binding Errors}" FontSize="10" Foreground="#333" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding Load, Converter={StaticResource LoadToPercent}}" Maximum="100"
                                                 Height="4" Margin="0,4,0,0" Foreground="{StaticResource PanelAccentBrush}" BorderThickness="0" />
                                    <TextBlock Text="{Binding Load}" FontSize="9" Foreground="#666" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 过滤 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="过滤:" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding FilterText}" Width="150" Height="24" Padding="6,0" BorderBrush="#CCC" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息表格 -->
        <Border Grid.Row="2" Background="White" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间戳" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="8,4" />
                        <TextBlock Grid.Column="1" Text="通道" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="4" />
                        <TextBlock Grid.Column="2" Text="CAN ID" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="4" />
                        <TextBlock Grid.Column="3" Text="DLC" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="4" />
                        <TextBlock Grid.Column="4" Text="数据 (Hex)" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="4" />
                        <TextBlock Grid.Column="5" Text="类型" FontWeight="SemiBold" FontSize="11" Foreground="#555" Padding="4" />
                    </Grid>
                </Border>

                <!-- 消息列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="White" Margin="0,1,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="White" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="11" Foreground="#333" Padding="8,4" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="11" Foreground="#555" Padding="4" />
                                    <TextBlock Grid.Column="2" Text="{Binding Id}" FontSize="11" Foreground="#0078D4" Padding="4" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{Binding DLC}" FontSize="11" Foreground="#333" Padding="4" TextAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Data}" FontSize="11" Foreground="#333" Padding="4" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="5" Text="{Binding Type}" FontSize="11" Padding="4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="远程">
                                                        <Setter Property="Foreground" Value="#FF9800" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="#F0F0F0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource PanelBorderBrush}">
            <StatusBarItem>
                <Ellipse Width="8" Height="8">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#999" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="总消息数: " />
                    <TextBlock Text="{Binding TotalMessages, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Title}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>