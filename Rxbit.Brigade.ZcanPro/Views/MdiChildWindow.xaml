<UserControl x:Class="Rxbit.Brigade.ZcanPro.Views.MdiChildWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="White"
             MinWidth="280" MinHeight="200">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TitleBarActiveBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="TitleTextBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="{StaticResource TitleBarBrush}" CornerRadius="4,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock Grid.Column="0" x:Name="IconBlock" Text="📊" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />

                    <!-- Title -->
                    <TextBlock Grid.Column="1" x:Name="TitleText" Text="子窗口" Foreground="{StaticResource TitleTextBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI" />

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="2,0">
                        <Button x:Name="MinimizeBtn" Content="—" ToolTip="最小化"
                                Height="24" Width="30" Background="Transparent" BorderThickness="0"
                                Foreground="#D1D5DB" FontSize="10" Cursor="Hand"
                                Click="MinimizeBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#374151" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MaximizeBtn" Content="▢" ToolTip="最大化"
                                Height="24" Width="30" Background="Transparent" BorderThickness="0"
                                Foreground="#D1D5DB" FontSize="10" Cursor="Hand"
                                Click="MaximizeBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#374151" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseBtn" Content="✕" ToolTip="关闭"
                                Height="24" Width="36" Background="Transparent" BorderThickness="0"
                                Foreground="#D1D5DB" FontSize="11" Cursor="Hand"
                                Click="CloseBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentPresenter Grid.Row="1" x:Name="ContentPresenter" />

            <!-- Right-Bottom Resize Thumb (transparent, no visible icon, only cursor feedback) -->
            <Thumb Grid.Row="1" x:Name="ResizeGripRight"
                   Width="16" Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Panel.ZIndex="10"
                   Cursor="SizeNWSE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>