<UserControl x:Class="Brigade.VideoPlayer.Views.VideoPlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Brigade.VideoPlayer.ViewModels"
        Background="{StaticResource DsBgBrush}"
        Foreground="{StaticResource DsTextPrimaryBrush}"
        Focusable="True"
        PreviewKeyDown="VideoPlayerView_PreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- 视频播放区 -->
            <Border Grid.Column="0"
                    Background="#000000"
                    BorderBrush="{StaticResource DsBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DsRadiusCard}"
                    Margin="0,0,10,10">
                <Grid>
                    <MediaElement x:Name="VideoPlayer"
                                  Stretch="Uniform"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  MediaOpened="VideoPlayer_MediaOpened"
                                  MediaEnded="VideoPlayer_MediaEnded" />
                    <TextBlock Text="暂无视频，点击下方“打开文件”添加"
                               Foreground="#5A6474">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DsHintTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentVideoPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentVideoPath}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 播放列表 -->
            <Border Grid.Column="1"
                    Style="{StaticResource DsSurfaceBorderStyle}"
                    Margin="0,0,0,10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="播放列表" Style="{StaticResource DsSectionTitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding Playlist.Count, StringFormat=共 {0} 个}"
                                   Style="{StaticResource DsCaptionStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Playlist}"
                                 SelectedItem="{Binding CurrentVideoPath}"
                                 SelectionMode="Single"
                                 MouseDoubleClick="Playlist_MouseDoubleClick"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="列表为空">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DsHintTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Playlist.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="清空列表"
                                Command="{Binding ClearListCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,5" />
                        <Button Content="移除选中"
                                Command="{Binding RemoveFromListCommand}"
                                CommandParameter="{Binding CurrentVideoPath}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,5"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 控制面板 -->
        <Border Grid.Row="1"
                Style="{StaticResource DsSurfaceBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开文件"
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="18,7"
                            ToolTip="打开视频文件 (Ctrl+O)" />
                    <Border Width="1" Height="24" Background="{StaticResource DsBorderBrush}"
                            Margin="10,0" />
                    <Button Content="上一个"
                            Command="{Binding PreviousCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="上一个视频 (PageUp)" />
                    <Button x:Name="PlayPauseBtn"
                            Content="播放"
                            Command="{Binding PlayCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            MinWidth="56"
                            ToolTip="播放 (空格)"
                            Click="PlayPauseBtn_Click" />
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="停止" />
                    <Button Content="下一个"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="下一个视频 (PageDown)" />
                </StackPanel>

                <!-- 进度条 -->
                <StackPanel Grid.Column="1" Margin="16,0">
                    <Slider x:Name="ProgressSlider"
                            Minimum="0" Maximum="100"
                            Value="{Binding PlayProgress}"
                            Thumb.DragStarted="ProgressSlider_DragStarted"
                            Thumb.DragCompleted="ProgressSlider_DragCompleted"
                            ToolTip="播放进度" />
                    <Grid>
                        <TextBlock Text="{Binding CurrentPositionStr}"
                                   Style="{StaticResource DsCaptionStyle}"
                                   Foreground="{StaticResource DsAccentBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding TotalDurationStr}"
                                   Style="{StaticResource DsCaptionStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- 右侧音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="音量"
                               Style="{StaticResource DsCaptionStyle}"
                               Margin="0,0,8,0" />
                    <Slider x:Name="VolumeSlider"
                            Minimum="0" Maximum="1"
                            Value="{Binding Volume}"
                            Width="110"
                            ToolTip="音量" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
