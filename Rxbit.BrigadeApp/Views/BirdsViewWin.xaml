<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.BirdsViewWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
        xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
        mc:Ignorable="d"
        Title="Birds Eye View"
        Height="750"
        Width="1000"
        Background="#0d0d0d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- 雷达按钮样式 -->
        <Style x:Key="RadarButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#1e1e1e" />
            <Setter Property="Foreground"
                    Value="#a0a0a0" />
            <Setter Property="BorderBrush"
                    Value="#333333" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12,6" />
            <Setter Property="Margin"
                    Value="4" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#2a2a2a" />
                    <Setter Property="BorderBrush"
                            Value="#00bcd4" />
                    <Setter Property="Foreground"
                            Value="#ffffff" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#00bcd4" />
                    <Setter Property="Foreground"
                            Value="#ffffff" />
                    <Setter Property="BorderBrush"
                            Value="#00bcd4" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                    <Setter Property="Cursor"
                            Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 目标列表项样式 -->
        <Style x:Key="TargetListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Margin"
                    Value="2" />
            <Setter Property="Padding"
                    Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#00bcd4" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#1a3a3a" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 详情文本样式 -->
        <Style x:Key="DetailLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#666666" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
        </Style>
        <Style x:Key="DetailValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#cccccc" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="#161616"
                BorderBrush="#222"
                BorderThickness="0,0,0,1"
                Height="38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="12,0">
                    <Ellipse Width="10"
                             Height="10"
                             Fill="#00bcd4"
                             Margin="0,0,10,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0.3"
                                                         Duration="0:0:1.5"
                                                         AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="Birds Eye View"
                               Foreground="#e0e0e0"
                               FontSize="14"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SensorIdText"
                               Text="  |  Sensor ID: 0x310"
                               Foreground="#555"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0">
                    <Button Content="×"
                            Width="32"
                            Height="28"
                            Style="{StaticResource RadarButtonStyle}"
                            Click="CloseButton_Click"
                            Padding="0"
                            Margin="2"
                            FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 雷达画布区域 -->
            <Border Grid.Column="0"
                    Background="#0a0a0a"
                    BorderBrush="#1a1a1a"
                    BorderThickness="1"
                    Margin="6">
                <Grid>
                    <!-- 主Canvas -->
                    <Canvas x:Name="RadarCanvas"
                            Background="Transparent"
                            MouseWheel="RadarCanvas_MouseWheel"
                            MouseLeftButtonDown="RadarCanvas_MouseLeftButtonDown"
                            MouseMove="RadarCanvas_MouseMove"
                            MouseLeftButtonUp="RadarCanvas_MouseLeftButtonUp"
                            MouseLeave="RadarCanvas_MouseLeave">

                        <!-- 网格层 -->
                        <Canvas x:Name="GridCanvas" />

                        <!-- 扫描效果层 -->
                        <Canvas x:Name="ScanCanvas" />

                        <!-- 原点标记 -->
                        <Ellipse x:Name="OriginMarker"
                                 Width="10"
                                 Height="10"
                                 Fill="#ff4444"
                                 Canvas.ZIndex="100"
                                 Stroke="#aa2222"
                                 StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#ff4444"
                                                  BlurRadius="8"
                                                  ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 目标层 -->
                        <Canvas x:Name="TargetCanvas" />

                        <!-- 扫描线 -->
                        <Line x:Name="ScanLine"
                              Stroke="#00bcd4"
                              StrokeThickness="1.5"
                              Opacity="0.4"
                              X1="0"
                              Y1="0"
                              X2="0"
                              Y2="0"
                              StrokeDashArray="5,3">
                            <Line.Effect>
                                <DropShadowEffect Color="#00bcd4"
                                                  BlurRadius="6"
                                                  ShadowDepth="0" />
                            </Line.Effect>
                        </Line>
                    </Canvas>

                    <!-- 左上角信息 -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12,10">
                        <TextBlock x:Name="ZoomInfoText"
                                   Text="Zoom: 1.0x"
                                   Foreground="#444"
                                   FontSize="10" />
                        <TextBlock x:Name="FpsText"
                                   Text="FPS: --"
                                   Foreground="#444"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 右下角坐标显示 -->
                    <TextBlock x:Name="CoordinateText"
                               Text="(0.0m, 0.0m)"
                               Foreground="#444"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,12,8" />
                </Grid>
            </Border>

            <!-- 右侧面板 -->
            <Grid Grid.Column="1"
                  Margin="0,6,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 控制面板 -->
                <Border Grid.Row="0"
                        Background="#161616"
                        BorderBrush="#222"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,6">
                    <StackPanel Margin="12">
                        <TextBlock Text="控制面板"
                                   Foreground="#666"
                                   FontSize="11"
                                   Margin="0,0,0,10"
                                   FontWeight="SemiBold" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartBtn"
                                    Grid.Column="0"
                                    Content="▶ 开始"
                                    Style="{StaticResource RadarButtonStyle}"
                                    Click="StartBtn_Click" />
                            <Button x:Name="StopBtn"
                                    Grid.Column="1"
                                    Content="⏹ 停止"
                                    Style="{StaticResource RadarButtonStyle}"
                                    Click="StopBtn_Click"
                                    IsEnabled="False" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ClearBtn"
                                    Grid.Column="0"
                                    Content="🗑 清除目标"
                                    Style="{StaticResource RadarButtonStyle}"
                                    Click="ClearBtn_Click" />
                            <Button x:Name="ResetZoomBtn"
                                    Grid.Column="1"
                                    Content="⟲ 重置缩放"
                                    Style="{StaticResource RadarButtonStyle}"
                                    Click="ResetZoomBtn_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 目标列表 -->
                <Border Grid.Row="1"
                        Background="#161616"
                        BorderBrush="#222"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1a1a1a"
                                BorderBrush="#222"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标列表"
                                           Foreground="#666"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TargetCountText"
                                           Grid.Column="1"
                                           Text="0"
                                           Foreground="#00bcd4"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="TargetListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4"
                                 SelectionChanged="TargetListBox_SelectionChanged"
                                 ItemContainerStyle="{StaticResource TargetListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#222"
                                            CornerRadius="3"
                                            Padding="8,6"
                                            Margin="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8"
                                                    Height="8"
                                                    CornerRadius="1"
                                                    Background="{Binding FillBrush}"
                                                    Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Id, StringFormat='目标 {0:00}'}"
                                                       Foreground="#ccc"
                                                       FontSize="12" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Type}"
                                                       Foreground="#666"
                                                       FontSize="10" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 目标详情 -->
                <Border Grid.Row="2"
                        Background="#161616"
                        BorderBrush="#222"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="200">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="目标详情"
                                   Foreground="#666"
                                   FontSize="11"
                                   Margin="0,0,0,10"
                                   FontWeight="SemiBold" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailPanel">
                                <TextBlock x:Name="DetailTextBlock"
                                           Text="点击目标或列表项查看详情"
                                           Foreground="#555"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           LineHeight="20" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="#161616"
                BorderBrush="#222"
                BorderThickness="0,1,0,0"
                Height="30">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="就绪"
                           Foreground="#555"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="12,0" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="#00bcd4"
                             Margin="0,0,6,0" />
                    <TextBlock Text="雷达就绪"
                               Foreground="#555"
                               FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Base:WindowBase>
