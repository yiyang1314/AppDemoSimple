<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.CanPlaybackView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 mc:Ignorable="d"
                 Title="CAN Playback - 200K Frames / 200s"
                 Height="600"
                 Width="900"
                 Style="{DynamicResource MonitorWindowStyle}"
                 WindowStartupLocation="CenterScreen">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#16213e" Padding="8,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 文件选择和回放标签 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 📂 文件选择按钮 -->
                    <Button Content="{Binding FileSelectButtonText}"
                            Command="{Binding SelectFileCommand}"
                            ToolTip="选择 ASC 文件"
                            FontSize="14"
                            Width="36" Height="28"
                            Margin="0,0,4,0"
                            Foreground="#00d9ff"
                            Background="#0f3460"
                            BorderBrush="#533483"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="14" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#533483" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 文件名显示 -->
                    <Border Background="#0f3460" CornerRadius="4" Padding="12,4" Margin="0,0,8,0" MaxWidth="200">
                        <TextBlock Text="{Binding FileNameDisplay}"
                                   Foreground="#00d9ff"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}" />
                    </Border>

                    <!-- 在线/回放状态 -->
                    <Border Background="#0f3460" CornerRadius="4" Padding="12,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="{Binding StatusIndicatorColor}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text=" 回放模式" Foreground="#ffffff" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 录制标签 -->
                    <Border Background="#533483" CornerRadius="4" Padding="12,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" Foreground="#e4e4e4" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text=" REC" Foreground="#e4e4e4" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧: 时间戳显示 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimestamp}"
                               Foreground="#00d9ff"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,16,0" />
                    <TextBlock Text="{Binding CurrentDurationStr}"
                               Foreground="#e4e4e4"
                               FontSize="12"
                               Margin="0,0,8,0" />
                    <TextBlock Text="/" Foreground="#666666" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TotalDurationStr}"
                               Foreground="#888888"
                               FontSize="12" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主数据显示区 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding VisibleFrames}"
                  Background="#1a1a2e"
                  Foreground="#e4e4e4"
                  BorderBrush="#16213e"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="12"
                  CanUserResizeColumns="False"
                  HorizontalContentAlignment="Left"
                  RowHeight="28"
                  ColumnHeaderHeight="32"
                  RowBackground="#1a1a2e"
                  AlternatingRowBackground="#1f1f35">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#16213e" />
                    <Setter Property="Foreground" Value="#00d9ff" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="4,2" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="#e4e4e4" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Direction}" Value="Tx">
                            <Setter Property="Foreground" Value="#ff6b6b" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Direction}" Value="Rx">
                            <Setter Property="Foreground" Value="#51cf66" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"
                                    Binding="{Binding FrameIndex}"
                                    Width="50"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding TimeDisplay}"
                                    Width="120"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Dir"
                                    Binding="{Binding Direction}"
                                    Width="40"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="CAN ID"
                                    Binding="{Binding CanIdDisplay}"
                                    Width="80"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="DLC"
                                    Binding="{Binding Dlc}"
                                    Width="40"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    Width="130"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Data (B0..B7)"
                                    Binding="{Binding Data}"
                                    Width="*"
                                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部控制面板 -->
        <Border Grid.Row="2" Background="#0f3460" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧控制按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ⏮ 后退10秒 -->
                    <Button Content="{Binding RewindButtonText}"
                            Command="{Binding RewindCommand}"
                            ToolTip="后退10秒"
                            Style="{DynamicResource PlaybackControlButtonStyle}"
                            FontSize="16"
                            Width="40" Height="32"
                            Margin="2,0" />

                    <!-- ⏪ 上一帧 -->
                    <Button Content="{Binding PrevFrameButtonText}"
                            Command="{Binding PrevFrameCommand}"
                            ToolTip="上一帧"
                            Style="{DynamicResource PlaybackControlButtonStyle}"
                            FontSize="14"
                            Width="36" Height="32"
                            Margin="2,0" />

                    <!-- ▶/⏸ 播放/暂停 -->
                    <Button Content="{Binding PlayPauseButtonText}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="播放/暂停"
                            Style="{DynamicResource PlaybackPrimaryButtonStyle}"
                            FontSize="18"
                            Width="48" Height="32"
                            Margin="4,0" />

                    <!-- ⏩ 下一帧 -->
                    <Button Content="{Binding NextFrameButtonText}"
                            Command="{Binding NextFrameCommand}"
                            ToolTip="下一帧"
                            Style="{DynamicResource PlaybackControlButtonStyle}"
                            FontSize="14"
                            Width="36" Height="32"
                            Margin="2,0" />

                    <!-- ⏭ 前进10秒 -->
                    <Button Content="{Binding ForwardButtonText}"
                            Command="{Binding ForwardCommand}"
                            ToolTip="前进10秒"
                            Style="{DynamicResource PlaybackControlButtonStyle}"
                            FontSize="16"
                            Width="40" Height="32"
                            Margin="2,0" />

                    <!-- ⏹ 停止 -->
                    <Button Content="{Binding StopButtonText}"
                            Command="{Binding StopCommand}"
                            ToolTip="停止"
                            Style="{DynamicResource PlaybackControlButtonStyle}"
                            FontSize="14"
                            Width="36" Height="32"
                            Margin="4,0,2,0" />
                </StackPanel>

                <!-- 中间进度滑动条 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 进度显示 -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Progress, StringFormat={}{0:F1}%}"
                                   Foreground="#00d9ff"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <!-- 中间进度滑动条 (支持拖拽跳转) -->
                        <Slider Grid.Row="1"
                                x:Name="PlaybackSlider"
                                Value="{Binding Progress, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="100"
                                Height="24"
                                PreviewMouseLeftButtonDown="PlaybackSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"
                                MouseMove="PlaybackSlider_MouseMove"
                                Thumb.DragStarted="Thumb_DragStarted"
                                Thumb.DragCompleted="Thumb_DragCompleted"
                                Thumb.DragDelta="Thumb_DragDelta" />
                    </Grid>
                </StackPanel>

                <!-- 右侧时间显示 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding CurrentDurationStr}"
                               Foreground="#ffffff"
                               FontSize="12"
                               Width="90"
                               TextAlignment="Center" />
                    <TextBlock Text="/"
                               Foreground="#666666"
                               FontSize="12"
                               Margin="4,0" />
                    <TextBlock Text="{Binding TotalDurationStr}"
                               Foreground="#888888"
                               FontSize="12"
                               Width="90"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- 循环倍速控制 (单击切换) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="速度:" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="{Binding SpeedButtonText}"
                            Command="{Binding CycleSpeedCommand}"
                            ToolTip="点击切换速度 (1× → 2× → 5× → 10× → 20×)"
                            Height="26"
                            Width="50"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#ffffff"
                            Background="#533483"
                            BorderBrush="#00d9ff"
                            BorderThickness="1"
                            ClickMode="Release"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SpeedBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,2,0" />
                                        </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SpeedBorder" Property="Background" Value="#0f3460" />
                                        <Setter Property="Foreground" Value="#00d9ff" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="SpeedBorder" Property="Background" Value="#00d9ff" />
                                        <Setter Property="Foreground" Value="#1a1a2e" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Base:WindowBase>