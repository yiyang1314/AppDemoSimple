<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.VideoMakerView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 Title="视频制作工具 - 图片+配乐→MP4"
                 Height="720" Width="1180"
                 Background="#1a1a2e"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0f3460" />
            <Setter Property="Foreground" Value="#e4e4e4" />
            <Setter Property="BorderBrush" Value="#16213e" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1a5276" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除按钮 -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#533483" />
            <Setter Property="BorderBrush" Value="#9b59b6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 生成按钮 -->
        <Style x:Key="GenerateButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#00665c" />
            <Setter Property="BorderBrush" Value="#00d9ff" />
            <Setter Property="Foreground" Value="#00d9ff" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="24,10" />
        </Style>

        <!-- 标题文本 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00d9ff" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 信息文本 -->
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 输入框 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16213e" />
            <Setter Property="Foreground" Value="#e4e4e4" />
            <Setter Property="BorderBrush" Value="#0f3460" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <!-- 图片列表项模板 -->
        <DataTemplate x:Key="ImageItemTemplate" DataType="{x:Type vm:ImageItem}">
            <Border Background="#16213e" CornerRadius="4" Padding="4" Margin="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <!-- 缩略图 -->
                    <Image Grid.Column="0" Source="{Binding Thumbnail}"
                           Width="72" Height="48" Stretch="UniformToFill"
                           Margin="0,0,6,0" />

                    <!-- 文件名 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding FileName}"
                               Foreground="#e4e4e4" FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 时长输入 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                 Width="36" FontSize="11"
                                 Background="#0f3460" Foreground="#00d9ff"
                                 BorderBrush="#0f3460" Padding="2"
                                 HorizontalContentAlignment="Center" />
                        <TextBlock Text="s" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>

                    <!-- 删除按钮 -->
                    <Button Grid.Column="3"
                            Content="✕"
                            Style="{StaticResource DeleteButton}"
                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Width="28" Height="24"
                            FontSize="10" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 工具栏 -->
            <RowDefinition Height="*" />     <!-- 主体 -->
            <RowDefinition Height="Auto" />  <!-- 底部状态 -->
        </Grid.RowDefinitions>

        <!-- ====== 顶部工具栏 ====== -->
        <Border Grid.Row="0" Background="#16213e" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎬 视频制作工具" Foreground="#00d9ff" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="| 批量导入图片 + MP3配乐 → MP4视频" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ====== 主体区域 ====== -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />   <!-- 左侧：图片+配乐配置 -->
                <ColumnDefinition Width="8" />     <!-- 间隔 -->
                <ColumnDefinition Width="*" />     <!-- 右侧：视频预览+播放 -->
            </Grid.ColumnDefinitions>

            <!-- ====== 左侧配置面板 ====== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- 图片列表 -->
                    <RowDefinition Height="Auto" /> <!-- 图片操作按钮 -->
                    <RowDefinition Height="Auto" /> <!-- 默认时长 -->
                    <RowDefinition Height="Auto" /> <!-- MP3配乐 -->
                    <RowDefinition Height="Auto" /> <!-- 输出设置 -->
                    <RowDefinition Height="Auto" /> <!-- 生成按钮 -->
                </Grid.RowDefinitions>

                <!-- 图片列表 -->
                <Border Grid.Row="0" Background="#0f0f1e" CornerRadius="4" Padding="4" Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="📦 图片列表" Margin="4,4,4,4" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ImageItems}"
                                          ItemTemplate="{StaticResource ImageItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空列表提示 -->
                        <TextBlock Grid.Row="1"
                                   Text="点击下方按钮导入图片"
                                   Style="{StaticResource InfoText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ImageItems.Count, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!-- 图片操作按钮 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                    <Button Content="📁 导入图片"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding ImportImagesCommand}" />
                    <Button Content="📂 导入文件夹"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding ImportFolderCommand}" />
                    <Button Content="🗑 清空"
                            Style="{StaticResource DeleteButton}"
                            Command="{Binding ClearImagesCommand}" />
                </StackPanel>

                <!-- 默认每张图片时长 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="每张时长:" Style="{StaticResource InfoText}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding DefaultImageDuration, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                             Width="50" Margin="8,0,0,0"
                             Style="{StaticResource InputBox}" IsReadOnly="False" />
                    <TextBlock Text="秒" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBlock Text="| 视频总时长:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding TotalDurationStr}" Foreground="#00d9ff" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- MP3配乐选择 -->
                <Border Grid.Row="3" Background="#0f0f1e" CornerRadius="4" Padding="6" Margin="0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="🎵 MP3配乐" />

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Mp3FileName}"
                                     Style="{StaticResource InputBox}" />
                            <Button Grid.Column="1"
                                    Content="📁 浏览"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding BrowseMp3Command}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="配乐时长:" Style="{StaticResource InfoText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Mp3DurationStr}" Foreground="#00d9ff" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding AudioTrimInfo}"
                                   Style="{StaticResource InfoText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 输出设置 -->
                <Border Grid.Row="4" Background="#0f0f1e" CornerRadius="4" Padding="6" Margin="0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="💾 输出设置" />

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputPath}"
                                     Style="{StaticResource InputBox}" />
                            <Button Grid.Column="1"
                                    Content="📁 浏览"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding BrowseOutputCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="文件名:" Style="{StaticResource InfoText}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding OutputFileName}"
                                     Width="150" Margin="8,0,0,0"
                                     Style="{StaticResource InputBox}" IsReadOnly="False" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="分辨率:" Style="{StaticResource InfoText}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding VideoWidth}" Width="50" Margin="8,0,0,0" Style="{StaticResource InputBox}" IsReadOnly="False" />
                            <TextBlock Text="x" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="2,0,2,0" />
                            <TextBox Text="{Binding VideoHeight}" Width="50" Style="{StaticResource InputBox}" IsReadOnly="False" />
                            <TextBlock Text="帧率:" Style="{StaticResource InfoText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBox Text="{Binding FrameRate}" Width="30" Margin="4,0,0,0" Style="{StaticResource InputBox}" IsReadOnly="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 生成按钮 + 进度 -->
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <Button Content="🎬 生成 MP4 视频"
                            Style="{StaticResource GenerateButton}"
                            Command="{Binding GenerateVideoCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0" />

                    <!-- 进度条 -->
                    <Grid Margin="0,6,0,0">
                        <ProgressBar Value="{Binding GenerateProgress}"
                                     Height="20"
                                     Background="#16213e"
                                     Foreground="#00d9ff"
                                     BorderBrush="#0f3460" />
                        <TextBlock Text="{Binding GenerateStatus}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#e4e4e4" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ====== 右侧视频预览+播放 ====== -->
            <Border Grid.Column="2" Background="#0f0f1e" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- 标题 -->
                        <RowDefinition Height="*" />     <!-- 播放器 -->
                        <RowDefinition Height="Auto" />  <!-- 播放控制 -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="▶ 视频预览播放" />

                    <!-- 视频播放区域 -->
                    <Border Grid.Row="1" Background="#000000" CornerRadius="4" Margin="0,0,0,8">
                        <Grid>
                            <MediaElement x:Name="VideoPlayer"
                                          Stretch="Uniform"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          MediaOpened="VideoPlayer_MediaOpened"
                                          MediaEnded="VideoPlayer_MediaEnded" />

                            <!-- 未加载视频提示 -->
                            <TextBlock Text="生成的视频将在此播放"
                                       Foreground="#444"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsVideoLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- 播放控制栏 -->
                    <Border Grid.Row="2" Background="#16213e" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <!-- 进度条 -->
                            <Slider x:Name="VideoSlider"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding PlayProgress}"
                                    Thumb.DragStarted="VideoSlider_DragStarted"
                                    Thumb.DragCompleted="VideoSlider_DragCompleted"
                                    Height="24"
                                    Background="#0f0f1e"
                                    Foreground="#00d9ff" />

                            <!-- 时间显示 -->
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentPositionStr}"
                                           Foreground="#00d9ff" FontSize="11"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding TotalDurationStr}"
                                           Foreground="#888" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- 播放按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Content="▶ 播放/暂停"
                                        Style="{StaticResource ActionButton}"
                                        Command="{Binding PlayPauseCommand}" />
                                <Button Content="⏹ 停止"
                                        Style="{StaticResource ActionButton}"
                                        Command="{Binding StopCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== 底部状态栏 ====== -->
        <Border Grid.Row="2" Background="#16213e" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- FFmpeg 状态显示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FFmpeg: " Foreground="#888" FontSize="11" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#ff6b6b" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFFmpegAvailable}" Value="True">
                                        <Setter Property="Fill" Value="#00ff88" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding FFmpegStatusText}"
                               Foreground="{Binding FFmpegStatusColor}"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FFmpegPath}"
                               Foreground="#555" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" />
                </StackPanel>

                <!-- FFmpeg 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 重新检测"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding DetectFFmpegCommand}"
                            FontSize="10" Padding="8,4" />
                    <Button Content="📂 手动指定"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding BrowseFFmpegCommand}"
                            FontSize="10" Padding="8,4" />
                    <Button Content="⬇ 下载FFmpeg"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding DownloadFFmpegCommand}"
                            FontSize="10" Padding="8,4" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Base:WindowBase>
