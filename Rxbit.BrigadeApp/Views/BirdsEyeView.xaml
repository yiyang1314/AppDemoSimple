<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.BirdsEyeView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 mc:Ignorable="d"
                 DataContext="{Binding Path=BirdsEyeVM,Source={StaticResource Locator}}"
                 Title="Birds Eye View"
                 Height="380"
                 Width="480"
                 Style="{DynamicResource MonitorWindowStyle}"
                 WindowStyle="ToolWindow"
                 ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="#0f3460">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Birds Eye View" FontSize="12" FontWeight="Bold" Foreground="#00d9ff" Margin="8 4" />
            <Label Grid.Column="1" Content="|" FontSize="10" Foreground="#666666" Margin="4 4" />
            <Label Grid.Column="1" Content="ID 01 | ID 02 | ID 03 | ID 04" FontSize="10" Foreground="#666666" Margin="20 4 8 4" HorizontalAlignment="Right" />
        </Grid>

        <!-- 主显示区域 -->
        <Grid Grid.Row="1" Background="#16213e">
            <Canvas Name="detectionCanvas" Margin="10">
                <!-- X轴标签 -->
                <TextBlock Canvas.Left="30" Canvas.Top="320" Text="-8m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="100" Canvas.Top="320" Text="-4m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="170" Canvas.Top="320" Text="0" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="240" Canvas.Top="320" Text="+4m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="310" Canvas.Top="320" Text="+8m" FontSize="9" Foreground="#666666" />
                
                <!-- Y轴标签 -->
                <TextBlock Canvas.Left="5" Canvas.Top="50" Text="60m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="5" Canvas.Top="110" Text="48m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="5" Canvas.Top="170" Text="36m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="5" Canvas.Top="230" Text="24m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="5" Canvas.Top="290" Text="12m" FontSize="9" Foreground="#666666" />
                <TextBlock Canvas.Left="5" Canvas.Top="340" Text="0" FontSize="9" Foreground="#666666" />

                <!-- 网格线 - 水平 -->
                <Line X1="30" Y1="50" X2="350" Y2="50" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="30" Y1="110" X2="350" Y2="110" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="30" Y1="170" X2="350" Y2="170" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="30" Y1="230" X2="350" Y2="230" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="30" Y1="290" X2="350" Y2="290" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="30" Y1="340" X2="350" Y2="340" Stroke="#0f3460" StrokeThickness="1" />
                
                <!-- 网格线 - 垂直 -->
                <Line X1="30" Y1="50" X2="30" Y2="340" Stroke="#0f3460" StrokeThickness="1" />
                <Line X1="100" Y1="50" X2="100" Y2="340" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="170" Y1="50" X2="170" Y2="340" Stroke="#0f3460" StrokeThickness="1" />
                <Line X1="240" Y1="50" X2="240" Y2="340" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="310" Y1="50" X2="310" Y2="340" Stroke="#0f3460" StrokeThickness="0.5" />
                <Line X1="350" Y1="50" X2="350" Y2="340" Stroke="#0f3460" StrokeThickness="0.5" />

                <!-- 传感器位置 (红色原点) -->
                <Ellipse Canvas.Left="165" Canvas.Top="335" Width="8" Height="8" Fill="#ff4444" />
                <TextBlock Canvas.Left="150" Canvas.Top="350" Text="Sensor" FontSize="8" Foreground="#ff4444" />
                <TextBlock Canvas.Left="195" Canvas.Top="350" Text="ID:0x310" FontSize="8" Foreground="#666666" />

                <!-- 检测点 -->
                <ItemsControl ItemsSource="{Binding DetectionPoints}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Cursor="Hand" MouseDown="Ellipse_MouseDown">
                                <Ellipse Width="14" Height="14" Fill="{Binding FillColor}" Opacity="0.8" />
                                <TextBlock Text="{Binding Id}" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Background="#0f3460" Height="20">
            <Label Content="Birds Eye View - Detection Area" FontSize="10" Foreground="#666666" Margin="8 2" />
        </Grid>
    </Grid>
</Base:WindowBase>
