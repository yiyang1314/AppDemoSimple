<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.Asc2BrigadeWin"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 mc:Ignorable="d"
                 Title="Asc to Brigade"
                 Width="800" Height="680"
                 WindowStartupLocation="CenterScreen"
                 Background="#3e4141">

    <Base:WindowBase.DataContext>
        <vm:Brigade2RaddarViewModel />
    </Base:WindowBase.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0f3460"
                CornerRadius="8"
                Padding="16 12"
                Margin="0 0 0 15">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Rectangle Width="3"
                           Height="16"
                           Fill="#00d9ff"
                           Margin="0 0 12 0" />
                <TextBlock Text="{StaticResource tool_Conversion}"
                           Foreground="#00d9ff"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0 0 0 12">
            <TextBlock Text="{StaticResource inPutPath_Tip}"
                       Foreground="#d0d0d0"
                       FontSize="12"
                       Width="80"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding SourceFilePath}"
                     IsReadOnly="True"
                     Background="#1e2a3d"
                     Foreground="#d0d0d0"
                     BorderBrush="#3a4a5d"
                     BorderThickness="1"
                     FontSize="12"
                     Width="420"
                     Height="32"
                     VerticalContentAlignment="Center" />
            <Button Content="..."
                    Command="{Binding SelectFileCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="12"
                    Width="40"
                    Height="32"
                    Margin="8 0 0 0"
                    BorderBrush="#00d9ff"
                    BorderThickness="1" />
            <Button Content="Convertor"
                    Command="{Binding ConvertorCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="12"
                    Width="120"
                    Height="32"
                    Margin="8 0 0 0"
                    BorderBrush="#00d9ff"
                    BorderThickness="1" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#1e2a3d"
                BorderBrush="#3a4a5d"
                BorderThickness="1"
                Padding="12"
                Margin="0 0 0 12">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#00d9ff"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{StaticResource Common_Close}"
                    Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="12"
                    Width="80"
                    Height="32"
                    BorderBrush="#5a6a7d"
                    BorderThickness="1" />
        </StackPanel>
    </Grid>
</Base:WindowBase>
