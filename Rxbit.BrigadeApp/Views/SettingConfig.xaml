<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.SettingSensor"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                 xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 mc:Ignorable="d"
                 Title="Path Configuration"
                 Height="450"
                 Width="800">
    <Base:WindowBase.DataContext>
        <vm:SettingSensorViewModel />
    </Base:WindowBase.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel Background="#1a1a2e">
        <Border  DockPanel.Dock="Top"
                 BorderBrush="#3a4a5d"
                 BorderThickness="0"
                 Padding="0 1"
                 Margin="0 0 0 12">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="10 5"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Background="#40508d">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Path Configuration"
                                   Foreground="#00d9ff"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left" />
                        <ToggleButton IsChecked="{Binding IsEditable,Mode=TwoWay}" Visibility="Collapsed"
                                      Grid.Column="1"
                                      Content="{StaticResource UDS_Edit_Tip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      HorizontalAlignment="Right"
                                      Foreground="White"
                                      Style="{DynamicResource PurpleToggleSwitch_TextLeft}" />
                    </Grid>
                </Border>

                <Border Background="#0f3460"
                        CornerRadius="8 8 0 0"
                        DockPanel.Dock="Top"
                        Padding="16 12"
                        Margin="10 5">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Rectangle Width="3"
                                   Height="16"
                                   Fill="#00d9ff"
                                   Margin="0 0 12 0" />
                        <TextBlock Text="Path Configuration"
                                   Foreground="#00d9ff"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Grid IsEnabled="{Binding IsEditable}"
                      DockPanel.Dock="Top"
                      Margin="10 10"
                      Background="#1e2a3d">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0 0 0 8">
                        <TextBlock Text="Recording Path:"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="20 5"
                                   Width="140"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding RecodingPath}"
                                 Background="#2a3a4d"
                                 Foreground="White"
                                 BorderBrush="White"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="380"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="..."
                                Command="{Binding SelectFileCommand}"
                                CommandParameter="recoding"
                                IsEnabled="{Binding IsEditable}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="12"
                                Width="40"
                                Height="28"
                                Margin="8 0 0 0"
                                BorderBrush="#00d9ff"
                                BorderThickness="1" />

                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0 0 0 8">
                        <TextBlock Text="Logs Path"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="20 5"
                                   Width="140"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding LogPath}"
                                 Background="#2a3a4d"
                                 Foreground="White"
                                 BorderBrush="White"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="380"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="..."
                                Command="{Binding SelectFileCommand}"
                                CommandParameter="log"
                                IsEnabled="{Binding IsEditable}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="12"
                                Width="40"
                                Height="28"
                                Margin="8 0 0 0"
                                BorderBrush="#00d9ff"
                                BorderThickness="1" />

                    </StackPanel>
                </Grid>
                <Border Background="#0f3460"
                        CornerRadius="8 8 0 0"
                        DockPanel.Dock="Top"
                        Padding="16 12"
                        Margin="10 5">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Rectangle Width="3"
                                   Height="16"
                                   Fill="#00d9ff"
                                   Margin="0 0 12 0" />
                        <TextBlock Text="UDS Configuration"
                                   Foreground="#00d9ff"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Height="50"
                            DockPanel.Dock="Top"
                            IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{StaticResource UDS_REQ_Tip}"
                               Width="100"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="20 5 10 5" />
                    <TextBox Text="{Binding ReqTx}"
                             Width="80"
                             ToolTip="input hex address"
                             Background="#2a3a4d"
                             Foreground="White"
                             BorderBrush="White"
                             BorderThickness="1"
                             FontSize="14"
                             Height="28"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="{StaticResource UDS_RSP_Tip}"
                               Width="100"
                               VerticalAlignment="Center"
                               Margin="20 5" />
                    <TextBox Text="{Binding RspRx}"
                             Width="80"
                             ToolTip="input hex address"
                             Background="#2a3a4d"
                             Foreground="White"
                             BorderBrush="White"
                             HorizontalContentAlignment="Center"
                             BorderThickness="1"
                             FontSize="14"
                             Height="28"
                             VerticalContentAlignment="Center" />

                </StackPanel>
                <StackPanel  Orientation="Horizontal"
                             DockPanel.Dock="Top" Visibility="Collapsed"
                             IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="Flash Driver Path "
                               Margin="20 5 10 5"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Width="100"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding FlashPath}"
                             IsReadOnly="True"
                             Background="#2a3a4d"
                             Foreground="White"
                             BorderBrush="White"
                             BorderThickness="1"
                             FontSize="11"
                             Width="480"
                             Height="28"
                             VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Height="50"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Common_Save}"
                            Command="{Binding SaveCommand}"
                            FontSize="12"
                            Margin="10 2"
                            Width="80"
                            Height="32"
                            Style="{StaticResource RadarButtonStyle}" />
                    <Button Content="{StaticResource Common_Close}"
                            Click="CloseButton_Click"
                            Style="{StaticResource RadarButtonStyle}"
                            FontSize="12"
                            Margin="10 2"
                            Width="80"
                            Height="32" />
                </StackPanel>

            </DockPanel>
        </Border>
    </DockPanel>
</Base:WindowBase>