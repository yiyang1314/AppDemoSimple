<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.VideoPlaybackView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 mc:Ignorable="d"
                 Title="Video Playback"
                 Height="640"
                 Width="860"
                 WindowStartupLocation="CenterOwner"
                 Style="{StaticResource {x:Type Base:WindowBase}}">

    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0"
              Margin="20 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Rectangle Width="24"
                           Height="24"
                           Fill="#00d9ff"
                           RadiusX="6"
                           RadiusY="6"
                           Margin="0 0 12 0">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#00d9ff"
                                          BlurRadius="10"
                                          Opacity="0.6" />
                    </Rectangle.Effect>
                </Rectangle>
                <TextBlock Text="Video Playback"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#ffffff"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="10 4"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="#16213e"
                    BorderBrush="#2a2a3e"
                    BorderThickness="1">
                <TextBlock Text="{Binding PlaybackStateText}"
                           FontSize="13"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="#9ca3af" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="#4ade80" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Height="1"
                Background="#2a2a3e"
                Margin="0 5" />

        <!-- 文件选择 -->
        <Border Grid.Row="2"
                Margin="20 10 20 0"
                BorderBrush="#2a2a3e"
                BorderThickness="1"
                CornerRadius="8"
                Background="#16213e">
            <Grid Margin="20 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Video File:"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0 0 12 0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FilePath}"
                           Foreground="#00d9ff"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePath}" />
                <Button Grid.Column="2"
                        Content="Open..."
                        Height="32"
                        Width="110"
                        Command="{Binding OpenCommand}"
                        Style="{StaticResource RadarButtonStyle}" />
            </Grid>
        </Border>

        <!-- 回放画面 -->
        <Border Grid.Row="3"
                Margin="20 10"
                Background="#000000"
                BorderBrush="#2a2a3e"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Image Source="{Binding CurrentFrame}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="尚未选择视频文件"
                           Foreground="#9ca3af"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentFrame}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 进度与信息 -->
        <Border Grid.Row="4"
                Margin="20 0"
                BorderBrush="#2a2a3e"
                BorderThickness="1"
                CornerRadius="8"
                Background="#16213e">
            <Grid Margin="20 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding PositionText}"
                           Foreground="#ffffff"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0 0 10 0" />
                <Slider Grid.Row="0"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding PositionMaximum}"
                        Value="{Binding PositionValue, Mode=TwoWay}"
                        IsMoveToPointEnabled="True"
                        SmallChange="1"
                        LargeChange="10"
                        VerticalAlignment="Center"
                        Margin="0 0 10 0" />
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="{Binding DurationText}"
                           Foreground="#9ca3af"
                           FontSize="13"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Foreground="#00d9ff"
                           FontSize="12"
                           Margin="0 6 0 0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}">
                    <Run Text="{Binding InfoText, Mode=OneWay}" />
                    <Run Text="  |  " />
                    <Run Text="{Binding StatusMessage, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20 0">
            <Button Content="▶ Play"
                    Width="110"
                    Height="34"
                    Margin="0 0 12 0"
                    Command="{Binding PlayCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="❚❚ Pause"
                    Width="110"
                    Height="34"
                    Margin="0 0 12 0"
                    IsEnabled="{Binding IsPlaying}"
                    Command="{Binding PauseCommand}"
                    Style="{StaticResource RadarButtonStyle}" />
            <Button Content="■ Stop"
                    Width="100"
                    Height="34"
                    Margin="0 0 12 0"
                    IsEnabled="{Binding HasFile}"
                    Command="{Binding StopCommand}"
                    Style="{StaticResource RadarButtonStyle}" />
            <Button Content="Open Folder"
                    Width="110"
                    Height="34"
                    Margin="0 0 12 0"
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource RadarButtonStyle}" />
            <Button Content="Close"
                    Width="90"
                    Height="34"
                    Click="CloseButton_Click"
                    Style="{StaticResource RadarButtonStyle}" />
        </StackPanel>
    </Grid>
</Base:WindowBase>
