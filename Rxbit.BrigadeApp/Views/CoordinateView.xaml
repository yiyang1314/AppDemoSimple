<UserControl x:Class="Rxbit.BrigadeApp.Views.CoordinateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Rxbit.BrigadeApp.Controls"
             xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
             mc:Ignorable="d"
             DataContext="{Binding Path= CoordinateVM,Source={StaticResource Locator}}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1a1a2e">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧配置面板 -->
        <Grid Grid.Column="0" Background="#16213e" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="坐标系配置" Foreground="#00d9ff" FontSize="14" FontWeight="Bold" Margin="10 10 10 5" />
            
            <!-- 坐标系类型 -->
            <TextBlock Grid.Row="1" Text="坐标系类型:" Foreground="#e4e4e4" FontSize="11" Margin="10 5 10 2" />
            <ComboBox Grid.Row="2" ItemsSource="{Binding CoordinateTypes}" 
                      SelectedItem="{Binding SelectedCoordinateType}"
                      Margin="10 2 10 10" Height="24" 
                      Background="#1f1f2e" Foreground="#e4e4e4" 
                      BorderBrush="#00d9ff" BorderThickness="1">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- X范围 -->
            <TextBlock Grid.Row="3" Text="X轴范围:" Foreground="#e4e4e4" FontSize="11" Margin="10 5 10 2" />
            <TextBox Grid.Row="4" Text="{Binding XRange}" Margin="10 2 10 5" Height="24"
                     Background="#1f1f2e" Foreground="#e4e4e4" 
                     BorderBrush="#00d9ff" BorderThickness="1" />

            <!-- Y范围 -->
            <TextBlock Grid.Row="5" Text="Y轴范围:" Foreground="#e4e4e4" FontSize="11" Margin="10 5 10 2" />
            <TextBox Grid.Row="6" Text="{Binding YRange}" Margin="10 2 10 5" Height="24"
                     Background="#1f1f2e" Foreground="#e4e4e4" 
                     BorderBrush="#00d9ff" BorderThickness="1" />

            <!-- 像素比例 -->
            <TextBlock Grid.Row="7" Text="像素比例(X/Y):" Foreground="#e4e4e4" FontSize="11" Margin="10 5 10 2" />
            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="10 2 10 5">
                <TextBox Text="{Binding XScale}" Width="60" Height="24"
                         Background="#1f1f2e" Foreground="#e4e4e4" 
                         BorderBrush="#00d9ff" BorderThickness="1" />
                <TextBlock Text=" / " Foreground="#e4e4e4" Margin="4 0" VerticalAlignment="Center" />
                <TextBox Text="{Binding YScale}" Width="60" Height="24"
                         Background="#1f1f2e" Foreground="#e4e4e4" 
                         BorderBrush="#00d9ff" BorderThickness="1" />
            </StackPanel>

            <!-- 雷达半径 -->
            <TextBlock Grid.Row="9" Text="雷达半径(m):" Foreground="#e4e4e4" FontSize="11" Margin="10 5 10 2" />
            <TextBox Grid.Row="10" Text="{Binding RadarRadius}" Margin="10 2 10 10" Height="24"
                     Background="#1f1f2e" Foreground="#e4e4e4" 
                     BorderBrush="#00d9ff" BorderThickness="1" />

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="11" Orientation="Vertical" Margin="10">
                <Button Content="开始扫描" Command="{Binding StartScanCommand}" 
                        Margin="0 0 0 5" Height="28"
                        Background="#0f3460" Foreground="#e4e4e4" 
                        BorderBrush="#00d9ff" BorderThickness="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Content" Value="停止扫描" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="添加目标" Command="{Binding AddTargetCommand}" 
                        Margin="0 0 0 5" Height="28"
                        Background="#0f3460" Foreground="#e4e4e4" 
                        BorderBrush="#00d9ff" BorderThickness="1" />
                <Button Content="清空目标" Command="{Binding ClearTargetsCommand}" 
                        Height="28"
                        Background="#0f3460" Foreground="#e4e4e4" 
                        BorderBrush="#00d9ff" BorderThickness="1" />
            </StackPanel>
        </Grid>

        <!-- 中间显示区域 -->
        <Grid Grid.Column="1">
            <controls:CoordinateCanvas 
                x:Name="coordCanvas"
                CoordinateType="{Binding SelectedCoordinateType}"
                XRange="{Binding XRange}"
                YRange="{Binding YRange}"
                XScale="{Binding XScale}"
                YScale="{Binding YScale}"
                RadarRadius="{Binding RadarRadius}"
                RadarSectors="12"
                GridSize="10"
                Targets="{Binding Targets}"
                IsScanning="{Binding IsScanning}"
                SelectedTarget="{Binding SelectedTarget}"
                Background="#1a1a2e" />
        </Grid>

        <!-- 底部目标信息面板 -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Height="100" Background="#16213e" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
                <TextBlock Text="目标信息" Foreground="#00d9ff" FontSize="12" FontWeight="Bold" Margin="0 5 0 5" />
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="ID:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.Id}" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="X:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.X, StringFormat=F2}" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="Y:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.Y, StringFormat=F2}" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="距离:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.Distance, StringFormat=F2}" Foreground="#00ff88" FontSize="11" />
                    <TextBlock Text=" m" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="角度:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.Angle, StringFormat=F1}" Foreground="#00ff88" FontSize="11" />
                    <TextBlock Text="°" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
                    <TextBlock Text="类型:" Foreground="#e4e4e4" FontSize="11" Width="40" />
                    <TextBlock Text="{Binding SelectedTarget?.Type}" Foreground="#00ff88" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10">
                <TextBlock Text="操作提示" Foreground="#00d9ff" FontSize="12" FontWeight="Bold" Margin="0 5 0 5" />
                <TextBlock Text="• 鼠标左键点击目标选中" Foreground="#e4e4e4" FontSize="11" Margin="0 2 0 0" />
                <TextBlock Text="• 拖拽目标可移动位置" Foreground="#e4e4e4" FontSize="11" Margin="0 2 0 0" />
                <TextBlock Text="• 拖拽空白区域可平移" Foreground="#e4e4e4" FontSize="11" Margin="0 2 0 0" />
                <TextBlock Text="• 滚轮缩放坐标系" Foreground="#e4e4e4" FontSize="11" Margin="0 2 0 0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>