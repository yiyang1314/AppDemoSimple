<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.WinHelper"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 mc:Ignorable="d"
                 Title="{StaticResource tool_Assistant}"
                 Height="700"
                 Width="880"
                 WindowStartupLocation="CenterScreen"
                 Background="#3e4141">

    <Base:WindowBase.DataContext>
        <vm:WinHelperViewModel />
    </Base:WindowBase.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0f3460"
                CornerRadius="8"
                Padding="16 12"
                Margin="0 0 0 15">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Rectangle Width="3"
                           Height="16"
                           Fill="#00d9ff"
                           Margin="0 0 12 0" />
                <TextBlock Text="{StaticResource tool_Assistant}"
                           Foreground="#00d9ff"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#1e2a3d"
                BorderBrush="#3a4a5d"
                BorderThickness="1"
                Padding="16"
                Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="Flash Converter (Bin/Hex)"
                           Foreground="#00d9ff"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0 0 0 8">
                        <TextBlock Text="BIN File:"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding BinFilePath}"
                                 IsReadOnly="True"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="300"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="..."
                                Command="{Binding SelectBinFileCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="40"
                                Height="28"
                                Margin="8 0 0 0" />
                        <TextBlock Text="Start Address(Hex):"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Margin="10 0"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding StartAddress}"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 ToolTip="Hex length is 8"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="100"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="BIN → HEX"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="100"
                                Height="28"
                                Margin="8 0 0 0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal">
                        <TextBlock Text="HEX File:"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding HexFilePath}"
                                 IsReadOnly="True"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="300"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="..."
                                Command="{Binding SelectHexFileCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="40"
                                Height="28"
                                Margin="8 0 0 0" />
                        <Button Content="HEX → BIN"
                                Command="{Binding HexToBinCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="100"
                                Height="28"
                                Margin="8 0 0 0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#1e2a3d"
                BorderBrush="#3a4a5d"
                BorderThickness="1"
                Padding="16"
                Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="Data Converter (Byte/String/Hex)"
                           Foreground="#00d9ff"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0 0 0 8">
                        <TextBlock Text="Byte[]:"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding ByteInput}"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="580"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="→ String"
                                Command="{Binding ByteToStringCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="80"
                                Height="28"
                                Margin="8 0 0 0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0 0 0 8">
                        <TextBlock Text="String:"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding StringInput}"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="580"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="→ Hex"
                                Command="{Binding StringToHexCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="80"
                                Height="28"
                                Margin="8 0 0 0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <TextBlock Text="Hex:"
                                   Foreground="#8899aa"
                                   FontSize="11"
                                   Width="70"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding HexInput}"
                                 Background="#2a3a4d"
                                 Foreground="#d0d0d0"
                                 BorderBrush="#3a4a5d"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Width="580"
                                 Height="28"
                                 VerticalContentAlignment="Center" />
                        <Button Content="→ String"
                                Command="{Binding HexToStringCommand}"
                                Style="{StaticResource RadarButtonStyle}"
                                FontSize="11"
                                Width="80"
                                Height="28"
                                Margin="8 0 0 0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#1e2a3d"
                BorderBrush="#3a4a5d"
                BorderThickness="1"
                Padding="16"
                Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="{StaticResource tool_CRCVerify}"
                           Foreground="#00d9ff"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="File:"
                               Foreground="#8899aa"
                               FontSize="11"
                               Width="70"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding CrcFilePath}"
                             IsReadOnly="True"
                             Background="#2a3a4d"
                             Foreground="#d0d0d0"
                             BorderBrush="#3a4a5d"
                             BorderThickness="1"
                             FontSize="11"
                             Width="400"
                             Height="28"
                             VerticalContentAlignment="Center" />
                    <Button Content="..."
                            Command="{Binding SelectCrcFileCommand}"
                            Style="{StaticResource RadarButtonStyle}"
                            FontSize="11"
                            Width="40"
                            Height="28"
                            Margin="8 0 0 0"/>
                    <ComboBox Margin="8 0 5 0"
                              SelectedIndex="{Binding SelectCrcIndex}"
                              VerticalContentAlignment="Center"
                              Foreground="Black"
                              Width="80">
                        <ComboBoxItem Content="CRC32" />
                        <ComboBoxItem Content="CRC16" />
                        <ComboBoxItem Content="CRC8" />
                    </ComboBox>
                    <Button Content="{StaticResource Ecuboot_CRCTip}"
                            Command="{Binding CalculateCrcCommand}"
                            
                            Style="{StaticResource RadarButtonStyle}"
                            FontSize="11"
                            Width="100"
                            Height="28"
                            Margin="8 0 0 0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0 10 0 0">
                    <TextBlock Text="CRC Result:"
                               Foreground="#8899aa"
                               FontSize="11"
                               Width="70"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding CrcResult}"
                             IsReadOnly="True"
                             Background="#2a3a4d"
                             Foreground="#00ff00"
                             BorderBrush="#3a4a5d"
                             BorderThickness="1"
                             FontSize="11"
                             Width="200"
                             Height="28"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="#1e2a3d"
                BorderBrush="#3a4a5d"
                BorderThickness="1"
                Padding="12"
                Margin="0 0 0 12">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#00d9ff"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top" />
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{StaticResource Common_Close}"
                    Style="{StaticResource RadarButtonStyle}"
                    FontSize="12"
                    Width="80"
                    Height="32" />
        </StackPanel>
    </Grid>
</Base:WindowBase>