<Base:WindowBase x:Class="Rxbit.BrigadeApp.Views.NetworkSummaryView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                 xmlns:local="clr-namespace:Rxbit.BrigadeApp.Views"
                 xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
                 mc:Ignorable="d"
                 xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
                 Title="Network Summary"
                 Height="640"
                 Width="1180"
                 DataContext="{Binding Path=NetworkVM,Source={StaticResource Locator}}"
                 WindowStyle="ToolWindow"
                 ResizeMode="CanResize">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding ClosedCommand}" />
        </i:EventTrigger>

        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Base:WindowBase.Resources>

        <Style x:Key="RadarColumnTextStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="11" />
        </Style>
        <!-- DataGridCell样式 - 确保内容拉伸填充 -->
        <Style x:Key="RadarDataGridCellStyle"
               TargetType="DataGridCell">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#e4e4e4" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGridColumnHeader样式 - 移除表头内边距 -->
        <Style x:Key="RadarDataGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#16213e" />
            <Setter Property="Foreground"
                    Value="#00d9ff" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="0 0 1 1" />
            <Setter Property="BorderBrush"
                    Value="#00d9ff" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="#16213e"
                                BorderBrush="#00d9ff"
                                BorderThickness="0 0 1 1"
                                Padding="0"
                                Margin="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#0f3460" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RadarCellBorderStyle"
               TargetType="Border">
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="BorderThickness"
                    Value="0 0 1 0" />
            <Setter Property="BorderBrush"
                    Value="#2a3a4d" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Width"
                    Value="60" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="Background"
                            Value="#0F7979" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RadarHeaderBorderStyle"
               TargetType="Border">
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="Width"
                    Value="60" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="BorderThickness"
                    Value="0 0 1 0" />
            <Setter Property="BorderBrush"
                    Value="#00d9ff" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="Background"
                            Value="#0F7979" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 【只封装单元格模板】 可无限复用 -->
        <DataTemplate x:Key="RadarCellTemplate">
            <ItemsControl ItemsSource="{Binding Items}"
                          Margin="0"
                          Padding="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16"
                                     Margin="0"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="VerticalAlignment"
                                Value="Stretch" />
                        <Setter Property="HorizontalAlignment"
                                Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RadarCellBorderStyle}">
                            <TextBlock Text="{Binding Value}"
                                       Style="{StaticResource RadarColumnTextStyle}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <!-- 【只封装列表头模板】 可无限复用 -->
        <DataTemplate x:Key="RadarGen1HeaderTemplate">
            <ItemsControl ItemsSource="{Binding DataContext.FirstRowItems,
        RelativeSource={RelativeSource AncestorType=DataGrid},
        FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                          Padding="0"
                          Margin="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16"
                                     Margin="0"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="VerticalAlignment"
                                Value="Stretch" />
                        <Setter Property="HorizontalAlignment"
                                Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RadarHeaderBorderStyle}">
                            <TextBlock Style="{StaticResource RadarColumnTextStyle}">
                                <TextBlock.Text>
                                    <Binding Path="Id"
                                             StringFormat="ID {0:D2}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Base:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0"
              Background="#0f3460">
            <Grid.Margin>
                <Thickness>8 4</Thickness>
            </Grid.Margin>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="18"
                           Margin="2 5"
                           Text="{StaticResource Network_Title}"
                           FontWeight="Bold"
                           Foreground="#00d9ff"
                           VerticalAlignment="Center" />
                <TextBlock FontSize="18"
                           Margin="2 5"
                           Text="{Binding GenTitle}"
                           FontWeight="Bold"
                           Foreground="#00d9ff"
                           VerticalAlignment="Center" />

            </StackPanel>

            <ToggleButton IsChecked="{Binding IsPaused}"
                          Content="{StaticResource Common_Pause}"
                          Margin="8 4 4 4"
                          Width="120"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Right"
                          Foreground="White"
                          Style="{DynamicResource PurpleToggleSwitch_TextLeft}" />
        </Grid>

        <!-- 主显示区域 -->
        <Border Grid.Row="1"
                Background="#16213e"
                Margin="8 0"
                Visibility="{Binding IsGen1Type,Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid ItemsSource="{Binding Gen1Items}"
                      HorizontalContentAlignment="Left"
                      CanUserAddRows="False"
                      Margin="10 5"
                      Background="#26292d"
                      HorizontalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      RowHeaderWidth="0"
                      VerticalAlignment="Stretch"
                      ColumnHeaderHeight="30"
                      RowHeight="28"
                      RowStyle="{DynamicResource DataGridRowStyle}"
                      AutoGenerateColumns="False"
                      CellStyle="{StaticResource RadarDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANID X/Y"
                                        Binding="{Binding CanId}"
                                        Width="90"
                                        HeaderStyle="{StaticResource RxbitColumnHeaderStyle}"
                                        CellStyle="{StaticResource DGCellStyle}"/>
                    <DataGridTextColumn Header="unit(m)"
                                        Binding="{Binding Unit}"
                                        Width="66"
                                        HeaderStyle="{StaticResource RxbitColumnHeaderStyle}" />
                    <DataGridTemplateColumn Width="*"
                                            CellTemplate="{StaticResource RadarCellTemplate}"
                                            HeaderTemplate="{StaticResource RadarGen1HeaderTemplate}"
                                            HeaderStyle="{StaticResource RadarDataGridColumnHeaderStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="1"
                Visibility="{Binding IsGen1Type,Converter={StaticResource InverseToVisibilityConverter}}"
                Background="#26292d"
                Margin="8 0">
            <DataGrid ItemsSource="{Binding Gen2Items}"
                      HorizontalContentAlignment="Left"
                      CanUserAddRows="False"
                      RowHeaderWidth="0"
                      Margin="10 5"
                      Background="#26292d"
                      HorizontalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      ColumnHeaderHeight="30"
                      VerticalAlignment="Stretch"
                      RowStyle="{DynamicResource DataGridRowStyle}"
                      AutoGenerateColumns="False"
                      RowHeight="28"
                      CellStyle="{StaticResource RadarDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANID X/Y"
                                        HeaderStyle="{StaticResource RxbitColumnHeaderStyle}"
                                        CellStyle="{StaticResource DGCellStyle}"
                                        Binding="{Binding CanId}"
                                        Width="90" />
                    <DataGridTextColumn Header="unit(m)"
                                        Binding="{Binding Unit}"
                                        Width="66"
                                        HeaderStyle="{StaticResource RxbitColumnHeaderStyle}"
                                        CellStyle="{StaticResource DG1CellStyle}" />
                    <DataGridTemplateColumn Width="*"
                                            CellTemplate="{StaticResource RadarCellTemplate}"
                                            HeaderTemplate="{StaticResource RadarGen1HeaderTemplate}"
                                            HeaderStyle="{StaticResource RadarDataGridColumnHeaderStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- 状态栏 -->
        <Grid Grid.Row="2"
              Background="#0f3460"
              Height="40"
              Margin="8 4 8 4">
            <Label Content="Network Summary - All Sensors"
                   VerticalContentAlignment="Center"
                   FontSize="10"
                   Foreground="#00d9ff"
                   Margin="8 2"
                   VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Base:WindowBase>