<UserControl x:Class="Rxbit.BrigadeApp.Views.RadarDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Rxbit.Brigade.Models.Models;assembly=Rxbit.Brigade.Models.Models"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:UI="clr-namespace:Rxbit.BrigadeApp.Views"
             xmlns:Base="clr-namespace:Rxbit.BrigadeApp.Controls"
             xmlns:vm="clr-namespace:Rxbit.BrigadeApp.ViewModels"
             xmlns:controls="clr-namespace:Rxbit.BrigadeApp.Controls"
             DataContext="{Binding Path=RadarDisplayVM,Source={StaticResource Locator}}"
             mc:Ignorable="d"
             Background="#0d0d0d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="#161616"
                BorderBrush="#222"
                BorderThickness="0,0,0,1"
                Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Height="40">
                    <ToggleButton IsChecked="{Binding IsOnLine,Mode=TwoWay}"
                                  Content="{StaticResource Common_OffliceMode}"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Foreground="LightBlue"
                                  FontSize="14"
                                  Margin="20,0,5,0"
                                  IsEnabled="{Binding CanStartRecv}"
                                  Style="{DynamicResource PurpleToggleSwitch_TextLeft}" />
                    <TextBlock Text="{StaticResource Common_OnliceMode}"
                               Foreground="LightBlue"
                               FontSize="14"
                               IsEnabled="{Binding CanStartRecv}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"  Height="40" Grid.Column="1" 
                            IsEnabled="{Binding Path=CanDeviceVM.IsCanConnected,Source={StaticResource Locator}}"
                            Visibility="{Binding IsOnLine,Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Button Content="▶️ REC"
                            Width="76" FontSize="18"
                            IsEnabled="{Binding CanStartRecv}"
                            
                            ToolTip="{StaticResource Common_StartRec}"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding StartCommand}" Margin="20 5 10 5"/>
                    <Button Content="⏹️REC"
                            Width="76" FontSize="18"
                            ToolTip="{StaticResource Common_StopRec}"
                            IsEnabled="{Binding IsRecvi}"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding StopCommand}" Margin="20 5 10 5"/>
                    <StackPanel Orientation="Horizontal" Background="White" Margin="10 5">
                        <TextBox Width="250"
                                 Height="35"
                                 UI:WatermarkHelper.Watermark="{StaticResource Common_IuputFile}"
                                 Text="{Binding RecodingFoder,Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="🛑"
                            Width="36" FontSize="18"
                            ToolTip="{StaticResource Common_StartRecondging}"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding StartRecodingCommand}"
                            IsEnabled="{Binding CanStartRecording}" />
                    <Button Content="⏹"
                            Width="36" FontSize="18"
                            ToolTip="{StaticResource Common_StopRecondging}"
                            Command="{Binding StopRecodingCommand}"
                            IsEnabled="{Binding IsRecoding}"
                            Style="{StaticResource RadarButtonStyle}"/>
                    <TextBlock Text="{Binding RecodingTimeStr,UpdateSourceTrigger=PropertyChanged}"
                               Margin="10 0"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Height="40"
                            Grid.Column="1"
                            Visibility="{Binding IsOnLine,Converter={StaticResource InverseToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Background="White" Margin="10 5">
                        <TextBox Width="250"
                                 Height="35"
                                 IsReadOnly="True"
                                 UI:WatermarkHelper.Watermark="{StaticResource Common_SelectFile}"
                                 Text="{Binding ReplayVM.FileName}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="0"
                                Content="📂"
                                Width="40"
                                FontSize="20"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="5 1 0 1"
                                Padding="3 2"
                                Foreground="Blue"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ReplayVM.SelectFileCommand}"/>
                    </StackPanel>

                    <Button Content="⏮️"
                            ToolTip="Previous frame"
                            Width="36"
                            FontSize="18"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding ReplayVM.PrevFrameCommand}"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}" />

                    <Button Content="⏪️"
                            ToolTip="Rewind 10s"
                            Width="36"
                            FontSize="18"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding ReplayVM.RewindCommand}"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}" />

                    <Button Content="{Binding ReplayVM.PlayPauseButtonText}"
                            ToolTip="Play/Pause"
                            Width="40"
                            FontSize="20"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding ReplayVM.PlayPauseCommand}"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}" />

                    <Button Content="⏩️"
                            ToolTip="Forward 10s"
                            Width="36"
                            FontSize="18"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding ReplayVM.ForwardCommand}"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}" />

                    <Button Content="⏭️"
                            ToolTip="Next frame"
                            Width="36"
                            FontSize="18"
                            Style="{StaticResource RadarButtonStyle}"
                            Command="{Binding ReplayVM.NextFrameCommand}"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}" />

                    <TextBlock Text="{Binding ReplayVM.CurrentDurationStr}" Foreground="White" VerticalAlignment="Center" />
                    <Slider Background="Transparent"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="Green"
                            Width="200"
                            Cursor="Hand"
                            IsEnabled="{Binding ReplayVM.IsFileLoaded}"
                            Value="{Binding ReplayVM.Progress}"
                            Minimum="0"
                            Maximum="100"
                            Margin="5 5"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            LostMouseCapture="ProgressSlider_LostMouseCapture" />
                    <TextBlock Text="{Binding ReplayVM.TotalDurationStr}"
                               Foreground="White"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button Content="{Binding ReplayVM.SpeedButtonText}"
                                Command="{Binding ReplayVM.CycleSpeedCommand}"
                                ToolTip="Click to switch speed (0.5× → 1× → 1.25× → 1.5× → 2× → 3× → 5× → 10×)"
                                Height="30"
                                Width="50"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#ffffff"
                                Background="#533483"
                                BorderBrush="#00d9ff"
                                BorderThickness="1"
                                ClickMode="Release"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SpeedBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,2,0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="SpeedBorder"
                                                    Property="Background"
                                                    Value="#0f3460" />
                                            <Setter Property="Foreground"
                                                    Value="#00d9ff" />
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter TargetName="SpeedBorder"
                                                    Property="Background"
                                                    Value="#00d9ff" />
                                            <Setter Property="Foreground"
                                                    Value="#1a1a2e" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Radar Canvas Area -->
            <Border Grid.Column="1"
                    Background="#0a0a0a"
                    BorderBrush="#1a1a1a"
                    BorderThickness="1"
                    Margin="6">
                <Grid>
                    <!-- 自定义雷达画布 - 全部绑定到ViewModel -->
                    <local:RadarCanvas x:Name="RadarCanvas"
                                       Background="Transparent"
                                       ShowGrid="True"
                                       ShowScanLine="True"
                                       ShowBorder="True"
                                       TargetDefaultSize="14"
                                       TargetSelectedSize="18"
                                       CoordinateSystem="{Binding CoordinateSystem}"
                                       Targets="{Binding Targets}"
                                       ScanAngle="{Binding ScanAngle}"
                                       SelectedTarget="{Binding SelectedTarget}"
                                       SensorID="{Binding Path=SensorConfigVM.CurrSensor.CanID ,Source={StaticResource Locator}}"
                                       TargetSelected="RadarCanvas_TargetSelected"
                                       CoordinateChanged="RadarCanvas_CoordinateChanged"
                                       CanvasZoom="RadarCanvas_CanvasZoom"
                                       HorizontalAlignment="Center"
                                       MinWidth="600"
                                       CanvasDrag="RadarCanvas_CanvasDrag">
                    </local:RadarCanvas>

                    <!-- 左上角信息 -->
                    <StackPanel HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Margin="12,10">
                        <TextBlock Text="{Binding ZoomInfoText}"
                                   Foreground="GreenYellow"
                                   FontSize="10" />
                        <TextBlock Text="{Binding FpsText}"
                                   Foreground="LightGreen"
                                   FontSize="10"
                                   Margin="0,2,0,0" />

                    </StackPanel>

                    <!-- 右下角坐标显示 -->
                    <TextBlock Text="{Binding CoordinateText}"
                               Foreground="LightGray"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,12,8" />
                    <Canvas x:Name="CanvasCorss"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                    <Border BorderBrush="LightGray"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="10 5"
                            VerticalAlignment="Bottom"
                            Margin="10 5">
                        <TextBlock Text="{Binding SelectedTargetInfo}"
                                   Foreground="Yellow"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="20 10"
                            Padding="10 5"
                            BorderBrush="LightGray"
                            BorderThickness="1">
                        <UniformGrid Rows="3"
                                     Columns="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="Green"
                                        Width="10"
                                        Height="10" />
                                <TextBlock Text="Moving"
                                           Margin="10 2"
                                           Foreground="LightGreen" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Background="White"
                                        Width="10"
                                        Height="10" />
                                <TextBlock Text="Static"
                                           Margin="10 2"
                                           Foreground="White" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Background="Yellow"
                                        Width="10"
                                        Height="10" />
                                <TextBlock Text="Selected"
                                           Margin="10 2"
                                           Foreground="Yellow" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- 左侧面板 -->
            <Border  Background="#141e32"
                    BorderBrush="#222"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,6,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#1a1a1a"
                            BorderBrush="#222"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{StaticResource Playback_datas}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{StaticResource Playback_FrameID}"
                                       Foreground="#00bcd4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding FrameId}"
                                       Foreground="#00bcd4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{StaticResource Playback_ObjCount}"
                                       Foreground="#00bcd4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="5 0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding TargetCount}"
                                       Foreground="#00bcd4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="4"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ItemsSource="{Binding RadarTargets}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#0f172a" />
                                <Setter Property="Foreground"
                                        Value="White" />
                                <Setter Property="BorderBrush"
                                        Value="LightGray" />
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1" />
                                <Setter Property="Padding"
                                        Value="5,3" />
                                <Setter Property="FontSize"
                                        Value="11" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height"
                                        Value="30" />
                                <Setter Property="Background"
                                        Value="#26292d" />
                                <Setter Property="Foreground"
                                        Value="White" />
                                <Setter Property="BorderThickness"
                                        Value="0 0 0 1" />
                                <Setter Property="BorderBrush"
                                        Value="#32373b" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="#0c5f66" />
                                        <Setter Property="FontWeight"
                                                Value="Bold" />
                                        <Setter Property="BorderThickness"
                                                Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="50" />
                            <DataGridTextColumn Header="CanID"
                                                Binding="{Binding Status}"
                                                Width="55" />
                            <DataGridTextColumn Header="X(m)"
                                                Binding="{Binding X, StringFormat=F2}"
                                                Width="*" />
                            <DataGridTextColumn Header="Y(m)"
                                                Binding="{Binding Y, StringFormat=F2}"
                                                Width="*" />
                            <DataGridTextColumn Header="Rad(m)"
                                                Binding="{Binding PolarRadius, StringFormat=F2}"
                                                Width="*" />
                            <DataGridTextColumn Header="Angle(°)"
                                                Binding="{Binding PolarAngle, StringFormat=F2}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>