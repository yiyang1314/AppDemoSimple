<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:convertor="clr-namespace:Rxbit.BrigadeApp.Converters">

    <!-- 转换器 -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <convertor:InverseBooleanToVisibilityConverter x:Key="InverseToVisibilityConverter" />
    <convertor:SubMenuOffsetConverter x:Key="SubMenuOffsetConverter" />
    <convertor:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />

    <!-- 菜单下拉面板阴影 -->
    <DropShadowEffect x:Key="MenuPopupShadowEffect"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.55" />

    <!-- 主窗口样式 -->
    <Style x:Key="MainWindowStyle"
           TargetType="{x:Type Window}">
        <Setter Property="Background"
                Value="#1a1a2e" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="BorderBrush"
                Value="#303030" />
        <Setter Property="FontSize"
                Value="12" />
    </Style>

    <!-- 主菜单样式 -->
    <Style x:Key="MainMenuStyle"
           TargetType="{x:Type Menu}">
        <Setter Property="Background"
                Value="#16213e" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Padding"
                Value="20 0 10 0" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="BorderBrush"
                Value="#0f3460" />
        <Setter Property="BorderThickness"
                Value="0 0 0 1" />
    </Style>

    <!-- 顶部菜单项样式 -->
    <Style x:Key="MenuItemStyle"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="Padding"
                Value="10 5 12 5" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="MinWidth"
                Value="60" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <Path Grid.Column="1"
                                      x:Name="Arrow"
                                      Width="6"
                                      Height="4"
                                      Data="M0,0 L4,3 L8,0 Z"
                                      Fill="#93a4b8"
                                      Margin="6 0 0 0"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 二级菜单 Popup -->
                        <Popup x:Name="SubMenuPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               VerticalOffset="1"
                               IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                           <Popup.HorizontalOffset>
                                <MultiBinding Converter="{StaticResource SubMenuOffsetConverter}">
                                    <Binding Path="ActualWidth"
                                             ElementName="SubMenuBorder" />
                                    <Binding Path="ActualWidth"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Popup.HorizontalOffset>
                            <Border x:Name="SubMenuBorder"
                                    Background="#1f1f2e"
                                    BorderBrush="#2f6f8f"
                                    BorderThickness="1"
                                    MinWidth="190"
                                    CornerRadius="3"
                                    Effect="{StaticResource MenuPopupShadowEffect}">
                                <StackPanel IsItemsHost="True"
                                            Background="Transparent"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Margin="2" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Role"
                                 Value="TopLevelHeader">
                            <Setter TargetName="Arrow"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="MenuItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen"
                                 Value="True">
                            <Setter TargetName="MenuItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="#6b7280" />
                            <Setter TargetName="Arrow"
                                    Property="Fill"
                                    Value="#4b5563" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 子菜单项样式 -->
    <Style x:Key="SubMenuItemStyle"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="Padding"
                Value="6 5 10 5" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="MinWidth"
                Value="170" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid FlowDirection="LeftToRight">
                        <Border x:Name="SubMenuItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 勾选标记 -->
                                <Path x:Name="CheckMark"
                                      Grid.Column="0"
                                      Width="9"
                                      Height="8"
                                      Data="M0,4 L3.5,7.5 L9,0"
                                      Stroke="#00d9ff"
                                      StrokeThickness="1.4"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!-- 菜单项文本 -->
                                <ContentPresenter Grid.Column="1"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <!-- 快捷键提示 -->
                                <TextBlock x:Name="ShortcutText"
                                           Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#6b8fa8"
                                           Margin="28 0 6 0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                                <!-- 三级子菜单箭头 -->
                                <Path x:Name="Arrow"
                                      Grid.Column="3"
                                      Width="5"
                                      Height="5"
                                      Data="M0,0 L6,0 L3,3 Z"
                                      Fill="#00d9ff"
                                      Margin="6 0 0 0"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 三级子菜单 Popup -->
                        <Popup x:Name="SubMenuPopup"
                               Placement="Right"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="0"
                               VerticalOffset="-3"
                               IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Background="#1f1f2e"
                                    BorderBrush="#2f6f8f"
                                    BorderThickness="1"
                                    MinWidth="190"
                                    CornerRadius="3"
                                    Effect="{StaticResource MenuPopupShadowEffect}">
                                <StackPanel IsItemsHost="True"
                                            Background="Transparent"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Margin="2" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Role"
                                 Value="SubmenuHeader">
                            <Setter TargetName="Arrow"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="ShortcutText"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="SubMenuItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen"
                                 Value="True">
                            <Setter TargetName="SubMenuItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="SubMenuItemBorder"
                                    Property="Opacity"
                                    Value="0.5" />
                            <Setter Property="Foreground"
                                    Value="#6b7280" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 阴影效果 -->
    <DropShadowEffect x:Key="DropShadowEffect"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Color="#00d9ff"
                      Opacity="0.3" />

    <!-- 分隔线样式 -->
    <Style x:Key="SeparatorStyle"
           TargetType="{x:Type Separator}">
        <Setter Property="Background"
                Value="#00d9ff" />
        <Setter Property="Height"
                Value="1" />
        <Setter Property="Margin"
                Value="12 4 12 4" />
        <Setter Property="Opacity"
                Value="0.3" />
    </Style>

    <!-- 下拉菜单分隔线样式（暗色面板内，不使用系统默认浅色分隔块） -->
    <Style x:Key="SubMenuSeparatorStyle"
           TargetType="{x:Type Separator}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Height"
                Value="9" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Rectangle Height="1"
                                   Margin="12 0"
                                   VerticalAlignment="Center"
                                   Fill="#2f4f7f"
                                   Opacity="0.9" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签样式 -->
    <Style x:Key="LabelStyle"
           TargetType="{x:Type Label}">
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!-- 组合框样式（暗色主题） -->
    <Style x:Key="SensorComboBoxStyle"
           TargetType="{x:Type ComboBox}">
        <Setter Property="Background"
                Value="#16213e" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="BorderBrush"
                Value="#2f4f7f" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Width"
                Value="150" />
        <Setter Property="Height"
                Value="24" />
        <Setter Property="Padding"
                Value="6" />
        <Setter Property="ItemContainerStyle"
                Value="{DynamicResource ComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />

                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />

                        <Path x:Name="Arrow"
                              Data="M0,0 L4,5 L8,0 Z"
                              Fill="#93a4b8"
                              Width="8"
                              Height="5"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0 0 8 0" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               VerticalOffset="1"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Popup.HorizontalOffset>
                                <MultiBinding Converter="{StaticResource SubMenuOffsetConverter}">
                                    <Binding Path="ActualWidth"
                                             ElementName="DropDownBorder" />
                                    <Binding Path="ActualWidth"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Popup.HorizontalOffset>
                            <Border x:Name="DropDownBorder"
                                    Background="#1f1f2e"
                                    BorderBrush="#2f6f8f"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{StaticResource MenuPopupShadowEffect}">
                                <ScrollViewer SnapsToDevicePixels="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                Margin="2" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="MainBorder"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 组合框项样式 -->
    <Style x:Key="ComboBoxItemStyle"
           TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="Padding"
                Value="6 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#0f3460" />
                            <Setter Property="Foreground"
                                    Value="#00d9ff" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按钮样式 -->
    <Style x:Key="ButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="#1a1a2e" />
        <Setter Property="Foreground"
                Value="#00d9ff" />
        <Setter Property="BorderBrush"
                Value="#00d9ff" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Padding"
                Value="12 6" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#00d9ff" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#00d9ff" />
                            <Setter Property="Foreground"
                                    Value="#1a1a2e" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#00b8e6" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#00b8e6" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#2a2a3e" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#4a4a5e" />
                            <Setter Property="Foreground"
                                    Value="#6a6a7e" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮样式 -->
    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background"
                Value="#00d9ff" />
        <Setter Property="Foreground"
                Value="#1a1a2e" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="BorderBrush"
                Value="#00d9ff" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#00b8e6" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#00b8e6" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#00a0cc" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#00a0cc" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton 样式 -->
    <Style x:Key="ToggleButtonStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Background"
                Value="#1a1a2e" />
        <Setter Property="Foreground"
                Value="#e4e4e4" />
        <Setter Property="BorderBrush"
                Value="#00d9ff" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Padding"
                Value="12 6" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#00d9ff" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#00d9ff" />
                            <Setter Property="Foreground"
                                    Value="#1a1a2e" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Border"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#00d9ff"
                                                        Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#2a2a3e" />
                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#4a4a5e" />
                            <Setter Property="Foreground"
                                    Value="#6a6a7e" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TextToggleStyle"
           TargetType="ToggleButton">
        <Setter Property="Width"
                Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Back"
                            CornerRadius="4"
                            Background="#ddd">
                        <TextBlock x:Name="Txt"
                                   Text="关闭"
                                   Foreground="#333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Back"
                                    Property="Background"
                                    Value="#007bff" />
                            <Setter TargetName="Txt"
                                    Property="Text"
                                    Value="开启" />
                            <Setter TargetName="Txt"
                                    Property="Foreground"
                                    Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 自定义滑动Toggle开关样式 Key=SlideToggleStyle -->
    <Style x:Key="SlideToggleStyle"
           TargetType="ToggleButton">
        <Setter Property="Width"
                Value="60" />
        <Setter Property="Height"
                Value="30" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="暂停："
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <!-- 背景轨道 -->
                        <Border x:Name="Track"
                                Grid.Column="1"
                                CornerRadius="15"
                                Background="Blue">
                        </Border>
                        <!-- 圆形滑块 -->
                        <Ellipse x:Name="Thumb"
                                 Grid.Column="1"
                                 Width="24"
                                 Height="24"
                                 Fill="Green"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0" />
                    </Grid>

                    <!-- 选中/未选中 视觉状态 -->
                    <ControlTemplate.Triggers>
                        <!-- 选中开启状态 -->
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Track"
                                    Property="Background"
                                    Value="#28a745" />
                            <Setter TargetName="Thumb"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter TargetName="Thumb"
                                    Property="Margin"
                                    Value="0,0,3,0" />
                        </Trigger>
                        <!-- 禁用状态 -->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Track"
                                    Property="Opacity"
                                    Value="0.5" />
