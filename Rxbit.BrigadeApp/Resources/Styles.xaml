    <Style x:Key="PurpleToggleSwitch"
           TargetType="ToggleButton">
        <Setter Property="Width"
                Value="80" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 虚线外框容器 -->
                    <Border BorderBrush="#888888"
                            BorderThickness="1"
                            Padding="4">
                        <Grid ClipToBounds="True">
                            <!-- 开关轨道背景 -->
                            <Border x:Name="Track"
                                    CornerRadius="18"
                                    Background="#E9DFF5"
                                    Width="72"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            <!-- 圆形滑块 -->
                            <Ellipse x:Name="Thumb"
                                     Fill="#9944CC"
                                     Width="26"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate"
                                                        X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- 切换动画触发器 -->
                    <ControlTemplate.Triggers>
                        <!-- 选中状态：滑块右移 -->
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="44"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 鼠标悬浮微调 -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Track"
                                    Property="Opacity"
                                    Value="0.9" />
                        </Trigger>
                        <!-- 禁用状态置灰 -->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Track"
                                    Property="Background"
                                    Value="#CCCCCC" />
                            <Setter TargetName="Thumb"
                                    Property="Fill"
                                    Value="#888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
