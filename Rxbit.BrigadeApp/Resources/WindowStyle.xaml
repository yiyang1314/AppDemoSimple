<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Controls="clr-namespace:Rxbit.BrigadeApp.Controls">
    <!-- 全局统一Window模板：应用于WindowBase及其派生类 -->
    <Style TargetType="Controls:WindowBase">
        <Setter Property="Background"
                Value="#121212" />
        <Setter Property="Foreground"
                Value="#EEEEEE" />
        <Setter Property="MinWidth"
                Value="800" />
        <Setter Property="MinHeight"
                Value="600" />

        <!-- 自定义 WindowChrome 标题栏配置 -->
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="36"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              UseAeroCaptionButtons="False"
                              NonClientFrameEdges="None"
                              CornerRadius="0" />
            </Setter.Value>
        </Setter>

        <Setter Property="WindowStyle"
                Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Controls:WindowBase">
                    <Border BorderBrush="#16191b"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 全局统一标题栏模板 -->
                            <Grid x:Name="TitleBar"
                                  Grid.Row="0"
                                  Background="#1E1E1E"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid.Cursor>
                                    <Cursor>Hand</Cursor>
                                </Grid.Cursor>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 标题栏背景渐变 -->
                                <Rectangle Grid.ColumnSpan="3">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#252525"
                                                          Offset="0" />
                                            <GradientStop Color="#1E1E1E"
                                                          Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- 图标+标题 -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                    <!--<Rectangle Width="20" Height="20" Fill="#4FD1DE" RadiusX="4" RadiusY="4" />-->

                                    <Border Margin="10 0"
                                            ClipToBounds="True"
                                            Background="White"
                                            Width="150">
                                        <Image Source="/Resources/LOGO.png"
                                               Margin="5 0" />
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               VerticalAlignment="Center"
                                               Foreground="#4FD1DE"
                                               Margin="10,0,0,0"
                                               FontSize="14"
                                               FontWeight="Medium" />
                                </StackPanel>

                                <!-- 窗口控制按钮 -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">
                                    <!-- 最小化按钮 -->
                                    <Button x:Name="BtnMin"
                                            Width="45"
                                            Height="36"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground"
                                                        Value="#CCCCCC" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="{TemplateBinding Background}"
                                                                  Width="10"
                                                                  Height="10">
                                                                <Rectangle Fill="{TemplateBinding Foreground}"
                                                                           Height="2"
                                                                           Width="10"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#333333" />
                                                                    <Setter Property="Foreground"
                                                                            Value="#FFFFFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 最大化按钮 -->
                                    <Button x:Name="BtnMax"
                                            Width="45"
                                            Height="36"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Tag="Maximized">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground"
                                                        Value="#CCCCCC" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="{TemplateBinding Background}"
                                                                  Width="10"
                                                                  Height="10">
                                                                <!-- 最大化图标 - 方形 -->
                                                                <Rectangle x:Name="MaxPathNormal"
                                                                           Stroke="{TemplateBinding Foreground}"
                                                                           Fill="{x:Null}"
                                                                           StrokeThickness="2"
                                                                           Width="10"
                                                                           Height="10" />
                                                                <!-- 还原图标 - 两个重叠的方形 -->
                                                                <Grid x:Name="MaxPathRestored"
                                                                      Visibility="Collapsed">
                                                                    <Rectangle Stroke="{TemplateBinding Foreground}"
                                                                               Fill="{x:Null}"
                                                                               StrokeThickness="2"
                                                                               Width="10"
                                                                               Height="10" />
                                                                    <Rectangle Stroke="{TemplateBinding Foreground}"
                                                                               Fill="{x:Null}"
                                                                               StrokeThickness="2"
                                                                               Width="6"
                                                                               Height="6"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Bottom" />
                                                                </Grid>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#333333" />
                                                                    <Setter Property="Foreground"
                                                                            Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="Tag"
                                                                         Value="Restored">
                                                                    <Setter TargetName="MaxPathNormal"
                                                                            Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    <Setter TargetName="MaxPathRestored"
                                                                            Property="Visibility"
                                                                            Value="Visible" />
                                                                </Trigger>
                                                                <Trigger Property="Tag"
                                                                         Value="Maximized">
                                                                    <Setter TargetName="MaxPathNormal"
                                                                            Property="Visibility"
                                                                            Value="Visible" />
                                                                    <Setter TargetName="MaxPathRestored"
                                                                            Property="Visibility"
                                                                            Value="Collapsed" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 关闭按钮 -->
                                    <Button x:Name="BtnClose"
                                            Width="45"
                                            Height="36"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground"
                                                        Value="#FF6363" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="{TemplateBinding Background}"
                                                                  Width="10"
                                                                  Height="10">
                                                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                                                      Stroke="{TemplateBinding Foreground}"
                                                                      StrokeThickness="2"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#E53935" />
                                                                    <Setter Property="Foreground"
                                                                            Value="#FFFFFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ContentPresenter Grid.Row="1"
                                              Margin="4" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState"
                                 Value="Maximized">
                            <Setter TargetName="BtnMax"
                                    Property="Tag"
                                    Value="Restored" />
                        </Trigger>
                        <Trigger Property="WindowState"
                                 Value="Normal">
                            <Setter TargetName="BtnMax"
                                    Property="Tag"
                                    Value="Maximized" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 全局窗口样式 纯原生无第三方、无非法属性、无不存在控件 -->
    <Style TargetType="Window"
           x:Key="ghhh">
        <Setter Property="WindowStyle"
                Value="None" />
        <Setter Property="Background"
                Value="#673ab7" />
        <Setter Property="Foreground"
                Value="#EEEEEE" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="#333333" />
        <Setter Property="MinWidth"
                Value="800" />
        <Setter Property="MinHeight"
                Value="600" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid x:Name="RootGrid">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 标题栏：移除所有事件绑定，后台代码统一挂载 -->
                            <Grid x:Name="TitleBarGrid"
                                  Grid.Row="0"
                                  Background="#1E1E1E">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 图标+标题 -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0">
                                    <Image Width="20"
                                           Height="20"
                                           Source="pack://application:,,,/Resources/app_icon.png" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="#4FD1DE">
                                        <Run Text="{TemplateBinding Title}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- 窗口三按钮：删除Click="" 后台绑定 -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">
                                    <Button x:Name="BtnMin"
                                            Width="40"
                                            Height="36"
                                            Background="Transparent"
                                            Foreground="#CCCCCC"
                                            BorderThickness="0">
                                        <!-- 修复Stroke非法值CurrentColor -->
                                        <Path Data="M0,4 L12,4 M0,8 L12,8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" />
                                    </Button>
                                    <Button x:Name="BtnMax"
                                            Width="40"
                                            Height="36"
                                            Background="Transparent"
                                            Foreground="#CCCCCC"
                                            BorderThickness="0">
                                        <!-- 修复Fill=None → Fill={x:Null} -->
                                        <Path x:Name="MaxPath"
                                              Data="M2,2 L10,2 L10,10 L2,10 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              Fill="{x:Null}" />
                                    </Button>
                                    <Button x:Name="BtnClose"
                                            Width="40"
                                            Height="36"
                                            Background="Transparent"
                                            Foreground="#FF6060"
                                            BorderThickness="0">
                                        <Path Data="M2,2 L10,10 M10,2 L2,10"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 页面内容 -->
                            <ContentPresenter Grid.Row="1"
                                              Margin="4" />
                        </Grid>

                        <!-- 原生四边四角缩放Thumb，彻底删掉WindowResizeThumb -->
                        <Thumb x:Name="ResizeLeft"
                               HorizontalAlignment="Left"
                               Width="6"
                               Cursor="SizeWE" />
                        <Thumb x:Name="ResizeRight"
                               HorizontalAlignment="Right"
                               Width="6"
                               Cursor="SizeWE" />
                        <Thumb x:Name="ResizeTop"
                               VerticalAlignment="Top"
                               Height="6"
                               Cursor="SizeNS" />
                        <Thumb x:Name="ResizeBottom"
                               VerticalAlignment="Bottom"
                               Height="6"
                               Cursor="SizeNS" />

                        <Thumb x:Name="ResizeTopLeft"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Width="6"
                               Height="6"
                               Cursor="SizeNWSE" />
                        <Thumb x:Name="ResizeTopRight"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Width="6"
                               Height="6"
                               Cursor="SizeNESW" />
                        <Thumb x:Name="ResizeBottomLeft"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Width="6"
                               Height="6"
                               Cursor="SizeNESW" />
                        <Thumb x:Name="ResizeBottomRight"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Width="6"
                               Height="6"
                               Cursor="SizeNWSE" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState"
                                 Value="Maximized">
                            <Setter TargetName="MaxPath"
                                    Property="Data"
                                    Value="M3,3 L9,3 L9,9 L3,9 Z M5,5 L11,5 L11,11 L5,11 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>