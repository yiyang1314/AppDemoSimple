<UserControl x:Class="Rxbit.BrigadeApp.Controls.RecordButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Rxbit.BrigadeApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- 底层深色外圈背景 -->
        <Ellipse Fill="#2A2A2A" Width="120" Height="120"/>

        <!-- 录制绿色环形进度条 -->
        <Path x:Name="ProgressRing" Visibility="Collapsed" StrokeThickness="6">
            <Path.Stroke>
                <SolidColorBrush Color="{Binding ProgressColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Path.Stroke>
            <Path.Fill>Transparent</Path.Fill>
            <Path.Data>
                <PathGeometry>
                    <PathFigure x:Name="ProgressFigure" StartPoint="60, 10" IsClosed="False">
                        <ArcSegment x:Name="ProgressArc" Size="50,50" SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- 紫色主体圆盘 -->
        <Ellipse Width="100" Height="100" Margin="10"
                 Fill="{Binding MainColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- 待机：中心白色圆点 -->
        <Ellipse x:Name="IdleDot" Width="36" Height="36" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 录制中：双层同心圆 -->
        <Grid x:Name="RecordingRing" Visibility="Collapsed" Width="100" Height="100" Margin="10">
            <Ellipse Width="62" Height="62" Stroke="White" StrokeThickness="4" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
