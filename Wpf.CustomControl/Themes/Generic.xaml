<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:Wpf.CustomControl.Icons"
                    xmlns:conv="clr-namespace:Wpf.CustomControl.Converters"
                    xmlns:win="clr-namespace:Wpf.CustomControl.Windowing">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Wpf.CustomControl;component/Icons/IconResources.xaml" />
        <ResourceDictionary Source="/Wpf.CustomControl;component/Windowing/CustomWindow.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- BoolToVisibilityConverter 注册 -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- IconElement 默认样式 -->
    <Style TargetType="{x:Type icons:IconElement}">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icons:IconElement}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
