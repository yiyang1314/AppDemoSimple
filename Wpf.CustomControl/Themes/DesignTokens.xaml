<!--
    Brigade 统一设计令牌（配色 / 字号 / 间距 / 圆角 / 阴影）
    仅包含颜色、字体、尺寸等基础资源，不含任何自定义控件类型，
    因此可被 net48 与 net9.0-windows 工程共同引用（Brigade.VideoPlayer 采用链接方式编译）。
    使用顺序：先合并本字典，再合并 ControlStyles.xaml。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========== 主色板：深色工业风 ========== -->
    <Color x:Key="DsBgColor">#12141A</Color>
    <Color x:Key="DsSurfaceColor">#1A1D25</Color>
    <Color x:Key="DsSurfaceAltColor">#22262F</Color>
    <Color x:Key="DsSurfaceHoverColor">#2A2F3A</Color>
    <Color x:Key="DsBorderColor">#2E3440</Color>
    <Color x:Key="DsBorderStrongColor">#3D4454</Color>

    <Color x:Key="DsTextPrimaryColor">#E6EAF2</Color>
    <Color x:Key="DsTextSecondaryColor">#A7B0C0</Color>
    <Color x:Key="DsTextMutedColor">#6F7A8C</Color>
    <Color x:Key="DsTextDisabledColor">#58606E</Color>

    <Color x:Key="DsAccentColor">#4FD1DE</Color>
    <Color x:Key="DsAccentHoverColor">#6BE3EE</Color>
    <Color x:Key="DsAccentPressedColor">#35B7C4</Color>
    <Color x:Key="DsSelectionColor">#1E3D4A</Color>

    <Color x:Key="DsSuccessColor">#34C759</Color>
    <Color x:Key="DsWarningColor">#F5A524</Color>
    <Color x:Key="DsErrorColor">#FF5B5B</Color>
    <Color x:Key="DsErrorHoverColor">#FF7A7A</Color>

    <!-- ========== 画刷 ========== -->
    <SolidColorBrush x:Key="DsBgBrush" Color="{StaticResource DsBgColor}" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="{StaticResource DsSurfaceColor}" />
    <SolidColorBrush x:Key="DsSurfaceAltBrush" Color="{StaticResource DsSurfaceAltColor}" />
    <SolidColorBrush x:Key="DsSurfaceHoverBrush" Color="{StaticResource DsSurfaceHoverColor}" />
    <SolidColorBrush x:Key="DsBorderBrush" Color="{StaticResource DsBorderColor}" />
    <SolidColorBrush x:Key="DsBorderStrongBrush" Color="{StaticResource DsBorderStrongColor}" />

    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="{StaticResource DsTextPrimaryColor}" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="{StaticResource DsTextSecondaryColor}" />
    <SolidColorBrush x:Key="DsTextMutedBrush" Color="{StaticResource DsTextMutedColor}" />
    <SolidColorBrush x:Key="DsTextDisabledBrush" Color="{StaticResource DsTextDisabledColor}" />

    <SolidColorBrush x:Key="DsAccentBrush" Color="{StaticResource DsAccentColor}" />
    <SolidColorBrush x:Key="DsAccentHoverBrush" Color="{StaticResource DsAccentHoverColor}" />
    <SolidColorBrush x:Key="DsAccentPressedBrush" Color="{StaticResource DsAccentPressedColor}" />
    <SolidColorBrush x:Key="DsAccentSoftBrush" Color="#264FD1DE" />
    <SolidColorBrush x:Key="DsSelectionBrush" Color="{StaticResource DsSelectionColor}" />

    <SolidColorBrush x:Key="DsSuccessBrush" Color="{StaticResource DsSuccessColor}" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="{StaticResource DsWarningColor}" />
    <SolidColorBrush x:Key="DsErrorBrush" Color="{StaticResource DsErrorColor}" />
    <SolidColorBrush x:Key="DsTransparentBrush" Color="Transparent" />

    <!-- 标题栏渐变 -->
    <LinearGradientBrush x:Key="DsTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#242936" Offset="0" />
        <GradientStop Color="#1A1D25" Offset="1" />
    </LinearGradientBrush>

    <!-- ========== 字体与字号 ========== -->
    <FontFamily x:Key="DsFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
    <sys:Double x:Key="DsFontSizeCaption">11</sys:Double>
    <sys:Double x:Key="DsFontSizeBody">13</sys:Double>
    <sys:Double x:Key="DsFontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="DsFontSizeH2">16</sys:Double>
    <sys:Double x:Key="DsFontSizeH1">18</sys:Double>
    <sys:Double x:Key="DsFontSizeDisplay">24</sys:Double>

    <!-- ========== 间距 ========== -->
    <Thickness x:Key="DsSpaceXSmall">4</Thickness>
    <Thickness x:Key="DsSpaceSmall">8</Thickness>
    <Thickness x:Key="DsSpaceMedium">12</Thickness>
    <Thickness x:Key="DsSpaceLarge">16</Thickness>
    <Thickness x:Key="DsSpaceXLarge">24</Thickness>
    <Thickness x:Key="DsControlPadding">12,6</Thickness>
    <Thickness x:Key="DsCardPadding">16</Thickness>
    <Thickness x:Key="DsPagePadding">16</Thickness>
    <Thickness x:Key="DsToolBarPadding">12,8</Thickness>

    <sys:Double x:Key="DsControlHeight">32</sys:Double>
    <sys:Double x:Key="DsRowHeight">30</sys:Double>
    <sys:Double x:Key="DsIconSize">16</sys:Double>
    <sys:Double x:Key="DsScrollBarWidth">10</sys:Double>

    <!-- ========== 圆角 ========== -->
    <CornerRadius x:Key="DsRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="DsRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="DsRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="DsRadiusPill">16</CornerRadius>

    <!-- ========== 阴影 ========== -->
    <DropShadowEffect x:Key="DsShadowEffect"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.45"
                      Color="#000000" />
    <DropShadowEffect x:Key="DsShadowLightEffect"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.28"
                      Color="#000000" />

    <!-- ========== 通用文本与容器样式 ========== -->
    <Style x:Key="DsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DsCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DsHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DsRadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource DsCardPadding}" />
    </Style>

    <Style x:Key="DsSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DsRadiusCard}" />
    </Style>

    <Style x:Key="DsToolBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource DsToolBarPadding}" />
    </Style>

    <Style x:Key="DsStatusBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- 无数据 / 空状态 -->
    <Style x:Key="DsEmptyStateBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DsRadiusControl}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="DsEmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DsHintTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeBodyLarge}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
    </Style>

    <!-- 侧边导航 -->
    <Style x:Key="DsSidebarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="DsNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeBody}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource DsRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DsSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DsTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DsTextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource DsNavButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource DsAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource DsSelectionBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 状态徽标 -->
    <Style x:Key="DsBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DsAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DsRadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DsBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DsFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource DsAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
