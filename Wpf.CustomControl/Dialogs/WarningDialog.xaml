<Window x:Class="Wpf.CustomControl.Dialogs.WarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="警告" Height="200" Width="380"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border Style="{StaticResource DialogRootStyle}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{StaticResource DialogWarningBrush}" Margin="0,0,12,0">
                        <TextBlock Text="!" FontSize="26" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="警告" FontSize="16" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource DialogTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TxtContent" Grid.Row="1" Text="操作可能存在风险，请确认。"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource DialogTextSecondaryBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Margin="0,0,0,16" TextAlignment="Center" />

                <Button Grid.Row="2" Content="知道了"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Click="BtnConfirm_Click" Width="100" HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
