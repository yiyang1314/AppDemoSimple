<Window x:Class="Wpf.CustomControl.Dialogs.TipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Height="120" Width="320"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border Style="{StaticResource DialogRootStyle}">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource DialogPrimaryBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="i" FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="提示信息"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource DialogTextPrimaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
