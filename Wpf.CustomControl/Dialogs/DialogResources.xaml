<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 对话框画刷（自包含，不依赖外部主题） -->
    <Color x:Key="DialogBackgroundColor">#FF1A1D25</Color>
    <Color x:Key="DialogBorderColor">#FF2E3440</Color>
    <Color x:Key="DialogTextPrimaryColor">#FFE6EAF2</Color>
    <Color x:Key="DialogTextSecondaryColor">#FFA7B0C0</Color>
    <Color x:Key="DialogPrimaryColor">#FF4FD1DE</Color>
    <Color x:Key="DialogDangerColor">#FFFF5B5B</Color>
    <Color x:Key="DialogWarningColor">#FFF5A524</Color>
    <Color x:Key="DialogSuccessColor">#FF34C759</Color>
    <Color x:Key="DialogInputBackgroundColor">#FF22262F</Color>

    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{StaticResource DialogBackgroundColor}" />
    <SolidColorBrush x:Key="DialogBorderBrush" Color="{StaticResource DialogBorderColor}" />
    <SolidColorBrush x:Key="DialogTextPrimaryBrush" Color="{StaticResource DialogTextPrimaryColor}" />
    <SolidColorBrush x:Key="DialogTextSecondaryBrush" Color="{StaticResource DialogTextSecondaryColor}" />
    <SolidColorBrush x:Key="DialogPrimaryBrush" Color="{StaticResource DialogPrimaryColor}" />
    <SolidColorBrush x:Key="DialogDangerBrush" Color="{StaticResource DialogDangerColor}" />
    <SolidColorBrush x:Key="DialogWarningBrush" Color="{StaticResource DialogWarningColor}" />
    <SolidColorBrush x:Key="DialogSuccessBrush" Color="{StaticResource DialogSuccessColor}" />
    <SolidColorBrush x:Key="DialogInputBackgroundBrush" Color="{StaticResource DialogInputBackgroundColor}" />

    <!-- 阴影效果 -->
    <DropShadowEffect x:Key="DialogDropShadowEffect"
                      Color="Black"
                      BlurRadius="20"
                      ShadowDepth="0"
                      Opacity="0.5" />

    <!-- 主按钮样式（蓝底白字） -->
    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}" />
        <Setter Property="Foreground" Value="#0E1116" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮样式（透明底） -->
    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#334155" />
                            <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮样式（红底白字） -->
    <Style x:Key="DialogDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DialogDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框样式 -->
    <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DialogInputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="CaretBrush" Value="{StaticResource DialogTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 对话框根容器样式（圆角 + 边框 + 阴影） -->
    <Style x:Key="DialogRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DialogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect" Value="{StaticResource DialogDropShadowEffect}" />
    </Style>

</ResourceDictionary>
