<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Rxbit.BrigadeApp"
           Manufacturer="Brigade"
           Version="1.5.0"
           UpgradeCode="6F3D8E2A-9C41-4B7E-8D15-2A5F7C9E1B34"
           Language="1033"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Backsense BS-9200X Test Tool"
                        Manufacturer="Brigade" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Rxbit.BrigadeApp is already installed. Please uninstall it first." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\Rxbit.BrigadeApp\favico.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Requires .NET Framework 4.8: MsiNetAssemblySupport reports the installed CLR version (e.g. 4.8.10001.0). -->
    <Launch Condition="Installed OR MsiNetAssemblySupport &gt;= 4.8"
            Message="Rxbit.BrigadeApp requires .NET Framework 4.8. Please install .NET Framework 4.8 and run the setup again." />


    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CompanyFolder" Name="Brigade">
        <Directory Id="INSTALLDIR" Name="Rxbit.BrigadeApp" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Rxbit.BrigadeApp" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

  </Package>

  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ApplicationShortcuts" Guid="A1B2C3D4-5E6F-4A7B-8C9D-0E1F2A3B4C5D">
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="Rxbit.BrigadeApp"
                  Description="Backsense BS-9200X Test Tool"
                  Target="[INSTALLDIR]Rxbit.BrigadeApp.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Rxbit.BrigadeApp"
                  Description="Backsense BS-9200X Test Tool"
                  Target="[INSTALLDIR]Rxbit.BrigadeApp.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Brigade\Rxbit.BrigadeApp"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

</Wix>
