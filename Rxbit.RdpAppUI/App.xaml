<Application x:Class="Rxbit.RdpAppUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Rxbit.RdpAppUI"
             xmlns:helpers="clr-namespace:Rxbit.RdpAppUI.Convertors"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:ConnectionStatusConverter x:Key="ConnectionStatusConverter"/>
            <helpers:ConnectionTextConverter x:Key="ConnectionTextConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Wpf.CustomControl;component/Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="/Wpf.CustomControl;component/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
