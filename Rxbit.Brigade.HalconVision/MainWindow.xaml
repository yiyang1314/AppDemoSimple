<Window x:Class="Rxbit.Brigade.HalconVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Rxbit.Brigade.HalconVision.Views"
        xmlns:vm="clr-namespace:Rxbit.Brigade.HalconVision.ViewModels"
        Title="MVTec HALCON HDevelop" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource DsFontFamily}"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F0F0F0" />

        <Style x:Key="MenuBarItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Data="M0,0 L0,6 L6,0" HorizontalAlignment="Right" Margin="4,0,0,0" VerticalAlignment="Center" Fill="#666" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubMenuItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="#F5F5F5" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="4,2">
            <MenuItem Header="文件(F)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="新建图形窗口" Click="NewGraphicsWindow_Click" InputGestureText="Ctrl+N" />
                <MenuItem Header="新建程序窗口" Click="NewProgramWindow_Click" />
                <MenuItem Header="新建变量窗口" Click="NewVariablesWindow_Click" />
                <Separator />
                <MenuItem Header="打开..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="SaveFile_Click" />
                <MenuItem Header="另存为..." Click="SaveAsFile_Click" />
                <Separator />
                <MenuItem Header="导出" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="编辑(E)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="剪切" InputGestureText="Ctrl+X" />
                <MenuItem Header="复制" InputGestureText="Ctrl+C" />
                <MenuItem Header="粘贴" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="查找和替换" InputGestureText="Ctrl+H" />
                <Separator />
                <MenuItem Header="首选项" />
            </MenuItem>
            <MenuItem Header="执行(R)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="运行程序" InputGestureText="F5" Click="RunProgram_Click" />
                <MenuItem Header="单步执行(进入)" InputGestureText="F11" />
                <MenuItem Header="单步执行(跳过)" InputGestureText="F10" />
                <MenuItem Header="单步执行(跳出)" InputGestureText="Shift+F11" />
                <Separator />
                <MenuItem Header="停止执行" InputGestureText="Shift+F5" />
                <MenuItem Header="重新编译" InputGestureText="Ctrl+F5" />
                <Separator />
                <MenuItem Header="设置运行参数" />
            </MenuItem>
            <MenuItem Header="可视化(V)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="放大" InputGestureText="Ctrl++" />
                <MenuItem Header="缩小" InputGestureText="Ctrl+-" />
                <MenuItem Header="适合窗口" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="1:1 显示" InputGestureText="Ctrl+1" />
                <Separator />
                <MenuItem Header="显示网格" />
                <MenuItem Header="显示比例尺" />
                <MenuItem Header="显示ROI" />
            </MenuItem>
            <MenuItem Header="函数(P)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="函数浏览器" Click="OpenFunctionBrowser_Click" />
                <MenuItem Header="算子" />
                <Separator />
                <MenuItem Header="导入函数" />
                <MenuItem Header="导出函数" />
            </MenuItem>
            <MenuItem Header="助手(A)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="HALCON 文档" InputGestureText="F1" />
                <MenuItem Header="示例程序" />
                <MenuItem Header="HALCON 帮助中心" />
                <Separator />
                <MenuItem Header="检查更新" />
            </MenuItem>
            <MenuItem Header="窗口(W)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="新建图形窗口" Click="NewGraphicsWindow_Click" />
                <MenuItem Header="新建程序窗口" Click="NewProgramWindow_Click" />
                <MenuItem Header="新建变量窗口" Click="NewVariablesWindow_Click" />
                <Separator />
                <MenuItem Header="层叠窗口" />
                <MenuItem Header="平铺窗口" />
                <MenuItem Header="排列图标" />
                <Separator />
                <MenuItem Header="关闭当前窗口" Click="CloseCurrentWindow_Click" />
                <MenuItem Header="关闭全部窗口" Click="CloseAllWindows_Click" />
                <Separator />
                <MenuItem Header="重置窗口布局" Click="ResetLayout_Click" />
            </MenuItem>
            <MenuItem Header="帮助(H)" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="目录" InputGestureText="F1" />
                <MenuItem Header="索引" />
                <MenuItem Header="搜索" />
                <Separator />
                <MenuItem Header="关于 HALCON" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="1" Background="#F5F5F5" Height="36" ToolBarTray.IsLocked="True" x:Name="MainToolBar">
            <Button Content="▶" ToolTip="运行程序 (F5)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="RunProgram_Click" />
            <Button Content="⏸" ToolTip="暂停" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⏹" ToolTip="停止 (Shift+F5)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="⟲" ToolTip="撤销 (Ctrl+Z)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⟳" ToolTip="重做 (Ctrl+Y)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="▣" ToolTip="导入图像" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="ImportImage_Click" />
            <Button Content="⤓" ToolTip="保存 (Ctrl+S)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="SaveFile_Click" />
            <Separator />
            <Button Content="⌕" ToolTip="查找 (Ctrl+H)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="☰" ToolTip="函数浏览器" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="OpenFunctionBrowser_Click" />
            <Separator />
            <Button Content="▭" ToolTip="矩形工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="◯" ToolTip="圆形工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="✎" ToolTip="画笔工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="⊕" ToolTip="放大 (Ctrl++)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⊖" ToolTip="缩小 (Ctrl+-)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⤢" ToolTip="适合窗口 (Ctrl+0)" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="▭" ToolTip="新建图形窗口" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="NewGraphicsWindow_Click" />
            <Button Content="▤" ToolTip="新建程序窗口" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="NewProgramWindow_Click" />
            <Button Content="▥" ToolTip="新建变量窗口" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="NewVariablesWindow_Click" />
            <Separator />
            <Button Content="⚙" ToolTip="重置窗口布局" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="ResetLayout_Click" />
            <Separator />
            <Button Content="◔" ToolTip="测试通知" Height="28" Width="32" Style="{StaticResource ToolBarButton}" Click="TestNotification_Click" />
        </ToolBar>

        <!-- MDI 内容区 -->
        <Grid Grid.Row="2" x:Name="ContentGrid" Background="#3A3A3A">
            <Canvas x:Name="MdiCanvas" Background="#3A3A3A" />
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="#F5F5F5" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StatusBarItem>
                <TextBlock Text="就绪" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="StatusWindowInfo">
                <TextBlock Text="活动窗口: 无" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="HALCON 20.11 - 64-bit" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Ln 1, Col 1" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>