<UserControl x:Class="Rxbit.Brigade.HalconVision.Views.HalconMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.HalconVision.ViewModels"
             xmlns:v="clr-namespace:Rxbit.Brigade.HalconVision.Views"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <Style x:Key="MenuBarItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Data="M0,0 L0,6 L6,0" HorizontalAlignment="Right" Margin="4,0,0,0" VerticalAlignment="Center" Fill="#666" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubMenuItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4444" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="#F5F5F5" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="4,2">
            <MenuItem Header="文件" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="新建图形窗口" Command="{Binding NewGraphicsWindowCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="新建程序窗口" Command="{Binding NewProgramWindowCommand}" />
                <MenuItem Header="新建变量窗口" Command="{Binding NewVariablesWindowCommand}" />
                <Separator />
                <MenuItem Header="打开..." InputGestureText="Ctrl+O" />
                <MenuItem Header="保存" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="退出" />
            </MenuItem>
            <MenuItem Header="编辑" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="撤销" />
                <MenuItem Header="重做" />
                <Separator />
                <MenuItem Header="剪切" />
                <MenuItem Header="复制" />
                <MenuItem Header="粘贴" />
                <Separator />
                <MenuItem Header="查找和替换" />
            </MenuItem>
            <MenuItem Header="执行" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="运行程序" InputGestureText="F5" />
                <MenuItem Header="单步执行" InputGestureText="F11" />
                <MenuItem Header="过程执行" InputGestureText="F10" />
                <MenuItem Header="跳出过程" InputGestureText="Shift+F11" />
                <Separator />
                <MenuItem Header="停止执行" InputGestureText="Shift+F5" />
            </MenuItem>
            <MenuItem Header="可视化" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="放大" />
                <MenuItem Header="缩小" />
                <MenuItem Header="适合窗口" />
                <Separator />
                <MenuItem Header="显示网格" />
                <MenuItem Header="显示比例尺" />
            </MenuItem>
            <MenuItem Header="窗口" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="新建图形窗口" Command="{Binding NewGraphicsWindowCommand}" />
                <MenuItem Header="新建程序窗口" Command="{Binding NewProgramWindowCommand}" />
                <MenuItem Header="新建变量窗口" Command="{Binding NewVariablesWindowCommand}" />
                <Separator />
                <MenuItem Header="层叠窗口" />
                <MenuItem Header="平铺窗口" />
                <Separator />
                <MenuItem Header="关闭当前窗口" Command="{Binding CloseTabCommand, ElementName=Root}" />
            </MenuItem>
            <MenuItem Header="建议" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="显示建议" />
                <MenuItem Header="下一条建议" />
                <MenuItem Header="上一条建议" />
            </MenuItem>
            <MenuItem Header="助手" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="HALCON 文档" />
                <MenuItem Header="示例程序" />
                <MenuItem Header="关于" />
            </MenuItem>
            <MenuItem Header="帮助" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="目录" />
                <MenuItem Header="索引" />
                <MenuItem Header="关于 HALCON" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="1" x:Name="MainToolBar" Background="#F5F5F5" Height="36" ToolBarTray.IsLocked="True">
            <Button Content="▶" ToolTip="运行" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⏸" ToolTip="暂停" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⏹" ToolTip="停止" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="⟲" ToolTip="撤销" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⟳" ToolTip="重做" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="🖼" ToolTip="导入图像" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="💾" ToolTip="保存" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="🔍" ToolTip="查找" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="⬜" ToolTip="矩形工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⚪" ToolTip="圆形工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="✏" ToolTip="画笔工具" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Separator />
            <Button Content="🔍+" ToolTip="放大" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="🔍-" ToolTip="缩小" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
            <Button Content="⤢" ToolTip="适合窗口" Height="28" Width="32" Style="{StaticResource ToolBarButton}" />
        </ToolBar>

        <!-- 标签页内容区 -->
        <Grid Grid.Row="2" x:Name="ContentGrid" Background="#ECECEC">
            <TabControl x:Name="MainTabControl" Background="Transparent"
                        BorderThickness="0"
                        SelectedItem="{Binding SelectedTab}"
                        ItemsSource="{Binding Tabs}">
                <TabControl.Resources>
                    <Style x:Key="ToolBarButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="#333" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#E0E0E0" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#555" />
                        <Setter Property="Background" Value="#F0F0F0" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderThickness="1,1,1,0"
                                            BorderBrush="#CCC"
                                            CornerRadius="4,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="10,0,4,0" />
                                            <Button Grid.Column="1" Content="✕"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TabItemCloseButtonStyle}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="#0078D4" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8E8E8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <DataTemplate DataType="{x:Type vm:HalconTabItem}">
                        <TabItem Header="{Binding Title}" Content="{Binding Content}" Tag="{Binding}">
                            <TabItem.ContentTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" />
                                </DataTemplate>
                            </TabItem.ContentTemplate>
                        </TabItem>
                    </DataTemplate>
                </TabControl.Resources>
            </TabControl>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="#F5F5F5" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <StatusBarItem>
                <TextBlock Text="就绪" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.Title, Mode=OneWay}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="HALCON 20.11 - 64-bit" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Ln 1, Col 1" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>