<UserControl x:Class="Rxbit.Brigade.HalconVision.Views.ProgramWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Rxbit.Brigade.HalconVision.Converters"
             Background="#1E1E2E">
    <UserControl.Resources>
        <conv:BoolToStrConverter x:Key="BoolToStrConverter" />
        <SolidColorBrush x:Key="CodeBgBrush" Color="#1E1E2E" />
        <SolidColorBrush x:Key="CodeLineNumberBrush" Color="#3A3A4A" />
        <SolidColorBrush x:Key="CodeKeywordBrush" Color="#C586C0" />
        <SolidColorBrush x:Key="CodeStringBrush" Color="#CE9178" />
        <SolidColorBrush x:Key="CodeCommentBrush" Color="#6A9955" />
        <SolidColorBrush x:Key="CodeFunctionBrush" Color="#DCDCAA" />
        <SolidColorBrush x:Key="CodeNumberBrush" Color="#B5CEA8" />
        <SolidColorBrush x:Key="CodeBorderBrush" Color="#2D2D3D" />
        <SolidColorBrush x:Key="CodeActiveLineBrush" Color="#2D2D40" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 文件标签栏 -->
        <Border Grid.Row="0" Background="#252535" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CodeBorderBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource CodeBgBrush}" BorderBrush="{StaticResource CodeBorderBrush}" BorderThickness="1,0,1,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding FilePath}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="✕" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 代码编辑器 -->
        <Grid Grid.Row="1" Background="{StaticResource CodeBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 行号栏 -->
            <Border Grid.Column="0" Background="#252535" BorderBrush="{StaticResource CodeBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CodeLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineNumber}" Foreground="#555" FontSize="11"
                                           FontFamily="Consolas" TextAlignment="Right" Padding="0,0,8,0"
                                           Height="{Binding}" LineHeight="18" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Height" Value="20" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 代码文本区域 -->
            <Border Grid.Column="1" Background="{StaticResource CodeBgBrush}">
                <TextBox Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#D4D4D4"
                         Background="Transparent"
                         CaretBrush="#AEAFAD"
                         BorderThickness="0"
                         Padding="4"
                         ContextMenu="{x:Null}"
                         LostFocus="CodeTextBox_LostFocus" />
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#252535" Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ln " Foreground="#888" FontSize="11" />
                <TextBlock Text="{Binding CursorLine}" Foreground="#00D4AA" FontSize="11" />
                <TextBlock Text=", Col " Foreground="#888" FontSize="11" />
                <TextBlock Text="{Binding CursorColumn}" Foreground="#00D4AA" FontSize="11" />
                <TextBlock Text="  |  " Foreground="#444" FontSize="11" />
                <TextBlock Text="文件: main()" Foreground="#888" FontSize="11" />
                <TextBlock Text="  |  " Foreground="#444" FontSize="11" />
                <TextBlock Text="{Binding IsModified, Converter={StaticResource BoolToStrConverter}}" Foreground="#888" FontSize="11" />
                <TextBlock Text="  |  UTF-8  |  LF  |  HDevelop" Foreground="#888" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>