<UserControl x:Class="Rxbit.Brigade.HalconVision.Views.GraphicsWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A2E">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GraphicsBgBrush" Color="#1A1A2E" />
        <SolidColorBrush x:Key="GraphicsGridBrush" Color="#2A2A4A" />
        <SolidColorBrush x:Key="GraphicsBorderBrush" Color="#3A7BD5" />
        <SolidColorBrush x:Key="GraphicsAccentBrush" Color="#00D4AA" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#252545" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />

                <!-- 工具选择 -->
                <ComboBox ItemsSource="{Binding Tools}" SelectedIndex="{Binding SelectedToolIndex}"
                          Width="80" Height="24" Background="#1A1A2E" Foreground="#CCC"
                          BorderBrush="#3A7BD5" />

                <Separator Margin="8,0" />

                <Button Content="⊕" ToolTip="放大" Command="{Binding ZoomInCommand}"
                        Height="24" Width="24" Background="Transparent" Foreground="#CCC" BorderThickness="0" />
                <Button Content="⊖" ToolTip="缩小" Command="{Binding ZoomOutCommand}"
                        Height="24" Width="24" Background="Transparent" Foreground="#CCC" BorderThickness="0" />
                <Button Content="⤢" ToolTip="适合" Command="{Binding FitCommand}"
                        Height="24" Width="24" Background="Transparent" Foreground="#CCC" BorderThickness="0" />

                <Separator Margin="8,0" />

                <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:F2}x'}" Foreground="#00D4AA" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
            </StackPanel>
        </Border>

        <!-- 图形画布 -->
        <Grid Grid.Row="1" Background="{StaticResource GraphicsBgBrush}">
            <Canvas x:Name="GraphicsCanvas" ClipToBounds="True">
                <Canvas.Background>
                    <DrawingBrush TileMode="Tile" Stretch="None" Viewport="0,0,20,20">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#2A2A4A" Thickness="1" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,20,20" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <!-- 模拟 Halcon 图形显示 -->
                <Grid Width="400" Height="300" Background="#0D0D1A" Canvas.Left="100" Canvas.Top="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 模拟图像内容 -->
                    <Border Grid.Row="0" Margin="20" Background="#111122" BorderBrush="#2A2A4A" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="HALCON Image Display" Foreground="#555" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="512 × 512 pixels" Foreground="#444" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 图形标记层 -->
                    <Canvas Grid.Row="0">
                        <Rectangle Canvas.Left="60" Canvas.Top="40" Width="120" Height="80"
                                   Stroke="#00D4AA" StrokeThickness="2" StrokeDashArray="4,2" />
                        <TextBlock Canvas.Left="60" Canvas.Top="22" Text="ROI 1" Foreground="#00D4AA" FontSize="11" />

                        <Ellipse Canvas.Left="240" Canvas.Top="100" Width="80" Height="80"
                                 Stroke="#FF6B6B" StrokeThickness="2" StrokeDashArray="4,2" />
                        <TextBlock Canvas.Left="240" Canvas.Top="82" Text="ROI 2" Foreground="#FF6B6B" FontSize="11" />

                        <Polyline Points="60,200 140,220 200,180 280,240 340,200"
                                  Stroke="#FFD93D" StrokeThickness="2" />
                    </Canvas>

                    <!-- 图像信息 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#1A1A2E" Margin="6,3">
                        <TextBlock Text="Width: 512" Foreground="#888" FontSize="10" Margin="0,0,12,0" />
                        <TextBlock Text="Height: 512" Foreground="#888" FontSize="10" Margin="0,0,12,0" />
                        <TextBlock Text="Channels: 1" Foreground="#888" FontSize="10" Margin="0,0,12,0" />
                        <TextBlock Text="Type: byte" Foreground="#888" FontSize="10" Margin="0,0,12,0" />
                    </StackPanel>
                </Grid>

                <!-- 坐标系 -->
                <Canvas Canvas.Left="20" Canvas.Top="20">
                    <Line X1="0" Y1="0" X2="0" Y2="360" Stroke="#3A3A5A" StrokeThickness="1" />
                    <Line X1="0" Y1="360" X2="760" Y2="360" Stroke="#3A3A5A" StrokeThickness="1" />
                    <TextBlock Text="0" Foreground="#666" FontSize="9" Canvas.Left="-12" Canvas.Top="356" />
                    <TextBlock Text="512" Foreground="#666" FontSize="9" Canvas.Left="740" Canvas.Top="356" />
                    <TextBlock Text="0" Foreground="#666" FontSize="9" Canvas.Left="6" Canvas.Top="-4" />
                    <TextBlock Text="512" Foreground="#666" FontSize="9" Canvas.Left="-18" Canvas.Top="-4" />
                </Canvas>
            </Canvas>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#252545" Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态: " Foreground="#888" FontSize="11" />
                <TextBlock Text="{Binding StatusText}" Foreground="#00D4AA" FontSize="11" />
                <TextBlock Text="  |  " Foreground="#444" FontSize="11" />
                <TextBlock Text="{Binding ZoomLevel, StringFormat='缩放: {0:F2}x'}" Foreground="#888" FontSize="11" />
                <TextBlock Text="  |  " Foreground="#444" FontSize="11" />
                <TextBlock Text="画布: 768 × 400" Foreground="#888" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>