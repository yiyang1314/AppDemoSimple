<UserControl x:Class="Rxbit.Brigade.HalconVision.Views.VariablesWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.HalconVision.ViewModels"
             xmlns:conv="clr-namespace:Rxbit.Brigade.HalconVision.Converters"
             Background="#252535">
    <UserControl.Resources>
        <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />
        <SolidColorBrush x:Key="VarBgBrush" Color="#252535" />
        <SolidColorBrush x:Key="VarHeaderBrush" Color="#1E1E2E" />
        <SolidColorBrush x:Key="VarBorderBrush" Color="#3A3A4A" />
        <SolidColorBrush x:Key="VarGroupBrush" Color="#3A7BD5" />
        <SolidColorBrush x:Key="VarValueBrush" Color="#CE9178" />
        <SolidColorBrush x:Key="VarTypeBrush" Color="#888888" />
        <SolidColorBrush x:Key="VarNameBrush" Color="#E0E0E0" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource VarHeaderBrush}" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 变量列表 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 列标题 -->
            <Grid Grid.Row="0" Margin="4,4,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="名称" Foreground="#888" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="值" Foreground="#888" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="类型" Foreground="#888" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="数组" Foreground="#888" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" />
            </Grid>

            <TreeView Grid.Row="1" ItemsSource="{Binding Groups}" Background="Transparent"
                      BorderThickness="0" SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource VarNameBrush}" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" x:Name="Expander"
                                                      IsChecked="{Binding IsExpanded}"
                                                      ClickMode="Press"
                                                      Background="Transparent" BorderThickness="0"
                                                      Width="16" Height="16" />
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                        <ItemsPresenter Grid.ColumnSpan="2" x:Name="ItemsHost" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Variables}">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource VarGroupBrush}" FontWeight="SemiBold" FontSize="12" />
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VariableItem}">
                                <Grid Margin="4,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource VarNameBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource VarValueBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{StaticResource VarTypeBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding IsArray, Converter={StaticResource BoolToYesNo}}" Foreground="{StaticResource VarTypeBrush}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- 底部信息 -->
        <Border Grid.Row="2" Background="#1E1E2E" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedGroup}" Foreground="#CCC" FontSize="11" />
                <TextBlock Text="  |  双击变量可在图形窗口中显示" Foreground="#555" FontSize="11" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>