<UserControl x:Class="Rxbit.Brigade.Controll.Views.AdminIconFontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AdminCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AdminBorderBrush" Color="#EBEEF5" />
        <SolidColorBrush x:Key="AdminTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="AdminTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="AdminTextPlaceholder" Color="#A8ABB2" />
        <SolidColorBrush x:Key="AdminHoverBrush" Color="#F5F5F5" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 面包屑 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🏠" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text=" 我的桌面" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" / " FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text="图标对应字体" FontSize="13" Foreground="{StaticResource AdminTextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 图标区域 -->
        <Border Grid.Row="1" Background="{StaticResource AdminCardBrush}"
                BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="IconFont 图标" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AdminTextPrimary}" Margin="0,0,0,24" />

                <!-- 图标网格 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Icons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" CornerRadius="4" Padding="12" Margin="4"
                                        Cursor="Hand" BorderThickness="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Unicode}" FontSize="28"
                                                   Foreground="{StaticResource AdminTextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Width="60" Height="60"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource AdminTextSecondary}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Hex}" FontSize="10"
                                                   Foreground="{StaticResource AdminTextPlaceholder}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
