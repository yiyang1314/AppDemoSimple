<UserControl x:Class="Rxbit.Brigade.Controll.Views.ShopShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ShopBg" Color="#F5F7FA" />
        <SolidColorBrush x:Key="ShopSidebarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ShopPrimary" Color="#00B578" />
        <SolidColorBrush x:Key="ShopPrimaryDark" Color="#009A66" />
        <SolidColorBrush x:Key="ShopText" Color="#303133" />
        <SolidColorBrush x:Key="ShopTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="ShopTextLight" Color="#909399" />
        <SolidColorBrush x:Key="ShopBorder" Color="#E4E7ED" />
        <SolidColorBrush x:Key="ShopCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ShopHover" Color="#F0F9F4" />
    </UserControl.Resources>

    <Grid Background="{StaticResource ShopBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource ShopSidebarBg}" BorderBrush="{StaticResource ShopBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="28" Height="28" RadiusX="6" RadiusY="6" Fill="{StaticResource ShopPrimary}" />
                        <TextBlock Text="我的应用商店" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ShopText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 导航菜单 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShopMenuPanel" Margin="12,8" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部栏 -->
            <Border Grid.Row="0" Background="{StaticResource ShopCard}" BorderBrush="{StaticResource ShopBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Column="0" Background="#F2F3F5" CornerRadius="20" Height="36" VerticalAlignment="Center" Margin="24,0,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ShopTextLight}" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ShopText}" FontSize="13" VerticalContentAlignment="Center" Padding="0,0,10,0" />
                        </Grid>
                    </Border>

                    <!-- 右侧操作栏 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="⏊" FontSize="16" Foreground="{StaticResource ShopTextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="≡" FontSize="16" Foreground="{StaticResource ShopTextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="28" Height="28" Fill="{StaticResource ShopPrimary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1" x:Name="ShopContentArea" />
        </Grid>
    </Grid>
</UserControl>
