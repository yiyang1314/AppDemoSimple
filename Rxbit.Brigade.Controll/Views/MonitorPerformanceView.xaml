<UserControl x:Class="Rxbit.Brigade.Controll.Views.MonitorPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F3F3F3">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PerHeaderBg" Color="#FAFAFA" />
        <SolidColorBrush x:Key="PerBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="PerItemBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PerItemActiveBg" Color="#E5F1FB" />
        <SolidColorBrush x:Key="PerItemHoverBg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PerText" Color="#1A1A1A" />
        <SolidColorBrush x:Key="PerMuted" Color="#666666" />
        <SolidColorBrush x:Key="PerValue" Color="#1A1A1A" />
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PerHeaderBg}" BorderBrush="{StaticResource PerBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PageTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PerText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#0078D4" CornerRadius="4" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="运行新任务" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="⋯" FontSize="16" Foreground="{StaticResource PerMuted}" VerticalAlignment="Center" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧监控项列表 -->
            <Border Grid.Column="0" Background="{StaticResource PerItemBg}" BorderBrush="{StaticResource PerBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MonItemsControl" ItemsSource="{Binding MonitorItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Margin="6,3" Padding="10,8" Cursor="Hand"
                                        MouseLeftButtonDown="ItemBorder_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#E5F1FB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 左侧文字区 -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource PerText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SubLabel}" FontSize="11" Foreground="{StaticResource PerMuted}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </StackPanel>
                                        <!-- 右侧迷你图 + 数值 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Percentage, StringFormat={}{0:F0}%}" FontSize="12" Foreground="{StaticResource PerMuted}" HorizontalAlignment="Right" />
                                            <Polyline Points="{Binding SparkPoints}" Stroke="{Binding Color}" StrokeThickness="1.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 右侧详情区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LiveChartsCore 图表区 -->
                <Grid Grid.Row="0" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 图表标题 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SelectedItemDetail.DetailTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PerText}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedItemDetail.DetailSubtitle}" FontSize="12" Foreground="{StaticResource PerMuted}" VerticalAlignment="Center" />
                    </Grid>
                    <!-- CartesianChart -->
                    <Border Grid.Row="1" Background="{StaticResource PerItemBg}" BorderBrush="{StaticResource PerBorder}" BorderThickness="1" CornerRadius="4">
                        <lvc:CartesianChart x:Name="DetailChart" Background="White" Margin="4">
                        </lvc:CartesianChart>
                    </Border>
                </Grid>

                <!-- 底部详情面板 -->
                <Border Grid.Row="1" Background="{StaticResource PerItemBg}" BorderBrush="{StaticResource PerBorder}" BorderThickness="1,1,0,0" Margin="12,0,12,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 第1组 -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{Binding SelectedItemDetail.InfoLabel1}" FontSize="11" Foreground="{StaticResource PerMuted}" />
                            <TextBlock Text="{Binding SelectedItemDetail.InfoValue1}" FontSize="16" Foreground="{StaticResource PerText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <!-- 第2组 -->
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding SelectedItemDetail.InfoLabel2}" FontSize="11" Foreground="{StaticResource PerMuted}" />
                            <TextBlock Text="{Binding SelectedItemDetail.InfoValue2}" FontSize="16" Foreground="{StaticResource PerText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <!-- 第3组 -->
                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="{Binding SelectedItemDetail.InfoLabel3}" FontSize="11" Foreground="{StaticResource PerMuted}" />
                            <TextBlock Text="{Binding SelectedItemDetail.InfoValue3}" FontSize="16" Foreground="{StaticResource PerText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <!-- 第4组 -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding SelectedItemDetail.InfoLabel4}" FontSize="11" Foreground="{StaticResource PerMuted}" />
                            <TextBlock Text="{Binding SelectedItemDetail.InfoValue4}" FontSize="16" Foreground="{StaticResource PerText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>