<UserControl x:Class="Rxbit.Brigade.Controll.Views.AdminListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AdminCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AdminBorderBrush" Color="#EBEEF5" />
        <SolidColorBrush x:Key="AdminTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="AdminTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="AdminTextPlaceholder" Color="#A8ABB2" />
        <SolidColorBrush x:Key="AdminPrimaryColor" Color="#16B779" />
        <SolidColorBrush x:Key="AdminDangerColor" Color="#E91E63" />
        <SolidColorBrush x:Key="AdminHeaderBg" Color="#FAFAFA" />
        <SolidColorBrush x:Key="AdminHeaderText" Color="#303133" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 面包屑 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="首页" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" / " FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text="演示" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" / " FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text="导航元素" FontSize="13" Foreground="{StaticResource AdminTextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 内容区 -->
        <Border Grid.Row="1" Background="{StaticResource AdminCardBrush}"
                BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 筛选区域 -->
                <TextBlock Grid.Row="0" Text="筛选条件" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" Margin="0,0,0,12" />

                <!-- 筛选表单 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="开始日" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" />
                        <Border BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0" Height="30">
                            <TextBox Text="" BorderThickness="0" Padding="8,4" FontSize="12"
                                     Foreground="{StaticResource AdminTextPrimary}" Background="Transparent" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="截止日" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" />
                        <Border BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0" Height="30">
                            <TextBox Text="" BorderThickness="0" Padding="8,4" FontSize="12"
                                     Foreground="{StaticResource AdminTextPrimary}" Background="Transparent" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="输入用户名" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" />
                        <Border BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0" Height="30">
                            <TextBox Text="" BorderThickness="0" Padding="8,4" FontSize="12"
                                     Foreground="{StaticResource AdminTextPrimary}" Background="Transparent" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="3" Content="🔍" Width="30" Height="30" Background="{StaticResource AdminPrimaryColor}"
                            Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,20,16,0" />

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,20,0,0">
                        <Button Content="批量删除" Background="{StaticResource AdminDangerColor}" Foreground="White"
                                BorderThickness="0" Padding="16,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
                        <Button Content="+ 添加" Background="{StaticResource AdminPrimaryColor}" Foreground="White"
                                BorderThickness="0" Padding="16,6" FontSize="12" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- 表格 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <!-- 表头 -->
                    <Border Background="{StaticResource AdminHeaderBg}" BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="☑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="1" Text="ID" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="2" Text="登录名" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="3" Text="手机" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="4" Text="邮箱" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="5" Text="角色" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="6" Text="加入时间" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="7" Text="状态" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                        <TextBlock Grid.Column="8" Text="操作" FontSize="12" Foreground="{StaticResource AdminHeaderText}" VerticalAlignment="Center" Padding="8" />
                    </Grid>
                    </Border>

                    <!-- 表格数据 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="☑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8" Foreground="{StaticResource AdminTextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="12" Foreground="{StaticResource AdminTextPrimary}" VerticalAlignment="Center" Padding="8" />
                                        <TextBlock Grid.Column="2" Text="{Binding LoginName}" FontSize="12" Foreground="{StaticResource AdminTextPrimary}" VerticalAlignment="Center" Padding="8" />
                                        <TextBlock Grid.Column="3" Text="{Binding Phone}" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" />
                                        <TextBlock Grid.Column="4" Text="{Binding Email}" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" />
                                        <TextBlock Grid.Column="5" Text="{Binding Role}" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" />
                                        <TextBlock Grid.Column="6" Text="{Binding JoinTime}" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" />
                                        <Border Grid.Column="7" Background="{StaticResource AdminPrimaryColor}" CornerRadius="2" Padding="8,3" Margin="8">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="8">
                                            <Button Content="✎" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AdminPrimaryColor}" Cursor="Hand" Padding="4" />
                                            <Button Content="🗑" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AdminPrimaryColor}" Cursor="Hand" Padding="4" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 分页 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <TextBlock Text="«" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" Cursor="Hand" />
                    <TextBlock Text="1" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" Cursor="Hand" />
                    <Border Background="{StaticResource AdminPrimaryColor}" CornerRadius="2" Padding="8,4" Margin="4">
                        <TextBlock Text="2" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="3" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" Cursor="Hand" />
                    <TextBlock Text="489" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" Cursor="Hand" />
                    <TextBlock Text="»" FontSize="12" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" Padding="8" Cursor="Hand" />
                    <TextBlock Text=" 共 4890 条" FontSize="12" Foreground="{StaticResource AdminTextPlaceholder}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
