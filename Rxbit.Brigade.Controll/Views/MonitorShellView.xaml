<UserControl x:Class="Rxbit.Brigade.Controll.Views.MonitorShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F3F3">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MonSidebarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MonSidebarBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="MonActiveBg" Color="#0078D4" />
        <SolidColorBrush x:Key="MonNormalText" Color="#1A1A1A" />
        <SolidColorBrush x:Key="MonMutedText" Color="#666666" />
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource MonSidebarBg}" BorderBrush="{StaticResource MonSidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部汉堡菜单 -->
                <Border Grid.Row="0" Background="{StaticResource MonSidebarBg}" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☰" FontSize="16" Foreground="{StaticResource MonMutedText}" VerticalAlignment="Center" Cursor="Hand" />
                        <TextBlock Text="任务管理器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MonNormalText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 导航菜单 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MonNavPanel" Margin="4,8" />
                </ScrollViewer>

                <!-- 底部设置 -->
                <Border Grid.Row="2" Background="{StaticResource MonSidebarBg}" Padding="12">
                    <Border Background="Transparent" Padding="10,8" Cursor="Hand" x:Name="MonSettingsBtn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Width="24" Foreground="{StaticResource MonMutedText}" VerticalAlignment="Center" />
                            <TextBlock Text="设置" FontSize="13" Foreground="{StaticResource MonNormalText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Column="1" x:Name="MonContentArea" />
    </Grid>
</UserControl>
