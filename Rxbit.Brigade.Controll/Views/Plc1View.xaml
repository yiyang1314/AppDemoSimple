<UserControl x:Class="Rxbit.Brigade.Controll.Views.Plc1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A1A30">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Plc1Bg" Color="#0A1A30" />
        <SolidColorBrush x:Key="Plc1Panel" Color="#0E2744" />
        <SolidColorBrush x:Key="Plc1PanelLight" Color="#F5F7FA" />
        <SolidColorBrush x:Key="Plc1Primary" Color="#FFC000" />
        <SolidColorBrush x:Key="Plc1Cyan" Color="#00E5FF" />
        <SolidColorBrush x:Key="Plc1Text" Color="#0A1A30" />
        <SolidColorBrush x:Key="Plc1Dark" Color="#0A1A30" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Plc1Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!-- 顶部：品牌区 -->
        <Grid Grid.Row="0" Background="{StaticResource Plc1Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Plc1Primary}" CornerRadius="0,0,6,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VISA" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Plc1Dark}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Plc1PanelLight}" CornerRadius="30"
                    Margin="20,8" Padding="20,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Rectangle Width="120" Height="8" Fill="#E8E8E8" RadiusX="4" RadiusY="4" Margin="0,0,20,0" />
                    <TextBlock Text="自动化设备" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Plc1Text}" VerticalAlignment="Center" />
                    <Rectangle Width="120" Height="8" Fill="#E8E8E8" RadiusX="4" RadiusY="4" Margin="20,0,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding Account}" FontSize="12" Foreground="{StaticResource Plc1Cyan}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource Plc1Primary}" HorizontalAlignment="Right" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <StackPanel Grid.Column="0" Margin="8,8,4,8">
                <ItemsControl ItemsSource="{Binding LeftNav}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsActive, Converter={StaticResource NullConverter}}"
                                    CornerRadius="20" Padding="16,12" Margin="0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="11" Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 中间：工位卡片 -->
            <Grid Grid.Column="1" Margin="4,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding Stations}" Grid.RowSpan="2" Grid.ColumnSpan="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="8" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Plc1PanelLight}" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <Border Background="{StaticResource Plc1Cyan}" CornerRadius="4" Padding="16,6" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Plc1Text}" />
                                    </Border>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="序号" FontSize="11" Foreground="#666" Margin="8,2,0,2" />
                                        <TextBlock Grid.Column="1" Text="位置设定 (M)" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                        <TextBlock Grid.Column="2" Text="速度设定(M/S)" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                        <TextBlock Grid.Column="3" Text="" FontSize="11" Margin="0,2,0,2" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Axes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Plc1Text}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <Border Grid.Column="1" Background="#FFF" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2" Margin="4,0">
                                                        <TextBlock Text="{Binding Position}" FontSize="12" Foreground="{StaticResource Plc1Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                    </Border>
                                                    <Border Grid.Column="2" Background="#FFF" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2" Margin="4,0">
                                                        <TextBlock Text="{Binding Speed}" FontSize="12" Foreground="{StaticResource Plc1Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                    </Border>
                                                    <Border Grid.Column="3" Background="{StaticResource Plc1Cyan}" CornerRadius="4" Margin="4,0,4,0" Padding="8,4">
                                                        <TextBlock Text="确定" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Plc1Text}" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 右侧导航 -->
            <StackPanel Grid.Column="2" Margin="4,8,8,8">
                <ItemsControl ItemsSource="{Binding RightNav}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Plc1Primary}" CornerRadius="16" Padding="12,12" Margin="0,6">
                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Plc1Dark}" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2" Background="{StaticResource Plc1Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Plc1Primary}" Margin="8,10,4,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="16" Foreground="{StaticResource Plc1Text}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="启动" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Plc1Text}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#3A5A7A" Margin="4,10,4,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☐" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="暂停" FontSize="16" Foreground="#888" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#3A5A7A" Margin="4,10,4,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☐" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="停止" FontSize="16" Foreground="#888" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#3A5A7A" Margin="4,10,4,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☐" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="急停" FontSize="16" Foreground="#888" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#3A5A7A" Margin="4,10,8,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☐" FontSize="14" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="复位" FontSize="16" Foreground="#888" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
