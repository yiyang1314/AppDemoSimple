<UserControl x:Class="Rxbit.Brigade.Controll.Views.Dashboard5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1060"
             Background="#141414">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141414" />
        <SolidColorBrush x:Key="DarkCardBrush" Color="#1D1E1F" />
        <SolidColorBrush x:Key="DarkTextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkTextSecondary" Color="#A6A6A6" />
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1890FF" />
    </UserControl.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Height="50" Background="{StaticResource DarkCardBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="概览" Foreground="{StaticResource DarkTextSecondary}" FontSize="14" />
                    <TextBlock Text=" / " Foreground="{StaticResource DarkTextSecondary}" FontSize="14" />
                    <TextBlock Text="分析页" Foreground="{StaticResource DarkTextPrimary}" FontSize="14" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Margin="0,10,16,0"
                        Background="Transparent" BorderBrush="{StaticResource DarkBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12,0" Height="30"
                        VerticalAlignment="Center">
                    <TextBlock Text="🔍 搜索" Foreground="{StaticResource DarkTextSecondary}" FontSize="12"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 面包屑 -->
        <Border Grid.Row="1" Height="40" Background="{StaticResource DarkCardBrush}" Margin="0,1,0,0">
            <Grid>
                <TextBlock Text="分析页" Foreground="{StaticResource DarkTextPrimary}" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🔔" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,12,0" />
                    <TextBlock Text="🌙" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,12,0" />
                    <TextBlock Text="🌐" Foreground="{StaticResource DarkTextSecondary}" Margin="0,0,12,0" />
                    <TextBlock Text="👤 admin" Foreground="{StaticResource DarkTextSecondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 统计卡片 - 暗色主题 -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="100">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="用户量" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="2,000" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkTextPrimary}" />
                                <TextBlock Text=" 总用户量" FontSize="11" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="44" Height="44" Fill="#1890FF20" />
                            <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-32,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="+8.2%" FontSize="11" Foreground="#52C41A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="100">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="访问量" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="20,000" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkTextPrimary}" />
                                <TextBlock Text=" 总访问量" FontSize="11" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="44" Height="44" Fill="#52C41A20" />
                            <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-32,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="+12.5%" FontSize="11" Foreground="#52C41A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="100">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="下载量" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="8,000" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkTextPrimary}" />
                                <TextBlock Text=" 总下载量" FontSize="11" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="44" Height="44" Fill="#FAAD1420" />
                            <TextBlock Text="⬇️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-32,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="-5.3%" FontSize="11" Foreground="#FF4D4F" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="100">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="使用量" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="5,000" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkTextPrimary}" />
                                <TextBlock Text=" 总使用量" FontSize="11" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="44" Height="44" Fill="#722ED120" />
                            <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-32,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="+3.8%" FontSize="11" Foreground="#52C41A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 流量趋势面积图 -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="260">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="流量趋势" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource DarkTextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="#1890FF30" CornerRadius="3" Padding="8,2">
                                    <TextBlock Text="月访问量" FontSize="11" Foreground="#1890FF" />
                                </Border>
                            </StackPanel>

                            <!-- 面积图 -->
                            <Grid Height="160" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#2A2A2A" Height="1" VerticalAlignment="Bottom" />
                                <Border Grid.Row="1" Background="#2A2A2A" Height="1" VerticalAlignment="Bottom" />
                                <Border Grid.Row="2" Background="#2A2A2A" Height="1" VerticalAlignment="Bottom" />

                                <Canvas>
                                    <Polyline Points="0,180 60,160 120,130 180,90 240,50 300,30 360,55 420,100 480,140 540,165 600,175 660,180 720,200 0,200"
                                              Fill="#1890FF25" Stroke="Transparent" />
                                    <Polyline Points="0,180 60,160 120,130 180,90 240,50 300,30 360,55 420,100 480,140 540,165 600,175 660,180"
                                              Stroke="#1890FF" StrokeThickness="2" Fill="Transparent" />
                                </Canvas>

                                <!-- Y 轴标签 -->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="80,000" FontSize="10" Foreground="{StaticResource DarkTextSecondary}" />
                                </StackPanel>
                                <TextBlock Text="60,000" FontSize="10" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="40,000" FontSize="10" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="20,000" FontSize="10" Foreground="{StaticResource DarkTextSecondary}"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 访问量环形图 -->
                <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="260">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="访问量" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource DarkTextPrimary}" />
                            <TextBlock Text="50,000" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource DarkTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,20,0,8" />

                            <Grid Height="120">
                                <Ellipse Width="100" Height="100" Stroke="#2A2A2A" StrokeThickness="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="100" Height="100" Stroke="#1890FF" StrokeThickness="14"
                                         StrokeDashArray="200 314" StrokeDashCap="Round"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <TextBlock Text="总访问量" FontSize="11" Foreground="{StaticResource DarkTextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 访问来源饼图 -->
                <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="8" Margin="8" Padding="16" Height="260">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="访问来源" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource DarkTextPrimary}" />

                            <!-- 图例 -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="12" Height="12" Fill="#1890FF" Margin="0,0,8,0" />
                                    <TextBlock Text="直接" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                                    <TextBlock Text=" 35%" FontSize="12" Foreground="{StaticResource DarkTextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="12" Height="12" Fill="#52C41A" Margin="0,0,8,0" />
                                    <TextBlock Text="邮件" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                                    <TextBlock Text=" 25%" FontSize="12" Foreground="{StaticResource DarkTextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="12" Height="12" Fill="#FAAD14" Margin="0,0,8,0" />
                                    <TextBlock Text="广告" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                                    <TextBlock Text=" 20%" FontSize="12" Foreground="{StaticResource DarkTextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="12" Height="12" Fill="#722ED1" Margin="0,0,8,0" />
                                    <TextBlock Text="视频" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                                    <TextBlock Text=" 12%" FontSize="12" Foreground="{StaticResource DarkTextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="12" Height="12" Fill="#13C2C2" Margin="0,0,8,0" />
                                    <TextBlock Text="其它" FontSize="12" Foreground="{StaticResource DarkTextSecondary}" />
                                    <TextBlock Text=" 8%" FontSize="12" Foreground="{StaticResource DarkTextPrimary}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

