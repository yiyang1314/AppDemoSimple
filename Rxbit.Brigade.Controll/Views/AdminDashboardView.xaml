<UserControl x:Class="Rxbit.Brigade.Controll.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AdminCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AdminBorderBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="AdminTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="AdminTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="AdminTextPlaceholder" Color="#909399" />
        <SolidColorBrush x:Key="AdminYellowBrush" Color="#FCB341" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 面包屑 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🏠" FontSize="14" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" 我的桌面" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 欢迎条 -->
                <Border Grid.Row="0" Background="{StaticResource AdminYellowBrush}" CornerRadius="2"
                        Padding="16" Margin="0,0,0,16">
                    <TextBlock>
                        <Run Text="欢迎管理员：" Foreground="#333" />
                        <Run Text="test!" FontWeight="Bold" Foreground="#E91E63" />
                        <Run Text="  当前时间 2018-04-25 20:50:53" Foreground="#333" />
                    </TextBlock>
                </Border>

                <!-- 数据统计 -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据统计" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AdminTextPrimary}" Margin="0,0,0,12" />

                    <!-- 统计卡片 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AdminCardBrush}"
                                        BorderBrush="{StaticResource AdminBorderBrush}"
                                        BorderThickness="1" CornerRadius="2"
                                        Padding="12,16" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{Binding Color}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Foreground="{StaticResource AdminTextSecondary}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 下载统计 -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="下载月" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AdminTextPrimary}" Margin="0,0,0,12" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Downloads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AdminCardBrush}"
                                        BorderBrush="{StaticResource AdminBorderBrush}"
                                        BorderThickness="1" CornerRadius="2"
                                        Padding="16" Margin="6">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{Binding Color}" />
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       Foreground="{StaticResource AdminTextSecondary}" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Percent}" FontSize="11"
                                                           Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Text=" ⓘ" FontSize="11"
                                                           Foreground="{StaticResource AdminTextPlaceholder}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 系统信息 -->
                <Border Background="{StaticResource AdminCardBrush}"
                        BorderBrush="{StaticResource AdminBorderBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="16">
                    <StackPanel>
                        <TextBlock Text="系统信息" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource AdminTextPrimary}" Margin="0,0,0,12" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" FontSize="13"
                                   Foreground="{StaticResource AdminTextSecondary}" Padding="10,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.180420" FontSize="13"
                                   Foreground="{StaticResource AdminTextPrimary}" Padding="10,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器地址" FontSize="13"
                                   Foreground="{StaticResource AdminTextSecondary}" Padding="10,8"
                                   Background="#FAFAFA" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="x.xuebingsi.com" FontSize="13"
                                   Foreground="{StaticResource AdminTextPrimary}" Padding="10,8"
                                   Background="#FAFAFA" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="操作系统" FontSize="13"
                                   Foreground="{StaticResource AdminTextSecondary}" Padding="10,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WINNT" FontSize="13"
                                   Foreground="{StaticResource AdminTextPrimary}" Padding="10,8" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
