<UserControl x:Class="Rxbit.Brigade.Controll.Views.MonitorProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             Background="#F3F3F3">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ProcHeaderBg" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ProcBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="ProcRowAlt" Color="#F9F9F9" />
        <SolidColorBrush x:Key="ProcText" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ProcMuted" Color="#666666" />
        <SolidColorBrush x:Key="ProcGreen" Color="#52C41A" />
        <SolidColorBrush x:Key="ProcOrange" Color="#FA8C16" />
        <SolidColorBrush x:Key="ProcBlue" Color="#1890FF" />
        <SolidColorBrush x:Key="ProcRed" Color="#F5222D" />

        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ProcMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SortableHeader" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessRow" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource ProcBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Background="{StaticResource ProcHeaderBg}" BorderBrush="{StaticResource ProcBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="进程" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ProcText}" VerticalAlignment="Center" />
                    <TextBlock Text="  ({Binding FilteredProcesses.Count})" FontSize="12" Foreground="{StaticResource ProcMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource ProcBorder}" BorderThickness="1" CornerRadius="4" Width="240" Height="30" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ProcMuted}" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource ProcText}"
                                     FontSize="13" VerticalContentAlignment="Center" Padding="0,0,10,0" />
                        </Grid>
                    </Border>
                    <Border Background="#0078D4" CornerRadius="4" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="运行新任务" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="⋯" FontSize="16" Foreground="{StaticResource ProcMuted}" VerticalAlignment="Center" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进程列表主区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Border Grid.Row="0" Background="{StaticResource ProcHeaderBg}" BorderBrush="{StaticResource ProcBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SortableHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="名称" Style="{StaticResource HeaderCell}" />
                            <TextBlock Text="⇅" FontSize="10" Foreground="{StaticResource ProcMuted}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="状态" Style="{StaticResource HeaderCell}" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="CPU" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="内存" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="磁盘" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="网络" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource SortableHeader}">
                        <TextBlock Text="" Style="{StaticResource HeaderCell}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 列表内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredProcesses.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding FilteredProcesses}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,1,0,1" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProcessRow}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称列 -->
                                    <Border Grid.Column="0" Padding="12,10,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="14" Width="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource ProcText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="180" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 状态列 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,10">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource ProcGreen}" Margin="0,0,6,0" />
                                        <TextBlock Text="运行中" FontSize="12" Foreground="{StaticResource ProcMuted}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- CPU -->
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="12" Foreground="{StaticResource ProcText}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,10,12,10" />

                                    <!-- 内存 -->
                                    <TextBlock Grid.Column="3" Text="{Binding MemoryText}" FontSize="12" Foreground="{StaticResource ProcText}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,10,12,10" />

                                    <!-- 磁盘 -->
                                    <TextBlock Grid.Column="4" Text="{Binding DiskText}" FontSize="12" Foreground="{StaticResource ProcText}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,10,12,10" />

                                    <!-- 网络 -->
                                    <TextBlock Grid.Column="5" Text="{Binding NetworkText}" FontSize="12" Foreground="{StaticResource ProcText}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,10,12,10" />

                                    <!-- 操作按钮 -->
                                    <Border Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="⋯" FontSize="14" Foreground="{StaticResource ProcMuted}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态提示 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredProcesses.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource ProcMuted}" />
                <TextBlock Text="未找到匹配的进程" FontSize="14" Foreground="{StaticResource ProcMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
