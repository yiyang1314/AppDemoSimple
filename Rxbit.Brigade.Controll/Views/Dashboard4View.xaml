<UserControl x:Class="Rxbit.Brigade.Controll.Views.Dashboard4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1060"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LightBgBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="LightCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LightTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="LightTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="LightTextPlaceholder" Color="#909399" />
    </UserControl.Resources>

    <Grid Background="{StaticResource LightBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Border Grid.Row="0" Height="50" Background="{StaticResource LightCardBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="仪表板" Foreground="{StaticResource LightTextPlaceholder}" FontSize="14" />
                    <TextBlock Text=" / " Foreground="{StaticResource LightTextPlaceholder}" FontSize="14" />
                    <TextBlock Text="工作台" Foreground="{StaticResource LightTextPrimary}" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：列表 -->
            <Border Grid.Column="0" Style="{StaticResource LightCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标签页 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#1890FF" CornerRadius="4" Padding="16,6">
                            <TextBlock Text="主工作台" Foreground="White" FontSize="13" />
                        </Border>
                        <Border Background="Transparent" CornerRadius="4" Padding="16,6" Margin="4,0,0,0">
                            <TextBlock Text="工作台上" Foreground="{StaticResource LightTextSecondary}" FontSize="13" />
                        </Border>
                    </StackPanel>

                    <!-- 项目列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" CornerRadius="6"
                                            Padding="12" Margin="0,8,0,0"
                                            BorderBrush="#EBEEF5" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 头像 -->
                                                <Ellipse Width="40" Height="40"
                                                         Fill="{Binding Color}"
                                                         VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="-24,0,0,0" Width="40" Height="40" />

                                                <!-- 信息 -->
                                                <StackPanel Margin="12,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource LightTextPrimary}" />
                                                        <TextBlock Text="  开源项目" FontSize="12"
                                                                   Foreground="{StaticResource LightTextPlaceholder}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                                               Foreground="{StaticResource LightTextSecondary}"
                                                               TextWrapping="Wrap" MaxWidth="400"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource LightTextPlaceholder}"
                                                               Margin="0,6,0,0">
                                                        <Run Text="创建时间：" />
                                                        <Run Text="{Binding Date}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧：活动流 -->
            <Border Grid.Column="1" Style="{StaticResource LightCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Ellipse Width="200" Height="140" Fill="#E6F7FF"
                                 HorizontalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="数据分析" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 活动列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="最新活动" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="0,8" Margin="0,4"
                                                BorderBrush="#EBEEF5" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="12"
                                                           Foreground="{StaticResource LightTextPrimary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Time}" FontSize="11"
                                                           Foreground="{StaticResource LightTextPlaceholder}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

