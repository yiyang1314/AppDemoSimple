<UserControl x:Class="Rxbit.Brigade.Controll.Views.Hmi4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050F1D">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AutoBg" Color="#050F1D" />
        <SolidColorBrush x:Key="AutoDark" Color="#0A1B2E" />
        <SolidColorBrush x:Key="AutoPanel" Color="#0D2340" />
        <SolidColorBrush x:Key="AutoBorder" Color="#0B64AF" />
        <SolidColorBrush x:Key="AutoPrimary" Color="#1CA5FF" />
        <SolidColorBrush x:Key="AutoPrimaryGlow" Color="#0088CC" />
        <SolidColorBrush x:Key="AutoGreen" Color="#2ED573" />
        <SolidColorBrush x:Key="AutoRed" Color="#E74C3C" />
        <SolidColorBrush x:Key="AutoYellow" Color="#F1C40F" />
        <SolidColorBrush x:Key="AutoText" Color="#BFD5F0" />
        <SolidColorBrush x:Key="AutoTextDim" Color="#7A8FA8" />
        <SolidColorBrush x:Key="AutoTextActive" Color="#FFFFFF" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AutoBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource AutoDark}" BorderBrush="{StaticResource AutoBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧Logo + 时间 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="24" Height="24" Fill="{StaticResource AutoPrimary}" RadiusX="4" RadiusY="4" />
                            <TextBlock Text="思刀" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="MOTEC" FontSize="10" Foreground="#666" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Width="1" Background="{StaticResource AutoBorder}" Margin="16,8,16,8" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- 中间标题 -->
                <Border Grid.Column="1" Background="{StaticResource AutoPanel}" CornerRadius="6" Padding="16,8"
                        Margin="40,0,40,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Line X1="0" Y1="10" X2="60" Y2="10" Stroke="{StaticResource AutoPrimary}" StrokeThickness="2" StrokeStartLineCap="Round" />
                        <TextBlock Text="自动化设备" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AutoTextActive}" Margin="12,0,12,0" />
                        <Line X1="0" Y1="10" X2="60" Y2="10" Stroke="{StaticResource AutoPrimary}" StrokeThickness="2" StrokeEndLineCap="Round" />
                    </StackPanel>
                </Border>

                <!-- 右侧用户 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" CornerRadius="4" Padding="16,6" Background="{StaticResource AutoPanel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="{StaticResource AutoPrimary}" />
                            <TextBlock Text="用户" FontSize="13" Foreground="{StaticResource AutoText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="12,0,0,0">
                        <Ellipse Width="28" Height="28" Fill="{StaticResource AutoPanel}"
                                 Stroke="{StaticResource AutoBorder}" StrokeThickness="1" />
                        <TextBlock Text="↻" FontSize="16" Foreground="{StaticResource AutoPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧操作按钮 -->
            <Border Grid.Column="0" Margin="12,12,0,12" Background="{StaticResource AutoPanel}" CornerRadius="8"
                    BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" Padding="8">
                <StackPanel>
                    <!-- 开始 -->
                    <Border Background="{StaticResource AutoGreen}" CornerRadius="6" Padding="8,16" Margin="4,4">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#1AA654">
                                <TextBlock Text="▶" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="开始" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 暂停 -->
                    <Border Background="{StaticResource AutoDark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                                <TextBlock Text="❚❚" FontSize="10" Foreground="{StaticResource AutoText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="暂停" FontSize="13" Foreground="{StaticResource AutoText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 停止 -->
                    <Border Background="{StaticResource AutoDark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                                <TextBlock Text="■" FontSize="14" Foreground="{StaticResource AutoRed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="停止" FontSize="13" Foreground="{StaticResource AutoRed}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 急停 -->
                    <Border Background="#5A1E1E" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                            BorderBrush="#8B3A3A" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#8B3A3A">
                                <TextBlock Text="∅" FontSize="16" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="急停" FontSize="13" Foreground="{StaticResource AutoRed}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 复位 -->
                    <Border Background="{StaticResource AutoDark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,0"
                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                                <TextBlock Text="⤓" FontSize="18" Foreground="{StaticResource AutoPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="复位" FontSize="13" Foreground="{StaticResource AutoPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右侧面板区 -->
            <Grid Grid.Column="1" Margin="12,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 第一列：抓手控制 + NG料道 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 抓手控制 -->
                    <Border Grid.Row="0" Background="{StaticResource AutoPanel}" CornerRadius="8"
                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" Margin="0,0,6,6" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="⚙ 抓手控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AutoPrimary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                </StackPanel>
                            </Grid>
                            <!-- 开关列表 -->
                            <StackPanel>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="转角缸" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border Grid.Column="2" Height="22" Width="50" Background="#2A3A50" CornerRadius="11" HorizontalAlignment="Right">
                                        <Ellipse Width="18" Height="18" Fill="#5A7090" HorizontalAlignment="Left" Margin="2,2,0,2" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="防坠落" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border Grid.Column="2" Height="22" Width="50" Background="#2A3A50" CornerRadius="11" HorizontalAlignment="Right">
                                        <Ellipse Width="18" Height="18" Fill="#5A7090" HorizontalAlignment="Left" Margin="2,2,0,2" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="插销缸" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border Grid.Column="2" Height="22" Width="50" Background="{StaticResource AutoPrimary}" CornerRadius="11" HorizontalAlignment="Right">
                                        <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- 手控NG料道 -->
                    <Border Grid.Row="1" Background="{StaticResource AutoPanel}" CornerRadius="8"
                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" Margin="0,6,6,0" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="⚙ 手控NG料道" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AutoPrimary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="呼叫AGV" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0">
                                        <TextBlock Text="取盘" FontSize="13" Foreground="{StaticResource AutoText}" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource AutoPrimary}" CornerRadius="4" Padding="8,6" Margin="4,0">
                                        <TextBlock Text="送盘" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="确认完毕" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0">
                                        <TextBlock Text="取盘" FontSize="13" Foreground="{StaticResource AutoText}" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource AutoPrimary}" CornerRadius="4" Padding="8,6" Margin="4,0">
                                        <TextBlock Text="送盘" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 第二列：拆机盘控制 -->
                <Border Grid.Column="1" Background="{StaticResource AutoPanel}" CornerRadius="8"
                        BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" Margin="6,0,6,0" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="⚙ 拆机盘控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AutoPrimary}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                            </StackPanel>
                        </Grid>
                        <!-- 开关列表 -->
                        <StackPanel>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="上提" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource AutoPrimary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="下提" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource AutoPrimary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="托举" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource AutoPrimary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="挡停" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource AutoTextDim}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource AutoPrimary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 第三列：料道控制 -->
                <Border Grid.Column="2" Background="{StaticResource AutoPanel}" CornerRadius="8"
                        BorderBrush="{StaticResource AutoBorder}" BorderThickness="1" Margin="6,0,0,0" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="⚙ 料道控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AutoPrimary}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoPrimary}" Margin="2" />
                            </StackPanel>
                        </Grid>
                        <!-- 料道状态 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1#料道" FontSize="13" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="放料确认" FontSize="12" Foreground="{StaticResource AutoText}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="瑕疵检测" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="屏蔽" FontSize="12" Foreground="{StaticResource AutoYellow}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="瑕疵检测" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="门关闭" FontSize="12" Foreground="{StaticResource AutoRed}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="进料扫码" FontSize="13" Foreground="{StaticResource AutoText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="未完成" FontSize="12" Foreground="{StaticResource AutoText}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="放行确认" FontSize="12" Foreground="{StaticResource AutoGreen}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="拍照合格" FontSize="12" Foreground="{StaticResource AutoGreen}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource AutoPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource AutoDark}" CornerRadius="4" Padding="8,6"
                                            BorderBrush="{StaticResource AutoBorder}" BorderThickness="1">
                                        <TextBlock Text="拍照不合格" FontSize="12" Foreground="{StaticResource AutoRed}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部栏 -->
        <Border Grid.Row="2" Background="{StaticResource AutoDark}" BorderBrush="{StaticResource AutoBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
