<UserControl x:Class="Rxbit.Brigade.Controll.Views.Shop4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Shop4Primary" Color="#00B578" />
        <SolidColorBrush x:Key="Shop4Text" Color="#303133" />
        <SolidColorBrush x:Key="Shop4TextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="Shop4TextLight" Color="#909399" />
        <SolidColorBrush x:Key="Shop4Card" Color="#FFFFFF" />
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签页 -->
        <Border Grid.Row="0" Background="{StaticResource Shop4Card}" Padding="32,0">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="16,12" Cursor="Hand">
                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="{Binding IsActive, Converter={StaticResource BoolToFontWeightConverter}}"
                                       Foreground="{Binding IsActive, Converter={StaticResource ShopNullConverter2}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Banner -->
        <Border Grid.Row="1" Background="{StaticResource Shop4Card}" Margin="24,16" CornerRadius="12" Padding="24" Height="120">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FFE8E8" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                            <TextBlock Text="✂ 会员限时优惠" FontSize="11" Foreground="#F56C6C" />
                        </Border>
                        <Border Background="#FFF4E6" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="AI 写作 + 高效剪辑" FontSize="11" Foreground="#E6A23C" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding BannerTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Shop4Text}" />
                    <TextBlock Text="{Binding BannerSubtitle}" FontSize="13" Foreground="{StaticResource Shop4TextSecondary}" Margin="0,8,0,0" />
                    <Border Background="{StaticResource Shop4Primary}" CornerRadius="6" Padding="20,8" Margin="0,12,0,0" HorizontalAlignment="Left" Cursor="Hand">
                        <TextBlock Text="快装" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#FFF4E6" CornerRadius="8" Width="90" Height="80" Margin="4,0">
                        <TextBlock Text="🎙" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#E6F4EA" CornerRadius="8" Width="90" Height="80" Margin="4,0">
                        <TextBlock Text="✂" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#E6F0FF" CornerRadius="8" Width="90" Height="80" Margin="4,0">
                        <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 推荐应用网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="精选推荐" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Shop4Text}" />
                    <TextBlock Grid.Column="1" Text="更多" FontSize="13" Foreground="{StaticResource Shop4Primary}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendApps}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="6" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Shop4Card}" CornerRadius="10" Padding="14" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="10" Background="#F0F9F4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Shop4Text}" TextTrimming="CharacterEllipsis" Width="130" />
                                            <TextBlock Text="{Binding Downloads}" FontSize="11" Foreground="{StaticResource Shop4TextLight}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{StaticResource Shop4TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource Shop4Primary}" CornerRadius="4" Padding="16,5" Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand">
                                        <TextBlock Text="安装" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
