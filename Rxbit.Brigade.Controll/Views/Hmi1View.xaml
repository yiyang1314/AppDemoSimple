<UserControl x:Class="Rxbit.Brigade.Controll.Views.Hmi1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             Background="#0A1A30">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HmiBgBrush" Color="#0A1A30" />
        <SolidColorBrush x:Key="HmiPanelBg" Color="#0E2744" />
        <SolidColorBrush x:Key="HmiPanelBorder" Color="#1E6AB3" />
        <SolidColorBrush x:Key="HmiPrimary" Color="#1C9CFF" />
        <SolidColorBrush x:Key="HmiSecondary" Color="#00E5FF" />
        <SolidColorBrush x:Key="HmiText" Color="#C8E1FF" />
        <SolidColorBrush x:Key="HmiTextActive" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HmiTextDim" Color="#4A7FB5" />
    </UserControl.Resources>

    <Grid Background="{StaticResource HmiBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource HmiPanelBg}" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="24" Height="24" Fill="#1C9CFF" VerticalAlignment="Center" />
                    <TextBlock Text="地铁机房监测系统" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="首页" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="用户管理" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="线程布设" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="设备管理" FontSize="13" Foreground="{StaticResource HmiPrimary}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="抢修上报" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="消息报警" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                    <TextBlock Text="操作日志" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="24,0" Cursor="Hand" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="admin" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Ellipse Width="26" Height="26" Fill="{StaticResource HmiPrimary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航菜单 -->
            <Border Grid.Column="0" Margin="8" Background="{StaticResource HmiPanelBg}" CornerRadius="6" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1">
                <StackPanel Margin="12,16">
                    <ItemsControl ItemsSource="{Binding LeftMenu}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsActive, Converter={StaticResource NullConverter}}"
                                        CornerRadius="4" Padding="12,10" Margin="0,4">
                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                               Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 中间：通道选择 -->
            <Border Grid.Column="1" Margin="4" Background="{StaticResource HmiPanelBg}" CornerRadius="6" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,16">
                        <TextBlock Text="通道选择器" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource HmiTextActive}" Margin="0,0,0,12" />
                        <StackPanel>
                            <CheckBox Content="1号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                            <CheckBox Content="2号柱" Foreground="{StaticResource HmiText}" Margin="0,4" IsChecked="True" />
                            <Border Background="#1E6AB3" CornerRadius="3" Padding="12,6" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="温湿度传感器" FontSize="12" Foreground="{StaticResource HmiTextActive}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Rectangle Width="6" Height="6" Fill="#1C9CFF" RadiusX="3" RadiusY="3" VerticalAlignment="Center" />
                                        <TextBlock Text="  环境监测1" FontSize="11" Foreground="{StaticResource HmiPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Content="烟感传感器" Foreground="{StaticResource HmiText}" Margin="0,8,0,0" />
                                    <CheckBox Content="综合传感器" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Rectangle Width="6" Height="6" Fill="{StaticResource HmiTextDim}" RadiusX="3" RadiusY="3" VerticalAlignment="Center" />
                                        <TextBlock Text="  通道" FontSize="11" Foreground="{StaticResource HmiTextDim}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Content="3号柱" Foreground="{StaticResource HmiText}" Margin="0,8,0,4" />
                                    <CheckBox Content="4号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                    <CheckBox Content="5号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                    <CheckBox Content="6号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                    <CheckBox Content="7号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                    <CheckBox Content="8号柱" Foreground="{StaticResource HmiText}" Margin="0,4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：监测详情 -->
            <Border Grid.Column="2" Margin="4" Background="{StaticResource HmiPanelBg}" CornerRadius="6" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 按钮条 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="环境监测2" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" />
                            <Border BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="2" Padding="10,5" Margin="16,0,8,0">
                                <TextBlock Text="查看历史数据" FontSize="12" Foreground="{StaticResource HmiText}" />
                            </Border>
                            <Border BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="2" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock Text="查看环境记录" FontSize="12" Foreground="{StaticResource HmiText}" />
                            </Border>
                            <Border Background="{StaticResource HmiPrimary}" CornerRadius="2" Padding="16,5">
                                <TextBlock Text="查询" FontSize="12" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <!-- 设备信息 + 监测值 -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="设备ID" FontSize="13" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10,6" Background="#0A1E35">
                                        <TextBlock Text="{Binding DeviceId}" FontSize="12" Foreground="{StaticResource HmiSecondary}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🌡" FontSize="20" Foreground="#00E5FF" HorizontalAlignment="Center" />
                                        <Border Background="{StaticResource HmiPanelBg}" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,8,16,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CurrentTemp}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HmiSecondary}" />
                                                <TextBlock Text="当前温度" FontSize="11" Foreground="{StaticResource HmiTextDim}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="💧" FontSize="20" Foreground="#1C9CFF" HorizontalAlignment="Center" />
                                        <Border Background="{StaticResource HmiPanelBg}" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CurrentHumidity}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HmiPrimary}" />
                                                <TextBlock Text="当前湿度" FontSize="11" Foreground="{StaticResource HmiTextDim}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右侧：示意图 -->
                            <Border Grid.Column="1" Background="#0A1E35" CornerRadius="6" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <Canvas Height="180">
                                        <!-- 灯杆 -->
                                        <Rectangle Canvas.Left="130" Canvas.Top="10" Width="6" Height="150" Fill="#2A4565" RadiusX="2" RadiusY="2" />
                                        <!-- 左侧传感器 -->
                                        <Rectangle Canvas.Left="60" Canvas.Top="70" Width="40" Height="25" Fill="#2A4565" RadiusX="3" RadiusY="3" />
                                        <Ellipse Canvas.Left="50" Canvas.Top="60" Width="12" Height="12" Fill="#1C9CFF" />
                                        <!-- 右侧传感器 -->
                                        <Rectangle Canvas.Left="170" Canvas.Top="70" Width="40" Height="25" Fill="#2A4565" RadiusX="3" RadiusY="3" />
                                        <Ellipse Canvas.Left="210" Canvas.Top="60" Width="12" Height="12" Fill="#1C9CFF" />
                                        <!-- 顶部设备 -->
                                        <Rectangle Canvas.Left="110" Canvas.Top="0" Width="46" Height="16" Fill="#2A4565" RadiusX="3" RadiusY="3" />
                                        <!-- 监测面板 -->
                                        <Rectangle Canvas.Left="100" Canvas.Top="100" Width="66" Height="60" Fill="#0A1E35" Stroke="#1C9CFF" StrokeThickness="1" RadiusX="3" RadiusY="3" />
                                        <TextBlock Canvas.Left="108" Canvas.Top="108" Text="🌡" FontSize="14" Foreground="{StaticResource HmiSecondary}" />
                                        <TextBlock Canvas.Left="108" Canvas.Top="128" Text="💧" FontSize="14" Foreground="{StaticResource HmiPrimary}" />
                                    </Canvas>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 参数区域 -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="布点选址" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <Border Grid.Column="1" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10,6" Background="#0A1E35" Height="32">
                                <TextBlock Text="1号柱" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="布点选点" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <Border Grid.Column="3" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10,6" Background="#0A1E35" Height="32">
                                <TextBlock Text="四惠东" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="报警设置" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AlarmHigh}" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="报警设置" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AlarmLow}" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" Padding="10,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="报警温度" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TempUpper}" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="报警温度" FontSize="12" Foreground="{StaticResource HmiText}" VerticalAlignment="Center" Padding="10,8" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TempLower}" FontSize="11" Foreground="{StaticResource HmiTextActive}" VerticalAlignment="Center" Padding="10,8" />
                        </Grid>

                        <!-- 底部：设备信息 -->
                        <Border Grid.Row="3" Background="#0A1E35" BorderBrush="{StaticResource HmiPanelBorder}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel>
                                <TextBlock Text="设备信息" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HmiPrimary}" Margin="0,0,0,10" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource HmiTextDim}">
                                    温度范围：-40℃~70℃，其他温度范围可以定制。<LineBreak/>
                                    湿度范围：0~100%RH（非结露状态）<LineBreak/>
                                    供电电压：9~24VDC；输出信号为:0~2V，0~5V，RS485(RS)
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
