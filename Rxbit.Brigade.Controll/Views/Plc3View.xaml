<UserControl x:Class="Rxbit.Brigade.Controll.Views.Plc3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A1A30">
    <UserControl.Resources>
        <SolidColorBrush x:Key="P3Bg" Color="#0A1A30" />
        <SolidColorBrush x:Key="P3Panel" Color="#0E2744" />
        <SolidColorBrush x:Key="P3Border" Color="#1E6AB3" />
        <SolidColorBrush x:Key="P3Primary" Color="#1CA5FF" />
        <SolidColorBrush x:Key="P3Cyan" Color="#00E5FF" />
        <SolidColorBrush x:Key="P3Green" Color="#2ED573" />
        <SolidColorBrush x:Key="P3Red" Color="#E74C3C" />
        <SolidColorBrush x:Key="P3Yellow" Color="#F1C40F" />
        <SolidColorBrush x:Key="P3Text" Color="#BFD5F0" />
        <SolidColorBrush x:Key="P3AlertBg" Color="#5A1E1E" />
    </UserControl.Resources>

    <Grid Background="{StaticResource P3Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Background="{StaticResource P3Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="智能控制机监控系统" FontSize="20" FontWeight="Bold" Foreground="White" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding CurrentTime}" FontSize="14" Foreground="{StaticResource P3Cyan}" VerticalAlignment="Center" Margin="0,0,20,0" />
                <Border Background="#5A1E1E" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="退出" FontSize="13" Foreground="White" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 主体：5区域网格 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左上：PDU1 电流 -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#0E2744" BorderBrush="{StaticResource P3Cyan}" BorderThickness="2" Margin="0,0,0,6">
                        <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="22.0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="电流" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 右上：温度传感器 左上 -->
            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌡" FontSize="28" Foreground="{StaticResource P3Yellow}" HorizontalAlignment="Center" />
                    <TextBlock Text="22.8℃" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="57.7 %" FontSize="14" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" />
                    <TextBlock Text="左上门温度" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 中：前门 -->
            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="60" Height="40" Background="#5A1E1E" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚪" FontSize="18" Foreground="{StaticResource P3Red}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="前门" FontSize="14" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="非法打开" FontSize="12" Foreground="{StaticResource P3Red}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 中：后门 -->
            <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="60" Height="40" Background="#1E4263" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚪" FontSize="18" Foreground="{StaticResource P3Cyan}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="后门" FontSize="14" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="关闭" FontSize="12" Foreground="{StaticResource P3Green}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 右侧：温度传感器 右上 -->
            <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌡" FontSize="28" Foreground="{StaticResource P3Yellow}" HorizontalAlignment="Center" />
                    <TextBlock Text="22.8℃" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="57.7 %" FontSize="14" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" />
                    <TextBlock Text="右上门温度" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 左中：PDU1 电压 -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#0E2744" BorderBrush="{StaticResource P3Cyan}" BorderThickness="2" Margin="0,0,0,6">
                        <TextBlock Text="V" FontSize="22" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="220.0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="电压" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 中中：空调状态 -->
            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="50" Background="#1E4263" CornerRadius="4" Margin="0,0,0,8">
                        <TextBlock Text="❄" FontSize="26" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="空调" FontSize="14" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="正常" FontSize="16" FontWeight="Bold" Foreground="{StaticResource P3Green}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 右中：温度告警 -->
            <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Red}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌡" FontSize="28" Foreground="{StaticResource P3Red}" HorizontalAlignment="Center" />
                    <TextBlock Text="37.8℃" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="57.7 %" FontSize="14" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" />
                    <Border Background="{StaticResource P3AlertBg}" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                        <TextBlock Text="温度告警" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 左下：PDU1 功率 -->
            <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#0E2744" BorderBrush="{StaticResource P3Cyan}" BorderThickness="2" Margin="0,0,0,6">
                        <TextBlock Text="W" FontSize="22" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="200.0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="功率" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 下中左：温湿度 -->
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌡" FontSize="24" Foreground="{StaticResource P3Yellow}" HorizontalAlignment="Center" />
                    <TextBlock Text="22.8℃  57.7%" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="左中温湿度" FontSize="11" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 下中中：UPS -->
            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="UPS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="供电方式:" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="1" Text="外部" FontSize="10" Foreground="White" FontWeight="Bold" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="0" Text="输出电压:" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="220V" FontSize="10" Foreground="White" Margin="4,2,0,0" />
                        <TextBlock Grid.Column="0" Text="输出电流:" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="1" Text="20A" FontSize="10" Foreground="White" Margin="4,0,0,0" />
                    </Grid>
                    <TextBlock Text="运行状态:开启  运行模式:制冷" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 下中右：PDU2 功率 -->
            <Border Grid.Row="2" Grid.Column="3" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="输出功率:" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="200W" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="当前负载:" FontSize="10" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="46%" FontSize="16" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 右下：PDU2 电流 -->
            <Border Grid.Row="2" Grid.Column="4" Background="{StaticResource P3Panel}" CornerRadius="8" BorderBrush="{StaticResource P3Border}" BorderThickness="1" Margin="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#0E2744" BorderBrush="{StaticResource P3Cyan}" BorderThickness="2" Margin="0,0,0,6">
                        <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="{StaticResource P3Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="22.0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="电流" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部导航 -->
        <Border Grid.Row="2" Background="{StaticResource P3Panel}" BorderBrush="{StaticResource P3Border}" BorderThickness="0,1,0,0">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12,10" Margin="12,10,4,10" CornerRadius="6" Background="{StaticResource P3Primary}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="主页" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="12,10" Margin="4,10" CornerRadius="6" Background="Transparent" BorderBrush="Transparent">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="▦" FontSize="18" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="设备管控" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12,10" Margin="4,10" CornerRadius="6" Background="Transparent">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="▤" FontSize="18" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="资产管理" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="12,10" Margin="4,10" CornerRadius="6" Background="Transparent">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="◷" FontSize="18" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="历史信息" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="12,10" Margin="4,10,12,10" CornerRadius="6" Background="Transparent">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" />
                    <TextBlock Text="系统配置" FontSize="12" Foreground="{StaticResource P3Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
