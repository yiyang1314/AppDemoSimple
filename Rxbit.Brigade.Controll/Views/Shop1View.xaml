<UserControl x:Class="Rxbit.Brigade.Controll.Views.Shop1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Shop1Primary" Color="#00B578" />
        <SolidColorBrush x:Key="Shop1Text" Color="#303133" />
        <SolidColorBrush x:Key="Shop1TextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="Shop1TextLight" Color="#909399" />
        <SolidColorBrush x:Key="Shop1Border" Color="#E4E7ED" />
        <SolidColorBrush x:Key="Shop1Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Shop1Hover" Color="#F0F9F4" />
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab 切换: 软件 / 游戏 -->
        <Border Grid.Row="0" Background="{StaticResource Shop1Card}" Padding="32,0">
            <StackPanel Orientation="Horizontal" Height="48">
                <ItemsControl ItemsSource="{Binding TabFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsActive, Converter={StaticResource ShopNullConverter}}"
                                    Padding="20,12" Cursor="Hand">
                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="{Binding IsActive, Converter={StaticResource BoolToFontWeightConverter}}"
                                           Foreground="{Binding IsActive, Converter={StaticResource ShopNullConverter2}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 分类筛选 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="{StaticResource Shop1Card}" Padding="32,8">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding TagFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsActive, Converter={StaticResource ShopNullConverter}}"
                                    BorderBrush="{Binding IsActive, Converter={StaticResource ShopNullConverter3}}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12,5"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{Binding IsActive, Converter={StaticResource ShopNullConverter4}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 应用网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="8" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Shop1Card}" CornerRadius="10" Padding="16"
                                Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="14" Background="#F0F9F4" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Shop1Text}"
                                           TextTrimming="CharacterEllipsis" Width="100" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Downloads}" FontSize="11" Foreground="{StaticResource Shop1TextLight}"
                                           TextTrimming="CharacterEllipsis" Width="100" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
