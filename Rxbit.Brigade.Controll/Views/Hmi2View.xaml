<UserControl x:Class="Rxbit.Brigade.Controll.Views.Hmi2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E1A28">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BeautyBg" Color="#0E1A28" />
        <SolidColorBrush x:Key="BeautyCardBg" Color="#18263A" />
        <SolidColorBrush x:Key="BeautyPrimary" Color="#42B8FF" />
        <SolidColorBrush x:Key="BeautyActive" Color="#1C8CFF" />
        <SolidColorBrush x:Key="BeautyGreen" Color="#34C759" />
        <SolidColorBrush x:Key="BeautyGold" Color="#C9A46A" />
        <SolidColorBrush x:Key="BeautyText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BeautyTextDim" Color="#8AA0BD" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BeautyBg}">
        <!-- 装饰背景 -->
        <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource BeautyBg}" Stroke="#2A4065" StrokeThickness="1" />

        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题区 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="主视觉" FontSize="14" Foreground="{StaticResource BeautyTextDim}" />
                    <TextBlock Text="效果展示" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BeautyText}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource BeautyCardBg}" CornerRadius="12" Padding="16">
                    <TextBlock Text="美容导入仪" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BeautyText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="#666" Margin="2" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BeautyActive}" Margin="2" />
                        <Ellipse Width="8" Height="8" Fill="#555" Margin="2" />
                        <TextBlock Text="×" FontSize="14" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="#2024    BEAUTY INTRODUCER" FontSize="11"
                               Foreground="{StaticResource BeautyTextDim}" HorizontalAlignment="Right"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- 主体：左侧步骤 + 右侧控制 -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：模式选择 + 步骤 -->
                <StackPanel Grid.Column="0">
                    <!-- WiFi -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📶" FontSize="20" Foreground="{StaticResource BeautyGreen}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 步骤指示 -->
                    <Border Background="{StaticResource BeautyCardBg}" CornerRadius="12" Padding="16,20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 步骤1 -->
                            <Border Grid.Row="0" Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{StaticResource BeautyGold}">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#FFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="美肤" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BeautyGold}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />

                            <!-- 连接线 -->
                            <Rectangle Grid.Row="0" Grid.Column="0" Width="2" Height="20"
                                       Fill="#3A4B65" VerticalAlignment="Bottom" HorizontalAlignment="Center" />

                            <!-- 步骤2 -->
                            <Border Grid.Row="1" Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#2A4065" Margin="0,10,0,0">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BeautyTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="紧致" FontSize="14"
                                       Foreground="{StaticResource BeautyTextDim}" VerticalAlignment="Center"
                                       Margin="8,10,0,0" />
                        </Grid>
                    </Border>

                    <!-- 模式按钮 -->
                    <StackPanel>
                        <Border Background="{StaticResource BeautyActive}" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏹" FontSize="18" Foreground="White" VerticalAlignment="Center" Width="28" TextAlignment="Center" />
                                <TextBlock Text="自动模式" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BeautyCardBg}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👆" FontSize="18" Foreground="{StaticResource BeautyTextDim}" VerticalAlignment="Center" Width="28" TextAlignment="Center" />
                                <TextBlock Text="手动模式" FontSize="15" Foreground="{StaticResource BeautyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 启动按钮 -->
                    <Border Background="{StaticResource BeautyGreen}" CornerRadius="12" Padding="20,18" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="启动" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧：阶段控制区 -->
                <Border Grid.Column="1" Margin="20,0,0,0" Background="{StaticResource BeautyCardBg}" CornerRadius="16" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 顶部：UTMMAGIC 标识 + 设置 -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="UTMMAGIC" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource BeautyText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="Segoe UI" />
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#2A4065">
                                <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource BeautyTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Grid.Row="1" Height="1" Background="#2A4065" Margin="0,0,0,16" />

                        <!-- 阶段列表 -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource NullConverter3}}"
                                                CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                                                BorderBrush="{Binding IsActive, Converter={StaticResource NullConverter4}}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding StageName}" FontSize="15"
                                                           FontWeight="SemiBold" Foreground="{StaticResource BeautyText}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="护理时间:" FontSize="13"
                                                           Foreground="{StaticResource BeautyTextDim}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="18"
                                                           FontWeight="Bold" Foreground="{StaticResource BeautyPrimary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- 减号 -->
                                                <Border Grid.Column="3" Width="32" Height="32" CornerRadius="6" Background="#3A4B65" Margin="12,0,0,0">
                                                    <TextBlock Text="―" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BeautyTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="护理强度:" FontSize="13"
                                                           Foreground="{StaticResource BeautyTextDim}" VerticalAlignment="Center"
                                                           Margin="16,0,0,0" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{Binding Intensity}" FontSize="18"
                                                           FontWeight="Bold" Foreground="{StaticResource BeautyPrimary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- 加号 -->
                                                <Border Grid.Column="6" Width="32" Height="32" CornerRadius="6" Background="{StaticResource BeautyGreen}" Margin="12,0,0,0">
                                                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 底部：步骤指示条 -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BeautyGreen}" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="1" Background="{StaticResource BeautyGreen}" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="2" Background="{StaticResource BeautyGreen}" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="3" Background="{StaticResource BeautyGreen}" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="4" Background="{StaticResource BeautyGreen}" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="5" Background="#2A4065" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="6" Background="#2A4065" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="7" Background="#2A4065" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="8" Background="#2A4065" CornerRadius="6" Height="16" Margin="2,0" />
                            <Border Grid.Column="9" Background="#2A4065" CornerRadius="6" Height="16" Margin="2,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
