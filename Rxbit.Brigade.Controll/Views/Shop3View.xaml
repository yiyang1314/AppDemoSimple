<UserControl x:Class="Rxbit.Brigade.Controll.Views.Shop3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Shop3Primary" Color="#00B578" />
        <SolidColorBrush x:Key="Shop3Text" Color="#303133" />
        <SolidColorBrush x:Key="Shop3TextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="Shop3TextLight" Color="#909399" />
        <SolidColorBrush x:Key="Shop3Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Shop3Border" Color="#E4E7ED" />
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签页 -->
        <Border Grid.Row="0" Background="{StaticResource Shop3Card}" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Height="50">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="16,12" Cursor="Hand" BorderThickness="0,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="{Binding IsActive, Converter={StaticResource BoolToFontWeightConverter}}"
                                               Foreground="{Binding IsActive, Converter={StaticResource ShopNullConverter2}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalApps}" FontSize="13" Foreground="{StaticResource Shop3TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="#FFF4E6" CornerRadius="14" Padding="10,4" Cursor="Hand">
                        <TextBlock Text="深度清理" FontSize="12" Foreground="#E6A23C" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 应用列表 -->
        <Grid Grid.Row="1" Margin="32,16">
            <!-- 表头 -->
            <Border Background="{StaticResource Shop3Card}" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="应用名称" FontSize="12" Foreground="{StaticResource Shop3TextLight}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="应用版本" FontSize="12" Foreground="{StaticResource Shop3TextLight}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="安装日期" FontSize="12" Foreground="{StaticResource Shop3TextLight}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="安装大小" FontSize="12" Foreground="{StaticResource Shop3TextLight}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="操作" FontSize="12" Foreground="{StaticResource Shop3TextLight}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 应用项 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding InstalledApps}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,4" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Shop3Card}" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 应用名称 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="#F0F9F4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Shop3Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="140" />
                                    </StackPanel>
                                    <!-- 版本信息 -->
                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource Shop3TextSecondary}" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource Shop3TextLight}" />
                                    </StackPanel>
                                    <!-- 安装日期 -->
                                    <TextBlock Grid.Column="2" Text="{Binding InstallDate}" FontSize="12" Foreground="{StaticResource Shop3TextSecondary}" VerticalAlignment="Center" />
                                    <!-- 大小 -->
                                    <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12" Foreground="{StaticResource Shop3TextSecondary}" VerticalAlignment="Center" />
                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Background="#F5F7FA" CornerRadius="6" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                                            <TextBlock Text="卸载" FontSize="12" Foreground="{StaticResource Shop3TextSecondary}" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Background="{StaticResource Shop3Primary}" CornerRadius="6" Padding="14,6" Cursor="Hand">
                                            <TextBlock Text="打开" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
