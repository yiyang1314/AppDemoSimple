<UserControl x:Class="Rxbit.Brigade.Controll.Views.Dashboard3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1060"
             Background="#F5F7FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LightBgBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="LightCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LightTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="LightTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="LightTextPlaceholder" Color="#909399" />
    </UserControl.Resources>

    <Grid Background="{StaticResource LightBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Height="50" Background="{StaticResource LightCardBrush}">
            <Grid>
                <TextBlock Text="仪表板 / 数据分析" Foreground="{StaticResource LightTextPrimary}"
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- 面包屑 + Tab -->
        <Border Grid.Row="1" Height="40" Background="{StaticResource LightCardBrush}" Margin="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="仪表板" Foreground="{StaticResource LightTextPlaceholder}" FontSize="13" />
                <TextBlock Text=" / " Foreground="{StaticResource LightTextPlaceholder}" FontSize="13" />
                <TextBlock Text="数据分析" Foreground="{StaticResource LightTextPrimary}" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 统计卡片 - 4个 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardLightStyle}" Height="110" Margin="4">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="访问量" FontSize="12" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="49,917" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="日同比" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                                <TextBlock Text=" 65.83%" FontSize="11" Foreground="#52C41A" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="40" Height="40" Fill="#E6F7FF" />
                            <Polyline Points="0,20 10,15 20,25 30,10 40,20 50,5"
                                      Stroke="#1890FF" StrokeThickness="2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,-30,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="总访问量" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="74,742" FontSize="11" Foreground="{StaticResource LightTextPrimary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardLightStyle}" Height="110" Margin="4">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="销售额" FontSize="12" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="¥57,127" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="周同比" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                                <TextBlock Text=" 17.60%" FontSize="11" Foreground="#52C41A" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="40" Height="40" Fill="#F6FFED" />
                            <TextBlock Text="¥" FontSize="16" FontWeight="Bold"
                                       Foreground="#52C41A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-30,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="总销售额" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="¥39,024" FontSize="11" Foreground="{StaticResource LightTextPrimary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatCardLightStyle}" Height="110" Margin="4">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="订单量" FontSize="12" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="91,740" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="日同比" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                                <TextBlock Text=" 76.54%" FontSize="11" Foreground="#52C41A" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="40" Height="40" Fill="#FFFBE6" />
                            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-30,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="总订单量" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="42,285" FontSize="11" Foreground="{StaticResource LightTextPrimary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource StatCardLightStyle}" Height="110" Margin="4">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="成交额" FontSize="12" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="¥93,114" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="月同比" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                                <TextBlock Text=" 88.05%" FontSize="11" Foreground="#52C41A" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Width="40" Height="40" Fill="#FFF1F0" />
                            <TextBlock Text="¥" FontSize="16" FontWeight="Bold"
                                       Foreground="#FA541C" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-30,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="总成交额" FontSize="11" Foreground="{StaticResource LightTextSecondary}" />
                            <TextBlock Text="¥69,181" FontSize="11" Foreground="{StaticResource LightTextPrimary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 类别图标行 -->
                <Border Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource LightCardStyle}" Height="90" Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#E6F7FF" HorizontalAlignment="Center" />
                            <TextBlock Text="用户" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#F6FFED" HorizontalAlignment="Center" />
                            <TextBlock Text="分析" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#FFFBE6" HorizontalAlignment="Center" />
                            <TextBlock Text="商品" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#F9F0FF" HorizontalAlignment="Center" />
                            <TextBlock Text="订单" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#E6FFFB" HorizontalAlignment="Center" />
                            <TextBlock Text="贸易" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#E6F7FF" HorizontalAlignment="Center" />
                            <TextBlock Text="标签" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="40" Height="40" Fill="#FFF1F0" HorizontalAlignment="Center" />
                            <TextBlock Text="配置" FontSize="12" Foreground="{StaticResource LightTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 流量趋势面积图 -->
                <Border Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource LightCardStyle}" Height="280" Margin="4">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="流量趋势" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource LightTextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="#E6F7FF" CornerRadius="3" Padding="8,2">
                                    <TextBlock Text="访问量" FontSize="11" Foreground="#1890FF" />
                                </Border>
                                <Border Background="#F6FFED" CornerRadius="3" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock Text="浏览量" FontSize="11" Foreground="#52C41A" />
                                </Border>
                            </StackPanel>

                            <!-- 面积图 -->
                            <Grid Height="200" Margin="0,12,0,0">
                                <!-- 背景网格线 -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F7FA" Height="1" VerticalAlignment="Bottom" />
                                <Border Grid.Row="1" Background="#F5F7FA" Height="1" VerticalAlignment="Bottom" />
                                <Border Grid.Row="2" Background="#F5F7FA" Height="1" VerticalAlignment="Bottom" />
                                <Border Grid.Row="3" Background="#F5F7FA" Height="1" VerticalAlignment="Bottom" />

                                <!-- 面积填充 -->
                                <Canvas>
                                    <!-- 浅蓝色面积（访问量） -->
                                    <Polyline Points="0,180 60,160 120,120 180,80 240,40 300,30 360,50 420,90 480,130 540,150 600,165 660,175 720,180 720,200 0,200"
                                              Fill="#1890FF30" Stroke="Transparent" />
                                    <Polyline Points="0,180 60,160 120,120 180,80 240,40 300,30 360,50 420,90 480,130 540,150 600,165 660,175 720,180"
                                              Stroke="#1890FF" StrokeThickness="2" Fill="Transparent" />

                                    <!-- 浅绿色面积（浏览量） -->
                                    <Polyline Points="0,190 60,175 120,145 180,110 240,70 300,55 360,75 420,110 480,145 540,165 600,175 660,185 720,190 720,200 0,200"
                                              Fill="#52C41A30" Stroke="Transparent" />
                                    <Polyline Points="0,190 60,175 120,145 180,110 240,70 300,55 360,75 420,110 480,145 540,165 600,175 660,185 720,190"
                                              Stroke="#52C41A" StrokeThickness="2" Fill="Transparent" />
                                </Canvas>

                                <!-- X 轴标签 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom" Margin="0,0,0,-20">
                                    <TextBlock Text="6:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="7:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="8:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="9:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="10:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="11:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="12:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="13:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="14:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="15:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="16:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                    <TextBlock Text="17:00" FontSize="10" Foreground="{StaticResource LightTextPlaceholder}" Width="52" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

