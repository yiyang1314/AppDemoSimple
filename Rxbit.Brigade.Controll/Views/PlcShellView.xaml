<UserControl x:Class="Rxbit.Brigade.Controll.Views.PlcShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A1830">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PlcShellBg" Color="#0A1830" />
        <SolidColorBrush x:Key="PlcShellSidebar" Color="#0E2448" />
        <SolidColorBrush x:Key="PlcShellTop" Color="#0C1F40" />
        <SolidColorBrush x:Key="PlcShellPrimary" Color="#1CA5FF" />
        <SolidColorBrush x:Key="PlcShellText" Color="#B0C8F0" />
        <SolidColorBrush x:Key="PlcShellTextActive" Color="#FFFFFF" />
    </UserControl.Resources>

    <Grid Background="{StaticResource PlcShellBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource PlcShellTop}" BorderBrush="#1E3A60" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Rectangle Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="{StaticResource PlcShellPrimary}" />
                    <TextBlock Text="PLC 工业控制集" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="PLC Control Center" FontSize="12" Foreground="#6A8CAF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Grid.Column="2" Width="28" Height="28" Fill="#2A4565" Margin="0,0,16,0" />
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{StaticResource PlcShellSidebar}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlcMenuPanel" Margin="8,12,8,12" />
                </ScrollViewer>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1" x:Name="PlcContentArea" Background="#0A1628" />
        </Grid>
    </Grid>
</UserControl>
