<UserControl x:Class="Rxbit.Brigade.Controll.Views.Hmi5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ParamBg" Color="#141414" />
        <SolidColorBrush x:Key="ParamDark" Color="#1C1C1E" />
        <SolidColorBrush x:Key="ParamCard" Color="#2A2A2E" />
        <SolidColorBrush x:Key="ParamBlue" Color="#0A84FF" />
        <SolidColorBrush x:Key="ParamPrimary" Color="#2F80ED" />
        <SolidColorBrush x:Key="ParamText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ParamTextDim" Color="#8A8A8E" />
        <SolidColorBrush x:Key="ParamValue" Color="#4FD1C5" />
    </UserControl.Resources>

    <Grid Background="{StaticResource ParamBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧窄边栏 -->
        <Border Grid.Column="0" Background="#1A1A1C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部Logo -->
                <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="38" Height="38" Fill="{StaticResource ParamPrimary}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#2F80ED" BlurRadius="8" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="🅿" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- 菜单项 -->
                <ItemsControl Grid.Row="1" VerticalAlignment="Top" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,10" Cursor="Hand">
                                <!-- 高亮条 -->
                                <Border Width="3" Height="36" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-40,0,0,0"
                                        Visibility="{Binding IsActive, Converter={StaticResource NullConverter9}}" />
                                <Border Width="56" Height="44" CornerRadius="8"
                                        Background="{Binding IsActive, Converter={StaticResource NullConverter10}}"
                                        Padding="8,8" HorizontalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="▦" FontSize="16" Foreground="{Binding IsActive, Converter={StaticResource NullConverter11}}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{Binding IsActive, Converter={StaticResource NullConverter12}}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 右侧主区 -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Background="{StaticResource ParamDark}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource ParamCard}" Padding="8,0,8,0">
                        <TextBlock Text="🏠" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Grid>
                        <Ellipse Width="34" Height="34" Fill="{StaticResource ParamCard}" />
                        <TextBlock Text="👤" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="12,0,0,0">
                        <Ellipse Width="34" Height="34" Fill="{StaticResource ParamCard}" />
                        <TextBlock Text="☰" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 主内容 -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 左侧：参数设置卡片 -->
                <Grid Grid.Column="0" Grid.Row="0" Margin="24,20,12,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="参数设置" FontSize="14" Foreground="{StaticResource ParamTextDim}"
                               Margin="0,0,0,12" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 卡片：参数设置D0 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource ParamCard}" CornerRadius="12"
                                Margin="0,0,12,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参数设置D0" FontSize="14" Foreground="{StaticResource ParamText}" Margin="0,0,0,8" />
                                    <TextBlock Text="012.3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ParamBlue}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="Nm" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 卡片：参数设置D1 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource ParamCard}" CornerRadius="12"
                                Margin="12,0,0,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参数设置D1" FontSize="14" Foreground="{StaticResource ParamText}" Margin="0,0,0,8" />
                                    <TextBlock Text="012.3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ParamBlue}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="Nm" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 卡片：参数设置D2 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ParamCard}" CornerRadius="12"
                                Margin="0,12,12,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参数设置D2" FontSize="14" Foreground="{StaticResource ParamText}" Margin="0,0,0,8" />
                                    <TextBlock Text="012.3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ParamBlue}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="Nm" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 卡片：参数设置D3 -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ParamCard}" CornerRadius="12"
                                Margin="12,12,0,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参数设置D3" FontSize="14" Foreground="{StaticResource ParamText}" Margin="0,0,0,8" />
                                    <TextBlock Text="012.3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ParamBlue}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="Nm" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 卡片：参数设置D4 -->
                        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource ParamCard}" CornerRadius="12"
                                Margin="0,12,12,0" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="参数设置D4" FontSize="14" Foreground="{StaticResource ParamText}" Margin="0,0,0,8" />
                                    <TextBlock Text="012.3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ParamBlue}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource ParamPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="Nm" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 右侧：雷达图 -->
                <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource ParamDark}" CornerRadius="8"
                        Margin="12,20,24,20" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="雷达对比图" FontSize="14" Foreground="{StaticResource ParamTextDim}"
                                   Margin="0,0,0,8" />
                        <!-- 雷达图 -->
                        <Canvas Grid.Row="1" x:Name="RadarCanvas" SizeChanged="RadarCanvas_SizeChanged">
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
