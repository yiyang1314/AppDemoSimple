<UserControl x:Class="Rxbit.Brigade.Controll.Views.Plc4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#16181C">
    <UserControl.Resources>
        <SolidColorBrush x:Key="P4Bg" Color="#16181C" />
        <SolidColorBrush x:Key="P4Sidebar" Color="#1C1F24" />
        <SolidColorBrush x:Key="P4Panel" Color="#20242C" />
        <SolidColorBrush x:Key="P4Card" Color="#2A2F38" />
        <SolidColorBrush x:Key="P4Primary" Color="#F07D20" />
        <SolidColorBrush x:Key="P4PrimaryLight" Color="#FF9F43" />
        <SolidColorBrush x:Key="P4Green" Color="#2ED573" />
        <SolidColorBrush x:Key="P4Blue" Color="#3498DB" />
        <SolidColorBrush x:Key="P4Text" Color="#CCCCCC" />
        <SolidColorBrush x:Key="P4TextActive" Color="#FFFFFF" />
        <SolidColorBrush x:Key="P4TextDim" Color="#8A8A8E" />
    </UserControl.Resources>

    <Grid Background="{StaticResource P4Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource P4Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Grid Grid.Row="0" Background="{StaticResource P4Panel}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" Margin="0,0,0,8">
                            <Ellipse Width="40" Height="40" Fill="{StaticResource P4Primary}" />
                            <TextBlock Text="◎" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Segment" FontSize="14" FontWeight="Bold" Foreground="{StaticResource P4TextActive}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 菜单 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LeftNav}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsActive, Converter={StaticResource NullConverter}}"
                                        CornerRadius="4" Padding="12,10" Margin="8,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" Width="24" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右侧主内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Background="{StaticResource P4Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠  警报滚动栏警报滚动栏" FontSize="14" Foreground="{StaticResource P4Text}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding CurrentTime}" FontSize="12" Foreground="{StaticResource P4TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Ellipse Width="30" Height="30" Fill="{StaticResource P4Card}" />
                </StackPanel>
            </Grid>

            <!-- 主体：两列 -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- 左：配方编辑 -->
                <Border Grid.Column="0" Background="{StaticResource P4Panel}" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题 -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▦" FontSize="16" Foreground="{StaticResource P4Primary}" />
                            <TextBlock Grid.Column="1" Text="配方编辑" FontSize="16" FontWeight="Bold" Foreground="{StaticResource P4TextActive}" Margin="8,0,0,0" />
                        </Grid>

                        <!-- 表头 -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource P4Card}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="步骤" FontSize="12" Foreground="{StaticResource P4TextActive}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="阶段名称" FontSize="12" Foreground="{StaticResource P4TextActive}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="参数1  参数2" FontSize="12" Foreground="{StaticResource P4TextActive}" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 步骤列表 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 步骤编号圆形指示器 -->
                                                <Grid Grid.Column="0">
                                                    <Ellipse Width="28" Height="28" Fill="{StaticResource P4Primary}" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding StepNo}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <!-- 连接线 -->
                                                    <Rectangle Height="30" Width="2" Fill="#3A3F48" VerticalAlignment="Top" Margin="13,28,0,0" />
                                                </Grid>
                                                <Border Grid.Column="1" Background="{StaticResource P4Card}" CornerRadius="6" Padding="14,10" Margin="8,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource P4TextActive}" Margin="0,0,0,6" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{StaticResource P4Bg}" CornerRadius="4" Padding="8,4" Margin="0,4,4,0">
                                                                <TextBlock Text="{Binding Param1}" FontSize="11" Foreground="{StaticResource P4Text}" />
                                                            </Border>
                                                            <Border Grid.Column="1" Background="{StaticResource P4Bg}" CornerRadius="4" Padding="8,4" Margin="4,4,0,0">
                                                                <TextBlock Text="{Binding Param2}" FontSize="11" Foreground="{StaticResource P4Text}" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 底部操作按钮 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Border Background="{StaticResource P4Primary}" CornerRadius="6" Padding="16,8" Margin="4">
                                <TextBlock Text="复制" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="{StaticResource P4Primary}" CornerRadius="6" Padding="16,8" Margin="4">
                                <TextBlock Text="粘贴" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="{StaticResource P4Primary}" CornerRadius="6" Padding="16,8" Margin="4">
                                <TextBlock Text="清空" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="{StaticResource P4PrimaryLight}" CornerRadius="6" Padding="16,8" Margin="4">
                                <TextBlock Text="插入" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border Background="#444" CornerRadius="6" Padding="16,8" Margin="4">
                                <TextBlock Text="删除" FontSize="13" Foreground="{StaticResource P4Text}" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右：配方列表 -->
                <Border Grid.Column="1" Background="{StaticResource P4Panel}" CornerRadius="8" Padding="16" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配方列表" FontSize="16" FontWeight="Bold" Foreground="{StaticResource P4TextActive}" />
                        </Grid>

                        <!-- 列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Recipes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource P4Card}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource P4TextActive}" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{StaticResource P4TextDim}" Margin="0,0,0,8" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Background="{StaticResource P4Primary}" CornerRadius="4" Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="编辑" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <Border Background="#444" CornerRadius="4" Padding="10,4">
                                                        <TextBlock Text="删除" FontSize="11" Foreground="{StaticResource P4Text}" HorizontalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 搜索框 -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource P4Card}" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="配方名称" FontSize="12" Foreground="{StaticResource P4TextDim}" />
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource P4Primary}" CornerRadius="6" Margin="4,0,0,0">
                                <TextBlock Text="🔍" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource P4Card}" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="配方编号" FontSize="12" Foreground="{StaticResource P4TextDim}" />
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource P4Primary}" CornerRadius="6" Margin="4,0,0,0">
                                <TextBlock Text="🔍" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右下：操作按钮 -->
            <Grid VerticalAlignment="Bottom" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource P4Blue}" CornerRadius="6" Padding="16,10" Margin="0,4,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⬇" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="下载PLC" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource P4Primary}" CornerRadius="6" Padding="16,10" Margin="4,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="新添加配方" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
