<UserControl x:Class="Rxbit.Brigade.Controll.Views.Plc2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050F1D">
    <UserControl.Resources>
        <SolidColorBrush x:Key="P2Bg" Color="#050F1D" />
        <SolidColorBrush x:Key="P2Dark" Color="#0A1B2E" />
        <SolidColorBrush x:Key="P2Panel" Color="#0D2340" />
        <SolidColorBrush x:Key="P2Border" Color="#0B64AF" />
        <SolidColorBrush x:Key="P2Primary" Color="#1CA5FF" />
        <SolidColorBrush x:Key="P2Green" Color="#2ED573" />
        <SolidColorBrush x:Key="P2Red" Color="#E74C3C" />
        <SolidColorBrush x:Key="P2Yellow" Color="#F1C40F" />
        <SolidColorBrush x:Key="P2Text" Color="#BFD5F0" />
        <SolidColorBrush x:Key="P2TextDim" Color="#7A8FA8" />
    </UserControl.Resources>

    <Grid Background="{StaticResource P2Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource P2Dark}" BorderBrush="{StaticResource P2Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="24" Height="24" Fill="{StaticResource P2Primary}" RadiusX="4" RadiusY="4" />
                        <TextBlock Text="思刀" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="MOTEC" FontSize="10" Foreground="#666" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
                <Border Width="1" Background="{StaticResource P2Border}" Margin="16,8,16,8" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="{StaticResource P2Primary}" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource P2Panel}" CornerRadius="6" Padding="16,8"
                    Margin="40,0,40,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Line X1="0" Y1="10" X2="60" Y2="10" Stroke="{StaticResource P2Primary}" StrokeThickness="2" />
                    <TextBlock Text="自动化设备" FontSize="22" FontWeight="Bold" Foreground="White" Margin="12,0,12,0" />
                    <Line X1="0" Y1="10" X2="60" Y2="10" Stroke="{StaticResource P2Primary}" StrokeThickness="2" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <Border BorderBrush="{StaticResource P2Border}" BorderThickness="1" CornerRadius="4" Padding="16,6" Background="{StaticResource P2Panel}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource P2Primary}" />
                        <TextBlock Text="{Binding UserName}" FontSize="13" Foreground="{StaticResource P2Text}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid Width="28" Height="28" Margin="12,0,0,0">
                    <Ellipse Width="28" Height="28" Fill="{StaticResource P2Panel}" Stroke="{StaticResource P2Border}" StrokeThickness="1" />
                    <TextBlock Text="↻" FontSize="16" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧控制按钮 -->
            <StackPanel Grid.Column="0" Margin="12,12,0,12">
                <Border Background="{StaticResource P2Green}" CornerRadius="6" Padding="8,16" Margin="4,4">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#1AA654">
                            <TextBlock Text="▶" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="开始" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource P2Dark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                        BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                            <TextBlock Text="❚❚" FontSize="10" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="暂停" FontSize="13" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource P2Dark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                        BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                            <TextBlock Text="■" FontSize="14" Foreground="{StaticResource P2Red}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="停止" FontSize="13" Foreground="{StaticResource P2Red}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#5A1E1E" CornerRadius="6" Padding="8,16" Margin="4,8,4,4"
                        BorderBrush="#8B3A3A" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#8B3A3A">
                            <TextBlock Text="∅" FontSize="16" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="急停" FontSize="13" Foreground="{StaticResource P2Red}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource P2Dark}" CornerRadius="6" Padding="8,16" Margin="4,8,4,0"
                        BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A5A">
                            <TextBlock Text="⤓" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="复位" FontSize="13" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右侧：4个面板 -->
            <Grid Grid.Column="1" Margin="12,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 抓手控制 -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource P2Panel}" CornerRadius="8" BorderBrush="{StaticResource P2Border}" BorderThickness="1" Margin="0,0,6,6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙ 抓手控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource P2Primary}" Margin="0,0,0,12" />
                        <StackPanel>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="转角缸" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="22" Width="50" Background="#2A3A50" CornerRadius="11" HorizontalAlignment="Right">
                                    <Ellipse Width="18" Height="18" Fill="#5A7090" HorizontalAlignment="Left" Margin="2,2,0,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="防坠落" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="22" Width="50" Background="#2A3A50" CornerRadius="11" HorizontalAlignment="Right">
                                    <Ellipse Width="18" Height="18" Fill="#5A7090" HorizontalAlignment="Left" Margin="2,2,0,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="插销缸" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="松开" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="22" Width="50" Background="{StaticResource P2Primary}" CornerRadius="11" HorizontalAlignment="Right">
                                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="夹紧" FontSize="12" Foreground="{StaticResource P2Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 拆机盘控制 -->
                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource P2Panel}" CornerRadius="8" BorderBrush="{StaticResource P2Border}" BorderThickness="1" Margin="6,0,6,6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⚙ 拆机盘控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource P2Primary}" Margin="0,0,0,16" />
                        <StackPanel>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="上提" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource P2Primary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource P2Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="下提" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource P2Primary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource P2Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="托举" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource P2Primary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource P2Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="挡停" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="缩回" FontSize="12" Foreground="{StaticResource P2TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="26" Background="{StaticResource P2Primary}" CornerRadius="13" HorizontalAlignment="Right" Width="60">
                                    <Ellipse Width="22" Height="22" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="伸出" FontSize="12" Foreground="{StaticResource P2Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 料道控制 -->
                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource P2Panel}" CornerRadius="8" BorderBrush="{StaticResource P2Border}" BorderThickness="1" Margin="6,0,0,6" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="⚙ 料道控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource P2Primary}" Margin="0,0,0,12" />
                            <StackPanel>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1#料道" FontSize="13" Foreground="{StaticResource P2Primary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="放料确认" FontSize="12" Foreground="{StaticResource P2Text}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="瑕疵检测" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="屏蔽" FontSize="12" Foreground="{StaticResource P2Yellow}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="瑕疵检测" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="门关闭" FontSize="12" Foreground="{StaticResource P2Red}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="进料扫码" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="未完成" FontSize="12" Foreground="{StaticResource P2Text}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource P2Primary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="放行确认" FontSize="12" Foreground="{StaticResource P2Green}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource P2Primary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="拍照合格" FontSize="12" Foreground="{StaticResource P2Green}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2#料道" FontSize="13" Foreground="{StaticResource P2Primary}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource P2Dark}" CornerRadius="4" Padding="8,6" BorderBrush="{StaticResource P2Border}" BorderThickness="1">
                                        <TextBlock Text="拍照不合格" FontSize="12" Foreground="{StaticResource P2Red}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 手控NG料道 -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource P2Panel}" CornerRadius="8" BorderBrush="{StaticResource P2Border}" BorderThickness="1" Margin="0,6,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙ 手控NG料道" FontSize="15" FontWeight="Bold" Foreground="{StaticResource P2Primary}" Margin="0,0,0,16" />
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="呼叫AGV" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource P2Dark}" BorderBrush="{StaticResource P2Border}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0">
                                    <TextBlock Text="取盘" FontSize="13" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource P2Primary}" CornerRadius="4" Padding="8,6" Margin="4,0">
                                    <TextBlock Text="送盘" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="确认完毕" FontSize="13" Foreground="{StaticResource P2Text}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource P2Dark}" BorderBrush="{StaticResource P2Border}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0">
                                    <TextBlock Text="取盘" FontSize="13" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource P2Primary}" CornerRadius="4" Padding="8,6" Margin="4,0">
                                    <TextBlock Text="送盘" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部栏 -->
        <Border Grid.Row="2" Background="{StaticResource P2Dark}" BorderBrush="{StaticResource P2Border}" BorderThickness="0,1,0,0">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12,8" Margin="12,8" CornerRadius="4" Background="#1E3A5A">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="👆" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="手动操作" FontSize="11" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="12,8" Margin="4,8" CornerRadius="4" Background="{StaticResource P2Border}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="参数设置" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12,8" Margin="4,8" CornerRadius="4" Background="#1E3A5A">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="☑" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="任务确认" FontSize="11" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="12,8" Margin="4,8" CornerRadius="4" Background="#1E3A5A">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="▦" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="料道监控" FontSize="11" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="12,8" Margin="4,8" CornerRadius="4" Background="#1E3A5A">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💡" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="灯光控制" FontSize="11" Foreground="{StaticResource P2Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Padding="12,8" Margin="4,8,12,8" CornerRadius="4" Background="#1E3A5A">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource P2Primary}" HorizontalAlignment="Center" />
