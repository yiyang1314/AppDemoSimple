<UserControl x:Class="Rxbit.Brigade.Controll.Views.Dashboard1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rxbit.Brigade.Controll.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1060"
             Background="#1F2D3D">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#1F2D3D" />
        <SolidColorBrush x:Key="DarkCardBrush" Color="#263445" />
        <SolidColorBrush x:Key="DarkHoverBrush" Color="#2B3A4B" />
        <SolidColorBrush x:Key="DarkTextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkTextSecondary" Color="#A6A6A6" />
        <SolidColorBrush x:Key="TabActiveBrush" Color="#1890FF" />
    </UserControl.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Height="50" Background="{StaticResource DarkCardBrush}">
            <Grid>
                <TextBlock Text="图标库" Foreground="{StaticResource DarkTextPrimary}"
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />

                <!-- 搜索框 -->
                <Border HorizontalAlignment="Right" Margin="0,8,16,0"
                        Background="#1F2D3D" CornerRadius="4"
                        BorderBrush="#3A4A5C" BorderThickness="1"
                        Width="280" Height="34" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="🔍" Foreground="{StaticResource DarkTextSecondary}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource DarkTextPrimary}"
                                 CaretBrush="{StaticResource DarkTextPrimary}"
                                 BorderThickness="0"
                                 Padding="30,0,10,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Tab 栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{StaticResource DarkCardBrush}">
            <Border Background="{StaticResource TabActiveBrush}" Padding="20,10" Margin="1,0,0,0">
                <TextBlock Text="Icons" Foreground="White" FontSize="13" />
            </Border>
            <Border Background="{StaticResource DarkCardBrush}" Padding="20,10" Margin="1,0,0,0">
                <TextBlock Text="Elements" Foreground="{StaticResource DarkTextSecondary}" FontSize="13" />
            </Border>
            <Border Background="{StaticResource DarkCardBrush}" Padding="20,10" Margin="1,0,0,0">
                <TextBlock Text="UI Icons" Foreground="{StaticResource DarkTextSecondary}" FontSize="13" />
            </Border>
        </StackPanel>

        <!-- 图标网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="Element UI 图标"
                           Foreground="{StaticResource DarkTextPrimary}"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,16" />

                <!-- 图标网格区域 -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding FilteredIcons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource DarkCardBrush}"
                                    CornerRadius="4" Margin="6" Padding="10"
                                    Cursor="Hand"
                                    MouseEnter="Item_MouseEnter"
                                    MouseLeave="Item_MouseLeave">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="28"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               Foreground="{StaticResource DarkTextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

