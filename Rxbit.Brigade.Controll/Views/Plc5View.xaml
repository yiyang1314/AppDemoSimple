<UserControl x:Class="Rxbit.Brigade.Controll.Views.Plc5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A1838">
    <UserControl.Resources>
        <SolidColorBrush x:Key="P5Bg" Color="#0A1838" />
        <SolidColorBrush x:Key="P5Sidebar" Color="#0C1B40" />
        <SolidColorBrush x:Key="P5Panel" Color="#0F2050" />
        <SolidColorBrush x:Key="P5PanelDark" Color="#0A1838" />
        <SolidColorBrush x:Key="P5Border" Color="#1E3A75" />
        <SolidColorBrush x:Key="P5Primary" Color="#4F7CFF" />
        <SolidColorBrush x:Key="P5PrimaryLight" Color="#6B95FF" />
        <SolidColorBrush x:Key="P5Green" Color="#2ED573" />
        <SolidColorBrush x:Key="P5Red" Color="#E74C3C" />
        <SolidColorBrush x:Key="P5Yellow" Color="#F1C40F" />
        <SolidColorBrush x:Key="P5Text" Color="#B0C8F0" />
        <SolidColorBrush x:Key="P5TextActive" Color="#FFFFFF" />
    </UserControl.Resources>

    <Grid Background="{StaticResource P5Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource P5Sidebar}" BorderBrush="{StaticResource P5Border}" BorderThickness="0,0,0,1">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 用户信息 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource P5Primary}" Margin="0,0,10,0">
                    <TextBlock Text="👤" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperatorName}" FontSize="14" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding OperatorGroup}" FontSize="10" Foreground="{StaticResource P5Text}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 右侧时间 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding CurrentTime}" FontSize="14" Foreground="{StaticResource P5Primary}" VerticalAlignment="Center" />
            </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧菜单 -->
            <Border Grid.Column="0" Background="{StaticResource P5Sidebar}" />
            <Grid Grid.Column="0">
                <ItemsControl ItemsSource="{Binding LeftNav}" Margin="8,12,8,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsActive, Converter={StaticResource NullConverter}}"
                                    CornerRadius="6" Padding="12,10" Margin="4,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" Width="28" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{Binding IsActive, Converter={StaticResource NullConverter2}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 右侧主区 -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <!-- 顶部：产量/周期/状态 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 当前产量 -->
                    <Border Grid.Column="0" Background="{StaticResource P5Panel}" CornerRadius="8" BorderBrush="{StaticResource P5Border}" BorderThickness="1" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="当前产量" FontSize="12" Foreground="{StaticResource P5Text}" />
                            <TextBlock Text="{Binding CurrentOutput}" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <!-- 运行周期 -->
                    <Border Grid.Column="1" Background="{StaticResource P5Panel}" CornerRadius="8" BorderBrush="{StaticResource P5Border}" BorderThickness="1" Margin="4,0,4,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="运行周期" FontSize="12" Foreground="{StaticResource P5Text}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CurrentCycle}" FontSize="48" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="周期" FontSize="14" Foreground="{StaticResource P5Text}" VerticalAlignment="Bottom" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 当前状态 -->
                    <Border Grid.Column="2" Background="{StaticResource P5Panel}" CornerRadius="8" BorderBrush="{StaticResource P5Red}" BorderThickness="1" Margin="8,0,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="当前状态" FontSize="12" Foreground="{StaticResource P5Text}" />
                            <Border Background="#5A1E1E" CornerRadius="6" Padding="16,8" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentStatus}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 中部：报警列表 -->
                <Border Grid.Row="1" Background="{StaticResource P5Panel}" CornerRadius="8" BorderBrush="{StaticResource P5Border}" BorderThickness="1" Margin="0,16,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 表头 -->
                        <Border Grid.Row="0" Background="{StaticResource P5Primary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="报警时间" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="内容" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 报警列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Alarms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource P5PanelDark}" CornerRadius="4" Margin="0,3" Padding="12,8">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12" Foreground="{StaticResource P5Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 底部：状态开关 + 操作按钮 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <!-- 状态开关条 -->
                    <Border Background="{StaticResource P5Panel}" CornerRadius="6" Padding="16,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 静音 -->
                            <Grid Grid.Column="0">
                                <TextBlock Text="静音" FontSize="12" Foreground="{StaticResource P5Text}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Height="22" Width="60" Background="{StaticResource P5Primary}" CornerRadius="11" HorizontalAlignment="Center">
                                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                            </Grid>
                            <!-- 日光灯 -->
                            <Grid Grid.Column="1">
                                <TextBlock Text="日光灯" FontSize="12" Foreground="{StaticResource P5Text}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Height="22" Width="60" Background="{StaticResource P5Primary}" CornerRadius="11" HorizontalAlignment="Center">
                                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                            </Grid>
                            <!-- 自动/手动 -->
                            <Grid Grid.Column="2">
                                <TextBlock Text="自动  手动" FontSize="12" Foreground="{StaticResource P5Text}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Height="22" Width="60" Background="{StaticResource P5Primary}" CornerRadius="11" HorizontalAlignment="Center">
                                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="0,2,2,2" />
                                </Border>
                            </Grid>
                            <!-- 清料模式 -->
                            <Grid Grid.Column="3">
                                <Border Background="{StaticResource P5PrimaryLight}" CornerRadius="4" Padding="12,6" HorizontalAlignment="Center">
                                    <TextBlock Text="清料模式" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="{StaticResource P5Primary}" CornerRadius="6" Padding="20,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="启动" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource P5Red}" CornerRadius="6" Padding="20,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="停止" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource P5Border}" CornerRadius="6" Padding="20,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="复位" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource P5PrimaryLight}" CornerRadius="6" Padding="20,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="设备初始化" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
