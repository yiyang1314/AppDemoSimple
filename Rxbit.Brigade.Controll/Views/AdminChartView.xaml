<UserControl x:Class="Rxbit.Brigade.Controll.Views.AdminChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AdminCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AdminBorderBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="AdminTextPrimary" Color="#303133" />
        <SolidColorBrush x:Key="AdminTextSecondary" Color="#606266" />
        <SolidColorBrush x:Key="AdminWarningBrush" Color="#FCB341" />
        <SolidColorBrush x:Key="AdminInfoBrush" Color="#91CC75" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 面包屑 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🏠" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text=" 我的桌面" FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text=" / " FontSize="13" Foreground="{StaticResource AdminTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text="折线图" FontSize="13" Foreground="{StaticResource AdminTextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 图表主体 -->
        <Border Grid.Row="1" Background="{StaticResource AdminCardBrush}"
                BorderBrush="{StaticResource AdminBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 黄色提示条 -->
                <Border Grid.Row="0" Background="#FFF8EB" BorderBrush="{StaticResource AdminWarningBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8A6D3B">
                        <Run Text="特别声明：" FontWeight="Bold" />
                        <Run Text="ECharts，一个纯 Javascript 的图表库，可以流畅的运行在 PC 和移动设备上，兼容当前绝大部分浏览器（IE8/9/10/11，Chrome，Firefox，Safari 等），底层依赖轻量级的 Canvas 类库 ZRender，提供直观，生动，可交互，可高度个性化定制的数据可视化图表。如需使用，详细了解可以访问官网 " />
                        <Run Text="ECharts" Foreground="{StaticResource AdminInfoBrush}" TextDecorations="Underline" />
                        <Run Text="。x-admin 不承担任何版权问题。" />
                    </TextBlock>
                </Border>

                <!-- 图表区域 -->
                <Grid Grid.Row="1" x:Name="ChartArea" MinHeight="350">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 图例 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Ellipse Width="10" Height="10" Fill="#5B8FF9" VerticalAlignment="Center" />
                            <TextBlock Text="邮件营销" FontSize="11" Foreground="{StaticResource AdminTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Ellipse Width="10" Height="10" Fill="#5AD8A6" VerticalAlignment="Center" />
                            <TextBlock Text="联盟广告" FontSize="11" Foreground="{StaticResource AdminTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Ellipse Width="10" Height="10" Fill="#FFAB2B" VerticalAlignment="Center" />
                            <TextBlock Text="视频广告" FontSize="11" Foreground="{StaticResource AdminTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Ellipse Width="10" Height="10" Fill="#5D7092" VerticalAlignment="Center" />
                            <TextBlock Text="直接访问" FontSize="11" Foreground="{StaticResource AdminTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <Ellipse Width="10" Height="10" Fill="#F6BD16" VerticalAlignment="Center" />
                            <TextBlock Text="搜索引擎" FontSize="11" Foreground="{StaticResource AdminTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 折线图绘制区 -->
                    <Grid Grid.Row="1" x:Name="ChartGrid" SizeChanged="ChartGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Y 轴 -->
                        <StackPanel Grid.Column="0" x:Name="YAxisPanel" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,4,0" />

                        <!-- 绘图区 -->
                        <Canvas Grid.Column="1" x:Name="ChartCanvas" Background="#FAFAFA" />
                    </Grid>

                    <!-- X 轴 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="40,8,0,0" x:Name="XAxisPanel" />
                </Grid>

                <!-- 底部提示 -->
                <Border Grid.Row="2" Background="#FFF8EB" Padding="12,8" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8A6D3B">
                        <Run Text="注意：" FontWeight="Bold" />
                        <Run Text="本案例的ECharts图表库由cdn引入，需要在线才能正常使用，如需离线，请将 " />
                        <Run Text="ECharts" Foreground="{StaticResource AdminInfoBrush}" TextDecorations="Underline" />
                        <Run Text=" 官网下载。" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
