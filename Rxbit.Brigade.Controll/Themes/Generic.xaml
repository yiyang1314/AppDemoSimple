<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mvvm="clr-namespace:Rxbit.Brigade.Controll.Mvvm">

    <!-- 声明 Bool 转换器 -->
    <mvvm:NullConverter x:Key="NullConverter" />
    <mvvm:NullConverter2 x:Key="NullConverter2" />
    <mvvm:NullConverter3 x:Key="NullConverter3" />
    <mvvm:NullConverter4 x:Key="NullConverter4" />
    <mvvm:NullConverter5 x:Key="NullConverter5" />
    <mvvm:NullConverter6 x:Key="NullConverter6" />
    <mvvm:NullConverter7 x:Key="NullConverter7" />
    <mvvm:NullConverter8 x:Key="NullConverter8" />
    <mvvm:NullConverter9 x:Key="NullConverter9" />
    <mvvm:NullConverter10 x:Key="NullConverter10" />
    <mvvm:NullConverter11 x:Key="NullConverter11" />
    <mvvm:NullConverter12 x:Key="NullConverter12" />

    <!-- Bool → FontWeight -->
    <mvvm:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />

    <!-- Shop converters (green theme) -->
    <mvvm:ShopNullConverter x:Key="ShopNullConverter" />
    <mvvm:ShopNullConverter2 x:Key="ShopNullConverter2" />
    <mvvm:ShopNullConverter3 x:Key="ShopNullConverter3" />
    <mvvm:ShopNullConverter4 x:Key="ShopNullConverter4" />

    <!-- Bool 到 Brush 的转换器（用于 Admin/HMI 菜单激活态） -->
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#163764" />
    <SolidColorBrush x:Key="NavNormalBgBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NavActiveFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavNormalFgBrush" Color="#8AA0BD" />

    <SolidColorBrush x:Key="PanelActiveBgBrush" Color="#16365C" />
    <SolidColorBrush x:Key="PanelNormalBgBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PanelActiveBorderBrush" Color="#0B64AF" />
    <SolidColorBrush x:Key="PanelNormalBorderBrush" Color="Transparent" />

    <!-- Beauty 美容仪：阶段卡片 -->
    <SolidColorBrush x:Key="StageActiveBgBrush" Color="#122848" />
    <SolidColorBrush x:Key="StageNormalBgBrush" Color="Transparent" />
    <SolidColorBrush x:Key="StageActiveBorderBrush" Color="#1C8CFF" />
    <SolidColorBrush x:Key="StageNormalBorderBrush" Color="#2A4065" />

    <!-- Core 核应用：状态条 -->
    <SolidColorBrush x:Key="AppAlertBrush" Color="#B8282D" />
    <SolidColorBrush x:Key="AppRunBrush" Color="#1E4263" />
    <SolidColorBrush x:Key="CoreGreen" Color="#34C759" />

    <!-- Param 参数设置：菜单项高亮 -->
    <SolidColorBrush x:Key="ParamCardActiveBg" Color="#2F80ED" />
    <SolidColorBrush x:Key="ParamCardNormalBg" Color="Transparent" />
    <SolidColorBrush x:Key="ParamActiveText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ParamNormalText" Color="#8A8A8E" />

    <!-- ============ 通用颜色 ============ -->
    <Color x:Key="PrimaryColor">#1890FF</Color>
    <Color x:Key="PrimaryDarkColor">#096DD9</Color>
    <Color x:Key="SuccessColor">#52C41A</Color>
    <Color x:Key="WarningColor">#FAAD14</Color>
    <Color x:Key="ErrorColor">#FF4D4F</Color>
    <Color x:Key="InfoColor">#1890FF</Color>

    <!-- 亮色背景 -->
    <Color x:Key="LightBgColor">#F5F7FA</Color>
    <Color x:Key="LightCardColor">#FFFFFF</Color>
    <Color x:Key="LightBorderColor">#E4E7ED</Color>
    <Color x:Key="LightTextPrimaryColor">#303133</Color>
    <Color x:Key="LightTextRegularColor">#606266</Color>
    <Color x:Key="LightTextSecondaryColor">#909399</Color>
    <Color x:Key="LightTextPlaceholderColor">#C0C4CC</Color>

    <!-- 暗色背景 -->
    <Color x:Key="DarkBgColor">#141414</Color>
    <Color x:Key="DarkCardColor">#1D1E1F</Color>
    <Color x:Key="DarkBorderColor">#3A3A3A</Color>
    <Color x:Key="DarkTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="DarkTextSecondaryColor">#A6A6A6</Color>

    <!-- 图标库暗色主题颜色 -->
    <Color x:Key="IconBgColor">#304156</Color>
    <Color x:Key="IconCardColor">#263445</Color>
    <Color x:Key="IconHoverColor">#2B3A4B</Color>

    <!-- 电商主题颜色 -->
    <Color x:Key="EComBlueColor">#2F54EB</Color>
    <Color x:Key="EComCyanColor">#13C2C2</Color>
    <Color x:Key="EComPurpleColor">#722ED1</Color>
    <Color x:Key="EComOrangeColor">#FA8C16</Color>
    <Color x:Key="EComRedColor">#F5222D</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="LightBgBrush" Color="{StaticResource LightBgColor}" />
    <SolidColorBrush x:Key="LightCardBrush" Color="{StaticResource LightCardColor}" />
    <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource LightBorderColor}" />
    <SolidColorBrush x:Key="LightTextPrimaryBrush" Color="{StaticResource LightTextPrimaryColor}" />
    <SolidColorBrush x:Key="LightTextRegularBrush" Color="{StaticResource LightTextRegularColor}" />
    <SolidColorBrush x:Key="LightTextSecondaryBrush" Color="{StaticResource LightTextSecondaryColor}" />

    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}" />
    <SolidColorBrush x:Key="DarkCardBrush" Color="{StaticResource DarkCardColor}" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorderColor}" />
    <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource DarkTextPrimaryColor}" />
    <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondaryColor}" />

    <SolidColorBrush x:Key="IconBgBrush" Color="{StaticResource IconBgColor}" />
    <SolidColorBrush x:Key="IconCardBrush" Color="{StaticResource IconCardColor}" />
    <SolidColorBrush x:Key="IconHoverBrush" Color="{StaticResource IconHoverColor}" />

    <SolidColorBrush x:Key="EComBlueBrush" Color="{StaticResource EComBlueColor}" />
    <SolidColorBrush x:Key="EComCyanBrush" Color="{StaticResource EComCyanColor}" />
    <SolidColorBrush x:Key="EComPurpleBrush" Color="{StaticResource EComPurpleColor}" />
    <SolidColorBrush x:Key="EComOrangeBrush" Color="{StaticResource EComOrangeColor}" />
    <SolidColorBrush x:Key="EComRedBrush" Color="{StaticResource EComRedColor}" />

    <!-- ============ 通用样式 ============ -->
    <Style x:Key="LightCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LightCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <Style x:Key="DarkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <Style x:Key="IconCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource IconCardBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource IconHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 统计卡片样式 -->
    <Style x:Key="StatCardLightStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LightCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#00000020" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatCardDarkStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#00000040" BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧边栏按钮样式 -->
    <Style x:Key="SideNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#A6A6A6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2B3A4B" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SideNavButtonStyle}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="#1890FF"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
